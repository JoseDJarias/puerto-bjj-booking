<%# app/views/admin/class_schedules/attendance.html.erb %>

<div data-controller="modal" data-action="keyup@window->modal#handleKeyup" class="min-h-screen bg-slate-50/50">
  <%= turbo_stream_from "schedule_#{@class_schedule.id}" %>
  <div class="w-full max-w-6xl mx-auto px-2 py-8 pb-40">
    <header class="mb-10 flex items-center gap-8 px-2">
      <%= link_to admin_dashboard_path, class: "p-3 bg-white rounded-2xl text-slate-500 shadow-sm border border-slate-100 active:scale-90 transition-all" do %>
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-black text-slate-900 leading-[0.8] italic uppercase tracking-tighter">
          <%= @class_schedule.class_type.name %>
        </h1>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mt-2">
          <%= l(@class_schedule.starts_at, format: "%-I:%M %P") %> • <%= @bookings.size %> <%= t('admin.class_schedules.attendance.enrolled_label') %>
        </p>
      </div>
    </header>

    <div class="space-y-3" id="attendance_list_<%= @class_schedule.id %>">
      <% if @bookings.any? %>
        <% @bookings.each do |booking| %>
          <div id="<%= dom_id(booking) %>">             
            <div id="check_in_action_<%= booking.id %>" class="shrink-0">
              <%= render "admin/class_schedules/partials/booking_row", booking: booking %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="py-24 bg-white rounded-[3rem] border-2 border-dashed border-slate-100 flex flex-col items-center justify-center text-center px-6">
          <p class="text-sm font-black text-slate-300 uppercase tracking-widest italic leading-tight">
            <%= t('admin.class_schedules.attendance.no_students').html_safe %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="fixed bottom-10 left-0 right-0 px-6 z-50 flex justify-center">
    <button data-action="click->modal#open" 
            class="flex items-center gap-3 bg-slate-900 text-white px-10 py-5 rounded-[2.5rem] font-black text-[11px] uppercase tracking-widest shadow-2xl hover:bg-indigo-600 transition-all active:scale-95 shadow-indigo-200/50">
      <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      <%= t('admin.class_schedules.attendance.add_manual') %>
    </button>
  </div>

  <%= render "admin/class_schedules/partials/add_student_modal" %>

</div>