<%# app/views/admin/class_schedules/_form.html.erb %>
<%= form_with model: [:admin, class_schedule], class: "space-y-8" do |f| %>
  
  <% if class_schedule.errors.any? %>
    <div class="rounded-3xl bg-red-500/10 border border-red-500/20 p-6 mb-8 animate-in fade-in slide-in-from-top-4">
      <div class="flex gap-3">
        <svg class="h-5 w-5 text-red-500 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" /></svg>
        <ul class="text-xs font-bold text-red-500 uppercase tracking-widest space-y-1">
          <% class_schedule.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# 1. Discipline and Instructor %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <%# 1. DISCIPLINA %>
    <div class="space-y-2">
      <%= f.label :class_type_id, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
      <div class="relative group">
        <%= f.collection_select :class_type_id, @class_types, :id, :name, 
            { prompt: t('admin.class_schedules.form.select_discipline') }, 
            { class: "appearance-none block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 pl-5 pr-12 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all cursor-pointer" } %>
        
        <%# Flecha Custom: right-5 para que no esté pegada al borde %>
        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-slate-500 group-hover:text-indigo-400 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <%# 2. INSTRUCTOR %>
    <div class="space-y-2">
      <%= f.label :instructor_id, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
      <div class="relative group">
        <%= f.collection_select :instructor_id, @instructors, :id, :full_legal_name, 
            { prompt: t('admin.class_schedules.form.select_instructor') }, 
            { class: "appearance-none block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 pl-5 pr-12 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all cursor-pointer" } %>
        
        <%# Flecha Custom %>
        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-slate-500 group-hover:text-indigo-400 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>
  </div>
  
  <%# 2. Time and Duration %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-2">
      <%= f.label :starts_at, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
      <%= f.datetime_field :starts_at, 
          class: "block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all [color-scheme:dark]" %>
    </div>

    <div class="space-y-2">
      <%= f.label :duration_minutes, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
      <div class="relative group">
        <%= f.number_field :duration_minutes, 
            class: "block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" %>
        <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
          <span class="text-[10px] font-black text-slate-500 uppercase">min</span>
        </div>
      </div>
    </div>
  </div>

  <%# 3. Capacity and Status %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-2">
      <%= f.label :capacity, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
      <%= f.number_field :capacity, 
          class: "block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" %>
    </div>

    <div class="flex items-center pt-6">
      <label class="relative inline-flex items-center cursor-pointer group">
        <%= f.check_box :cancelled, class: "sr-only peer" %>
        <div class="w-11 h-6 bg-slate-800 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-500"></div>
        <span class="ml-3 text-[10px] font-black text-slate-400 group-hover:text-white uppercase tracking-widest transition-colors"><%= t('admin.class_schedules.form.cancelled_label') %></span>
      </label>
    </div>
  </div>

  <%# 4. Action Buttons %>
  <div class="flex items-center justify-end gap-4 pt-10 border-t border-slate-800/50 mt-10">
    <%= link_to t('admin.common.cancel'), 
              class_schedule.persisted? ? admin_class_schedule_path(class_schedule) : admin_class_schedules_path, 
              class: "px-8 py-4 text-[10px] font-black text-slate-500 hover:text-white uppercase tracking-widest transition-colors" %>
    <%= f.submit class_schedule.persisted? ? t('admin.common.update') : t('admin.common.create'), 
        class: "px-10 py-4 bg-indigo-600 hover:bg-indigo-500 text-white rounded-2xl font-black text-[10px] uppercase tracking-[0.2em] shadow-xl shadow-indigo-500/10 transition-all active:scale-95 cursor-pointer" %>
  </div>
<% end %>