<div class="max-w-5xl mx-auto p-6">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-black italic text-slate-900"><%= t('admin.membership_pricings.index.title') %></h1>
    <%= link_to t('admin.membership_pricings.index.new_price'), new_admin_membership_pricing_path,
        class: "bg-indigo-600 text-white px-4 py-2 rounded-xl font-bold text-sm" %>
  </div>

  <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full w-full text-left border-collapse divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="sticky left-0 z-10 bg-slate-50 p-4 text-xs font-black uppercase text-slate-400 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
              <%= t('admin.membership_pricings.index.package') %>
            </th>
            <th scope="col" class="p-4 text-xs font-black uppercase text-slate-400 whitespace-nowrap">
              <%= t('admin.membership_pricings.index.plan_duration') %>
            </th>
            <th scope="col" class="p-4 text-xs font-black uppercase text-slate-400 whitespace-nowrap">
              <%= t('admin.membership_pricings.index.price_configured') %>
            </th>
            <th scope="col" class="relative p-4 whitespace-nowrap">
              <span class="sr-only"><%= t('admin.membership_pricings.index.actions') %></span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @pricings.each do |pricing| %>
            <tr class="group hover:bg-slate-50 transition-colors">
              <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 p-4 font-bold text-slate-700 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
                <%= pricing.membership_package.name %>
              </td>
              <td class="p-4 text-slate-600 whitespace-nowrap"><%= pricing.membership_plan.name %></td>
              <td class="p-4 font-black text-indigo-600 whitespace-nowrap">₡<%= number_with_delimiter(pricing.price) %></td>
              <td class="p-4 text-right whitespace-nowrap">
                <%= link_to t('admin.membership_pricings.index.edit'), edit_admin_membership_pricing_path(pricing), class: "text-indigo-600 font-bold text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
