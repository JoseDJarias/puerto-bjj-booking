<%# app/views/admin/class_schedules/_form.html.erb %>
<%= form_with model: [:admin, class_schedule], class: "space-y-8" do |f| %>
  
  <% if class_schedule.errors.any? %>
    <div class="rounded-2xl bg-red-50 border border-red-100 p-4 mb-8">
      <ul class="text-[10px] font-black text-red-500 uppercase tracking-widest space-y-1">
        <% class_schedule.errors.full_messages.each do |msg| %>
          <li class="flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-red-500"></span>
            <%= msg %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 1. DISCIPLINA E INSTRUCTOR %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%# DISCIPLINA %>
    <div class="space-y-2">
      <%= f.label :class_type_id, t('admin.class_schedules.form.select_discipline'), class: "text-[10px] font-black text-slate-900 uppercase tracking-[0.2em] ml-1 flex items-center gap-2" %>
      <div class="relative group">
        <%= f.collection_select :class_type_id, @class_types,  :id, :name, 
            { prompt: "Seleccionar Disciplina" }, 
            { class: "appearance-none block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 pl-5 pr-12 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all cursor-pointer" } %>
        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-indigo-600">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>

    <%# INSTRUCTOR %>
    <div class="space-y-2">
      <%= f.label :instructor_id, t('admin.class_schedules.form.select_instructor'), class: "text-[10px] font-black text-slate-900 uppercase tracking-[0.2em] ml-1 flex items-center gap-2" %>
      <div class="relative group">
        <%= f.collection_select :instructor_id, @instructors, :id, :full_legal_name, 
            { prompt: "Seleccionar Instructor" }, 
            { class: "appearance-none block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 pl-5 pr-12 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all cursor-pointer" } %>
        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-indigo-600">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>

    <%# MODALIDAD %>
    <div class="space-y-2">
      <label class="text-[10px] font-black text-slate-900 uppercase tracking-[0.2em] ml-1 flex items-center gap-2">Modalidad</label>
      <div class="relative group">
        <%= f.select :modality, 
            ClassSchedule.modalities.keys.map { |m| [m.humanize.upcase, m] }, 
            { include_blank: "NINGUNA / N/A" }, 
            { class: "appearance-none block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 pl-5 pr-12 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all cursor-pointer" } %>
        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none text-indigo-600">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>
  </div>
  
  <%# 2. HORARIO Y DURACIÓN %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <%= f.label :starts_at, "Fecha y Hora de Inicio", class: "text-[10px] font-black text-slate-900 uppercase tracking-[0.2em] ml-1 flex items-center gap-2" %>
      <%= f.datetime_field :starts_at, 
          class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all" %>
    </div>

    <div class="space-y-2">
      <%= f.label :duration_minutes, class: "text-[10px] font-black text-slate-900 uppercase tracking-[0.2em] ml-1 flex items-center gap-2" %>
      <div class="relative">
        <%= f.number_field :duration_minutes, 
            class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all" %>
        <div class="absolute inset-y-0 right-5 flex items-center pointer-events-none">
          <span class="text-[9px] font-black text-slate-400 uppercase">minutos</span>
        </div>
      </div>
    </div>
  </div>

  <%# 3. CUPO Y CANCELACIÓN %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <%= f.label :capacity, class: "text-[10px] font-black text-slate-900 uppercase tracking-[0.2em] ml-1 flex items-center gap-2" %>
      <%= f.number_field :capacity, 
          class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all" %>
    </div>

    <div class="flex items-center pt-6">
      <label class="relative inline-flex items-center cursor-pointer group">
        <%= f.check_box :cancelled, class: "sr-only peer" %>
        <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-red-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
        <span class="ml-4 text-[10px] font-black text-slate-400 group-hover:text-slate-900 uppercase tracking-widest transition-colors">Marcar Sesión como CANCELADA</span>
      </label>
    </div>
  </div>

  <%# 4. BOTONES DE ACCIÓN %>
  <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-10 border-t-2 border-slate-50 mt-10">
    <%= link_to t('admin.common.cancel'), 
              admin_class_schedule_path(class_schedule), 
              class: "px-8 py-4 text-[10px] font-black text-slate-400 hover:text-red-500 uppercase tracking-widest transition-colors" %>
    
    <%= f.button type: "submit", 
        class: "w-full md:w-auto px-12 py-5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-black text-[10px] uppercase tracking-[0.2em] shadow-xl shadow-indigo-100 transition-all active:scale-95 cursor-pointer" do %>
      <%= class_schedule.persisted? ? "Guardar Cambios" : "Crear Sesión" %>
    <% end %>
  </div>
<% end %>