<%# app/views/admin/class_schedules/show.html.erb %>
<%= turbo_stream_from "schedule_#{@class_schedule.id}" %>
  <div class="p-6 lg:p-12 overflow-y-auto max-h-[90vh]">
    <header class="mb-6 lg:mb-10 px-2 pt-1"> 
      <div class="flex items-center justify-between mb-6">
        <div class="px-3 py-1 bg-slate-900 rounded-full flex items-center gap-2 border border-slate-800 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
          <span class="text-[9px] font-black text-white uppercase tracking-[0.2em]">Expediente de Sesión</span>
        </div>

        <%= link_to admin_dashboard_path, class: "p-2.5 bg-white rounded-xl text-slate-400 hover:text-indigo-600 shadow-sm border border-slate-100 transition-all active:scale-90" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /> <%# X de cerrar para "salir" %>
          </svg>
        <% end %>
      </div>

    <div class="flex items-center gap-2 mb-6">
        <%= link_to edit_admin_class_schedule_path(@class_schedule), 
                    class: "px-3 py-1 bg-amber-50 text-amber-600 rounded-full border border-amber-100 text-[9px] font-black uppercase tracking-widest hover:bg-amber-100 transition-colors" do %>
          <%= t('admin.class_schedules.show.edit_class') %>
        <% end %>
    </div>

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div class="max-w-2xl">
          <h1 class="text-5xl lg:text-7xl font-black text-slate-900 italic uppercase tracking-tighter leading-[0.8] mb-3">
            <%= @class_schedule.class_type.name %><br>
            <span class="text-indigo-600 text-4xl lg:text-5xl tracking-normal"><%= @class_schedule.starts_at.strftime("%I:%M %P") %></span>
          </h1>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[10px] lg:text-xs font-bold text-slate-400 uppercase tracking-widest">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              <%= t('admin.class_schedules.show.instructor') %>: <span class="text-slate-900"><%= @class_schedule.instructor.first_name %></span>
            </span>
            <span class="text-slate-200">|</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              <%= l(@class_schedule.starts_at, format: "%d %b %Y") %>
            </span>
          </div>
        </div>

        <%# 1. Stats:%>
        <div class="grid grid-cols-2 lg:flex gap-3 w-full lg:w-auto mt-4 lg:mt-0">
          <div class="bg-white p-4 lg:p-5 rounded-3xl border border-slate-100 shadow-sm text-center lg:min-w-[110px]">
            <span class="block text-[8px] font-black text-slate-400 uppercase mb-1 tracking-widest"><%= "Cupos" %></span>
            <span id="spots_counter" class="text-2xl lg:text-3xl font-black italic tracking-tighter <%= @class_schedule.full? ? 'text-red-500' : 'text-slate-900' %>">
              <%= @class_schedule.active_bookings_count %>/<%= @class_schedule.capacity %>
            </span>
          </div>
          <div class="bg-slate-900 p-4 lg:p-5 rounded-3xl shadow-xl shadow-indigo-100 text-center lg:min-w-[110px] border border-slate-800">
            <span class="block text-[8px] font-black text-indigo-400 uppercase mb-1 tracking-widest text-shadow-sm"><%= "Asistieron" %></span>
            <span id="attended_counter" class="text-2xl lg:text-3xl font-black italic tracking-tighter text-white">
            </span>
          </div>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 px-2">
      <%# 2. ROSTER %>
      <div class="lg:col-span-8 space-y-6">
        <div class="bg-white rounded-[2.5rem] lg:rounded-[3rem] border border-slate-100 shadow-sm overflow-hidden">
          <div class="px-6 lg:px-8 py-5 border-b border-slate-50 flex justify-between items-center bg-slate-50/30">
            <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest italic">Lista de Inscritos</h3>
            <span id="enrolled_badge" class="px-2.5 py-1 bg-indigo-50 text-indigo-600 text-[9px] font-black rounded-full uppercase">
              <%= @class_schedule.active_bookings_count %> <%= "Inscritos" %>
            </span>
          </div>
          <%= render "admin/class_schedules/partials/attendance_list", schedule: @class_schedule %>
        </div>
      </div>

      <%# 3. SIDEBAR %>
      <div class="lg:col-span-4 space-y-6" data-controller="search-list">
        <div class="bg-slate-900 p-6 lg:p-8 rounded-[2.5rem] lg:rounded-[3rem] text-white shadow-2xl border border-slate-800">
          <h3 class="text-lg lg:text-xl font-black italic uppercase tracking-tighter mb-6 leading-none">
            <%= "Inscribir Alumno" %><br><span class="text-indigo-400"><%= "Manualmente" %></span>
          </h3>
          
          <%# Search & Toggle %>
          <div class="space-y-3 mb-6">
            <div class="relative">
              <input type="text" data-action="input->search-list#filter" placeholder="Buscar atleta..." 
                    class="w-full bg-slate-800 border-none rounded-xl py-3 pl-10 pr-4 text-xs font-bold text-white focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-slate-600">
              <svg class="w-4 h-4 text-slate-600 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </div>

            <div class="flex items-center justify-between px-3 py-2.5 bg-slate-800/50 rounded-xl border border-slate-700/50">
              <span class="text-[8px] font-black text-slate-500 uppercase tracking-widest">Sin acceso?</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" data-action="change->search-list#toggleAll" class="sr-only peer">
                <div class="w-7 h-4 bg-slate-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-indigo-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"></div>
              </label>
            </div>
          </div>

          <%= form_with model: [:admin, Booking.new], url: admin_bookings_path do |f| %>
            <%= f.hidden_field :class_schedule_id, value: @class_schedule.id %>
            
            <div id="users_available_list" class="max-h-[250px] overflow-y-auto pr-1 mb-6 space-y-1.5 custom-scrollbar-dark">
              <% @users_available.each do |user| %>
                <%= render "admin/class_schedules/partials/user_sidebar_item", user: user %>
              <% end %>
            </div>

            <%= f.submit "Agregar" , class: "w-full bg-indigo-600 text-white py-3.5 rounded-xl font-black text-[10px] uppercase tracking-[0.2em] shadow-lg active:scale-95 transition-all cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </div>
  </div> 
  