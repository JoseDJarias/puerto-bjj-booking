<% content_for :page_title, t('contact.title') %>

<div class="min-h-[60vh] flex flex-col">
  <header class="mb-12 sm:mb-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4"><%= t('contact.title') %></h1>
    <p class="text-lg text-slate-600 max-w-2xl"><%= t('contact.subtitle') %></p>
  </header>

  <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 max-w-5xl">
    <%# Teléfono %>
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <div class="px-8 sm:px-10 pt-10 sm:pt-12 pb-6">
        <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-slate-100 text-slate-600 mb-6">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        </span>
        <h2 class="text-xl font-semibold text-slate-900 mb-3"><%= t('contact.phone_title') %></h2>
        <p class="text-slate-500 text-base">Aquí va el número de teléfono.</p>
      </div>
      <div class="flex-1 px-8 sm:px-10 pb-10 sm:pb-12 pt-2">
        <p class="text-2xl sm:text-3xl font-medium text-slate-900 tracking-tight">+00 000 000 0000</p>
      </div>
    </section>

    <%# Correo %>
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <div class="px-8 sm:px-10 pt-10 sm:pt-12 pb-6">
        <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-slate-100 text-slate-600 mb-6">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </span>
        <h2 class="text-xl font-semibold text-slate-900 mb-3"><%= t('contact.email_title') %></h2>
        <p class="text-slate-500 text-base">Aquí va el correo de contacto.</p>
      </div>
      <div class="flex-1 px-8 sm:px-10 pb-10 sm:pb-12 pt-2">
        <p class="text-xl sm:text-2xl font-medium text-indigo-600 break-all">contacto@ejemplo.com</p>
      </div>
    </section>
  </div>
</div>