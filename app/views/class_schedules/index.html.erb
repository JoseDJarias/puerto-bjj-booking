<%# app/views/class_schedules/index.html.erb %>

<div class="max-w-5xl mx-auto px-4 py-2">
  <%= turbo_stream_from current_user, "bookings" %>
  <header class="flex items-center justify-between mb-6 mt-4">
    <h1 class="text-xl font-black text-slate-900 tracking-tight">Agenda</h1>

    <div class="flex gap-4">
      <%= link_to "DÍA", class_schedules_path(date: @date, view_mode: "day"),
                  class: "text-[10px] font-black tracking-widest #{@view_mode == 'day' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-slate-400'}" %>
      <%= link_to "SEMANA", class_schedules_path(date: @date, view_mode: "week"),
                  class: "text-[10px] font-black tracking-widest #{@view_mode == 'week' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-slate-400'}" %>
    </div>
  </header>

  <%# -- Date Selector -- %>
  <div class="w-full max-w-4xl mx-auto mb-8">
    <div class="flex items-center justify-center border-b border-slate-50 pb-6 w-full">

      <div class="flex-none w-8 sm:w-10 flex justify-start">
        <%= link_to class_schedules_path(date: @date - 7.days, view_mode: @view_mode),
                    class: "text-slate-200 hover:text-indigo-600 p-1" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path d="M15 19l-7-7 7-7" /></svg>
        <% end %>
      </div>

      <div class="flex-1 flex items-center justify-between mx-auto max-w-xs sm:max-w-xl">
        <% @days_range.each do |day| %>
          <% is_selected = (day == @date) %>
          <% has_classes = @schedules_by_date[day].present? %>

          <%# flex-basis: 0 y flex-grow: 1 obligan a que todos midan lo mismo exactamente %>
          <%= link_to class_schedules_path(date: day, view_mode: @view_mode),
                      class: "flex flex-col items-center justify-center transition-all flex-1 min-w-0" do %>

            <%# Nombre del día: tracking-tighter para iPhone SE, normal para el resto %>
            <span class="text-[11px] sm:text-[10px] font-black uppercase mb-2 tracking-tighter sm:tracking-widest <%= is_selected ? 'text-indigo-600' : 'text-slate-300' %>">
              <%= t('date.abbr_day_names')[day.wday] %>
            </span>

            <div class="w-10 h-10 sm:w-10 sm:h-9 flex items-center justify-center rounded-full text-[11px] sm:text-sm font-black transition-all relative <%= is_selected ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-500 hover:bg-slate-100' %>">
              <%= day.day %>
              <% if has_classes && !is_selected %>
                <div class="absolute -bottom-1 w-1 h-1 bg-indigo-200 rounded-full"></div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="flex-none w-8 sm:w-10 flex justify-end">
        <%= link_to class_schedules_path(date: @date + 7.days, view_mode: @view_mode),
                    class: "text-slate-200 hover:text-indigo-600 p-1" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path d="M9 5l7 7-7 7" /></svg>
        <% end %>
      </div>
    </div>
  </div>

  <%= turbo_frame_tag "agenda_content" do %>
    <div class="animate-in fade-in duration-300">
      <% if @view_mode == "day" %>
        <div class="space-y-4">
          <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">
            <%= l(@date, format: "%A %d, %B") %>
          </p>

          <% if @class_schedules.any? %>
            <% @class_schedules.each do |schedule| %>
              <%= turbo_stream_from "schedule_#{schedule.id}" %>
              <%= render "class_schedules/partials/class_card_universal", schedule: schedule, user: Current.user, context: :agenda %>
            <% end %>
          <% else %>
            <div class="py-20 text-center border-2 border-dashed border-slate-100 rounded-[2rem] text-slate-300 text-xs font-bold uppercase tracking-widest">
              Sin clases hoy
            </div>
          <% end %>
        </div>
      <%   else %>
        <div class="space-y-8">
          <% @days_range.each do |day| %>
            <% day_classes = @schedules_by_date[day] || [] %>
            <% next if day_classes.empty? %> <%# Solo mostramos días con clases para ahorrar espacio %>

            <section>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest"><%= l(day, format: "%a %d") %></span>
                <div class="h-px flex-1 bg-slate-100"></div>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <% day_classes.each do |s| %>
                  <%= render "class_schedules/partials/class_card_universal", schedule: s, user: Current.user, context: :week %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>