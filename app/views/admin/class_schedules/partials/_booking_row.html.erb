<%# app/views/admin/class_schedules/partials/_booking_row.html.erb %>
<div id="<%= dom_id(booking) %>" 
     class="px-6 lg:px-8 py-4 flex items-center justify-between hover:bg-slate-50/50 transition-all border-l-4 
            <%= booking.blocked? ? 'border-red-500 bg-red-50/30' : (booking.attended? ? 'border-green-500 bg-green-50/10' : 'border-transparent bg-white') %>">
  
  <div class="flex items-center gap-4 min-w-0">   
    <div class="min-w-0">
      <div class="text-base lg:text-lg font-black text-slate-900 uppercase italic leading-none mb-1 truncate">
        <%= booking.user.nickname.presence || booking.user.first_name %>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[9px] font-black uppercase tracking-tighter <%= booking.user.has_booking_access? ? 'text-green-500' : 'text-red-500' %>">
          <%= booking.user.has_booking_access? ? '● ACTIVO' : '● SIN PAGO' %>
        </span>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2">
      <%# 1. BLOQUEAR / DESBLOQUEAR %>
    <%= button_to admin_booking_path(booking, action_type: "toggle_block"), 
                  method: :patch,
                  class: "p-2.5 rounded-xl transition-all #{booking.blocked? ? 'bg-red-600 text-white shadow-lg shadow-red-200' : 'text-slate-300 hover:text-amber-500 hover:bg-amber-50'}",
                  title: booking.blocked? ? "Desbloquear" : "Bloquear" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <% if booking.blocked? %>
          <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        <% else %>
          <path d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636" />
        <% end %>
      </svg>
    <% end %>

    <%# 2. CHECK-IN %>
    <%= button_to toggle_attendance_admin_booking_path(booking), 
                  method: :patch,
                  class: "p-2.5 rounded-xl transition-all #{booking.attended? ? 'bg-green-500 text-white shadow-lg shadow-green-200' : 'text-slate-300 hover:text-green-500 hover:bg-green-50'}" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path d="M5 13l4 4L19 7" /></svg>
    <% end %>

    <%# 3. Throw out of the class %>
    <%= button_to admin_booking_path(booking), method: :delete, data: { turbo_confirm: t('admin.class_schedules.attendance.throw_out_confirm') }, 
                  class: "p-2.5 text-slate-300 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
    <% end %>
  </div>
</div>