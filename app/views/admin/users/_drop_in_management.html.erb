<div id="drop_in_management_<%= user.id %>" class="mt-12 bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
  <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-4 bg-slate-50/30">
    <div>
      <h3 class="text-xl font-black italic text-slate-900 tracking-tight uppercase"><%= t('admin.users.drop_in_management.title') %></h3>
      <p class="text-xs text-slate-500 font-medium"><%= t('admin.users.drop_in_management.subtitle') %></p>
    </div>

    <%= form_with url: admin_user_drop_in_tickets_path(user), class: "flex items-center gap-2 bg-white p-1.5 rounded-2xl border border-slate-200 shadow-sm" do |f| %>
      <span class="text-[10px] font-black text-slate-400 px-2"><%= t('admin.users.drop_in_management.quantity_label') %></span>
      <%= f.number_field :quantity, value: 1, min: 1, max: 10,
          class: "w-14 border-none text-sm font-black focus:ring-0 p-0 text-center" %>
      <%= f.submit t('admin.users.drop_in_management.sell'),
          class: "bg-indigo-600 text-white px-4 py-2 rounded-xl font-black text-[10px] hover:bg-indigo-700 transition-all cursor-pointer" %>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50/50 text-[10px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">
          <th class="px-6 py-4"><%= t('admin.users.drop_in_management.id') %></th>
          <th class="px-6 py-4"><%= t('admin.users.drop_in_management.status') %></th>
          <th class="px-6 py-4"><%= t('admin.users.drop_in_management.purchase') %></th>
          <th class="px-6 py-4"><%= t('admin.users.drop_in_management.activation') %></th>
          <th class="px-6 py-4 text-right"><%= t('admin.users.drop_in_management.actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% user.drop_in_tickets.order(created_at: :desc).each do |ticket| %>
          <tr class="group hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <span class="text-xs font-mono text-slate-400">#<%= ticket.id %></span>
            </td>
            <td class="px-6 py-4">
              <% case ticket.status %>
              <% when 'unused' %>
                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-[10px] font-black uppercase bg-blue-50 text-blue-600 border border-blue-100">
                  <%= t('admin.users.drop_in_management.status_unused') %>
                </span>
              <% when 'used' %>
                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-[10px] font-black uppercase bg-green-50 text-green-600 border border-green-100">
                  <%= t('admin.users.drop_in_management.status_used') %>
                </span>
              <% when 'voided' %>
                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-[10px] font-black uppercase bg-red-50 text-red-600 border border-red-100">
                  <%= t('admin.users.drop_in_management.status_voided') %>
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4">
              <span class="text-xs font-bold text-slate-700"><%= ticket.created_at.strftime("%d/%m/%y") %></span>
              <p class="text-[10px] text-slate-400"><%= number_to_currency(ticket.price_paid || 0, precision: 0) %></p>
            </td>
            <td class="px-6 py-4">
              <% if ticket.used? %>
                <span class="text-xs font-black text-indigo-600"><%= ticket.used_at.strftime("%I:%M%p") %></span>
              <% elsif ticket.voided? %>
                <span class="text-xs text-red-300 italic"><%= t('admin.users.drop_in_management.access_revoked') %></span>
              <% else %>
                <span class="text-xs text-slate-300 italic"><%= t('admin.users.drop_in_management.unused') %></span>
              <% end %>
            </td>
            <td class="px-6 py-4">
              <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                <% unless ticket.unused? %>
                  <%= button_to reset_usage_admin_user_drop_in_ticket_path(user, ticket),
                      method: :patch,
                      title: t('admin.users.drop_in_management.reset_title'),
                      class: "p-2 rounded-lg bg-slate-100 text-slate-600 hover:bg-indigo-100 hover:text-indigo-600 transition-all" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  <% end %>
                <% end %>

                <% unless ticket.voided? %>
                  <%= button_to void_admin_user_drop_in_ticket_path(user, ticket),
                      method: :patch,
                      title: t('admin.users.drop_in_management.void_title'),
                      class: "p-2 rounded-lg bg-slate-100 text-slate-400 hover:bg-red-50 hover:text-red-600 transition-all" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                  <% end %>
                <% end %>

                <%= button_to admin_user_drop_in_ticket_path(user, ticket),
                    method: :delete,
                    title: t('admin.users.drop_in_management.destroy_title'),
                    form: { data: { turbo_confirm: t('admin.users.drop_in_management.destroy_confirm') } },
                    class: "p-2 rounded-lg bg-slate-100 text-slate-400 hover:bg-red-600 hover:text-white transition-all" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if user.drop_in_tickets.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-slate-400 text-xs italic bg-slate-50/20">
              <%= t('admin.users.drop_in_management.empty') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
