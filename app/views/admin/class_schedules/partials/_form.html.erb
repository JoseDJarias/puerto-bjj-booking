<%# app/views/admin/class_schedules/partials/_form.html.erb %>
<%= form_with model: [:admin, class_schedule], class: "space-y-10" do |f| %>
  
  <% if class_schedule.errors.any? %>
    <div class="rounded-3xl bg-red-50 border-2 border-red-100 p-6 mb-8 animate-in fade-in slide-in-from-top-4">
      <h4 class="text-[11px] font-black text-red-600 uppercase tracking-[0.2em] mb-3 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        Revisa los siguientes errores
      </h4>
      <ul class="text-[10px] font-black text-red-500/80 uppercase tracking-widest space-y-1 ml-6">
        <% class_schedule.errors.full_messages.each do |msg| %>
          <li class="list-disc"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 1. Discipline Selector %>
  <div class="space-y-4">
    <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
      <%= t('admin.class_schedules.form.select_discipline') %>
    </label>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <% @class_types.each do |type| %>
        <label class="group relative cursor-pointer">
          <%= f.radio_button :class_type_id, type.id, class: "sr-only peer", required: true %>
          <div class="p-5 rounded-2xl bg-slate-50 border-2 border-transparent transition-all peer-checked:bg-indigo-600 peer-checked:border-indigo-400 peer-checked:shadow-lg peer-checked:shadow-indigo-100 group-hover:bg-slate-100 flex flex-col items-center gap-2 text-center h-full justify-center">
            <span class="text-[11px] font-black text-slate-900 peer-checked:text-white uppercase leading-tight transition-colors">
              <%= type.name %>
            </span>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <%# 2. Modality Selector(Gi or No-gi, only for bjj) %>
  <div class="py-4 border-b border-slate-50">
    <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2 mb-4">
      <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
      Modalidad de Jiu Jitsu (Gi o No-Gi)
    </label>

    <div class="relative max-w-xs" data-controller="dropdown" data-action="click@window->dropdown#hide">
      <%= f.hidden_field :modality, 
                         data: { dropdown_target: "input" }, 
                         id: "selected_modality" %>
      <button type="button" 
              data-action="dropdown#toggle" 
              class="flex items-center justify-between w-full bg-white border-2 border-slate-100 rounded-2xl py-4 px-6 text-[12px] font-black text-slate-700 uppercase tracking-widest hover:border-indigo-500 transition-all shadow-sm">
        <span data-dropdown-target="label">
          <% if f.object.modality.present? %>
            <%= f.object.modality == 'no_modality' ? 'N/A' : f.object.modality.upcase %>
          <% else %>
            Seleccionar Modalidad
          <% end %>
        </span>
        <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <%# Dropdown Modality Menu %>
      <div data-dropdown-target="menu" 
        class="hidden absolute z-30 w-full mt-2 bg-white border-2 border-slate-100 rounded-2xl shadow-xl overflow-hidden animate-in fade-in slide-in-from-top-2 duration-200">
      
        <% ClassSchedule.modalities.each do |name, value| %>
          <button type="button" 
                  data-action="click->dropdown#select"
                  data-value="<%= name %>"
                  data-label="<%= name == 'no_modality' ? 'N/A' : name.upcase %>"
                  class="w-full text-left px-6 py-4 text-[11px] font-black text-slate-600 uppercase tracking-widest hover:bg-indigo-50 hover:text-indigo-700 transition-colors border-b border-slate-50 last:border-0">
            <%= name == 'no_modality' ? 'N/A' : name.upcase %>
          </button>
        <% end %>
      </div>

    </div>
  </div>
  <%# 3. Instructor Selector %>
  <div class="space-y-4 pt-4 border-t border-slate-50">
    <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      Instructor Responsable
    </label>
    <div class="flex flex-wrap gap-4">
      <% @instructors.each do |instructor| %>
        <label class="group relative cursor-pointer">
          <%= f.radio_button :instructor_id, instructor.id, class: "sr-only peer", required: true %>
          <div class="flex items-center gap-3 px-5 py-3 rounded-2xl bg-white border-2 border-slate-100 transition-all peer-checked:border-indigo-600 peer-checked:bg-indigo-50 group-hover:bg-slate-50 shadow-sm active:scale-95">
            <div class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center text-[10px] font-black text-white uppercase peer-checked:bg-indigo-600 transition-colors">
              <%= instructor.first_name[0] %><%= instructor.last_name.to_s[0] %>
            </div>
            <span class="text-[11px] font-black text-slate-700 peer-checked:text-indigo-700 uppercase italic">
              <%= instructor.first_name %>
            </span>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <%# 3b. Special Guest (Optional Display Override) %>
  <div class="space-y-3 pt-4 border-t border-slate-50">
    <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-amber-500"></span>
      Invitado Especial <span class="text-slate-400 normal-case tracking-normal font-bold">(Opcional)</span>
    </label>
    <%= f.text_field :guest_instructor_name,
                     placeholder: "Ej: Master Carlos Gracie",
                     class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-amber-500 transition-all shadow-sm" %>
    <p class="text-[10px] font-bold text-slate-400 italic ml-1">
      Si se llena, este nombre se mostrará a los alumnos en lugar del instructor responsable.
    </p>
  </div>

  <%# 4. Details for the class(duration, hour...)%>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t border-slate-100">
    <div class="space-y-3">
      <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Fecha y Hora
      </label>
      <%= f.datetime_field :starts_at, 
          class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm" %>
    </div>

    <div class="space-y-3">
      <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        Duración
      </label>
      <div class="relative">
        <%= f.number_field :duration_minutes, 
            class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm" %>
        <span class="absolute right-5 top-1/2 -translate-y-1/2 text-[9px] font-black text-slate-400">MIN</span>
      </div>
    </div>

    <div class="space-y-3">
      <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" /></svg>
        Capacidad
      </label>
      <%= f.number_field :capacity, 
          class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm" %>
    </div>
  </div>

  <%# 4.5 Topic and Notes %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 border-t border-slate-100">
    <div class="space-y-3">
      <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        Enfoque de la Clase <span class="text-slate-400 normal-case tracking-normal font-bold">(Opcional)</span>
      </label>
      <%= f.text_field :topic, 
          placeholder: "Ej: Escape de 100 kilos",
          class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-black text-slate-700 focus:bg-white focus:border-amber-500 transition-all shadow-sm" %>
      <p class="text-[10px] font-bold text-slate-400 italic ml-1">Un título corto que verán los alumnos.</p>
    </div>

    <div class="space-y-3">
      <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
        Notas Especiales <span class="text-slate-400 normal-case tracking-normal font-bold">(Opcional)</span>
      </label>
      <%= f.text_area :notes, 
          rows: 3,
          placeholder: "Ej: Traer gi blanco, llegar 10 mins antes.",
          class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3.5 px-5 text-xs font-medium text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm" %>
      <p class="text-[10px] font-bold text-slate-400 italic ml-1">Instrucciones largas para la clase.</p>
    </div>
  </div>


  <%# 5. Cancel Class(currently it does anything) %>
  <%is_canceled = class_schedule.cancelled? ? "Descancelar la Sesión" : "Cancelar Sesión" %>

  <% if class_schedule.persisted? %>
    <div class="bg-red-50/50 border-2 border-dashed border-red-100 p-6 rounded-[2rem] flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div>
          <p class="text-xs font-black text-red-600 uppercase tracking-widest leading-none"><%= is_canceled %></p>
        </div>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <%= f.check_box :cancelled, class: "sr-only peer" %>
        <div class="w-14 h-7 bg-slate-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-red-500 after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:rounded-full after:h-[1.3rem] after:w-[1.3rem] after:transition-all shadow-inner"></div>
      </label>
    </div>
  <% end %>

  <%# 6. Action Buttons %>
  <div class="flex flex-col items-center justify-center gap-4 pt-8 border-t border-slate-100 mt-8">
    
    <%= f.button type: "submit", 
        class: "w-full md:w-auto min-w-[240px] px-10 py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-black text-[11px] uppercase tracking-[0.2em] shadow-xl shadow-indigo-100 transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-3 order-1" do %>
      <span><%= class_schedule.persisted? ? "Guardar Cambios" : "Crear Clase" %></span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
    <% end %>

    <% cancel_path = class_schedule.persisted? ? admin_class_schedule_path(class_schedule) : admin_class_schedules_path %>
    <%= link_to cancel_path, 
        class: "px-8 py-3 text-[10px] font-black text-slate-400 hover:text-slate-600 hover:bg-slate-50 rounded-xl uppercase tracking-widest transition-all order-2" do %>
      <%= t('admin.common.cancel') %>
    <% end %>

  </div>
<% end %>