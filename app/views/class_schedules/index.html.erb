<%# app/views/class_schedules/index.html.erb %>

<div class="max-w-7xl mx-auto px-4 py-6">
  <%# Private channel for updates of the user's booking button (Book/Cancel) %>
  <%= turbo_stream_from current_user, "bookings" %>

  <div class="flex items-center justify-between mb-8 bg-white p-3 rounded-2xl shadow-sm border border-slate-100 sticky top-2 z-10 backdrop-blur-md bg-white/90">
    <%= link_to class_schedules_path(date: @date - 1.day), class: "p-2 hover:bg-slate-50 rounded-xl text-slate-400 hover:text-indigo-600 transition-colors" do %>
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    <% end %>

    <div class="text-center">
      <span class="block text-[10px] text-slate-400 font-black uppercase tracking-widest">
        <%= @date.today? ? "HOY" : l(@date, format: "%A") %>
      </span>
      <span class="block text-xl font-black text-slate-800">
        <%= @date.strftime("%d %b") %> 
      </span>
    </div>

    <%= link_to class_schedules_path(date: @date + 1.day), class: "p-2 hover:bg-slate-50 rounded-xl text-slate-400 hover:text-indigo-600 transition-colors" do %>
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    <% end %>
  </div>

<% if @class_schedules.any? %>
   <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @class_schedules.each do |schedule| %>
      <%= turbo_stream_from "schedule_#{schedule.id}" %>
        <%= render "class_schedules/partials/class_card_universal", 
                   schedule: schedule, 
                   user: current_user, 
                   context: :schedule %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm mt-4">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 mb-4">
        <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
      <h3 class="text-lg font-medium text-slate-900"><%= t('class_schedules.index.free_day') %></h3>
      <p class="text-slate-500"><%= t('class_schedules.index.free_day_description') %></p>
    </div>
  <% end %>
</div>