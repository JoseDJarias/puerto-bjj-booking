<%= form_with model: [:admin, pricing], class: "space-y-6" do |f| %>
  
  <% if pricing.errors.any? %>
    <div class="bg-red-50 text-red-700 p-4 rounded-xl text-sm font-bold mb-6">
      <ul>
        <% pricing.errors.full_messages.each do |msg| %>
          <li>• <%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :membership_package_id, t('admin.membership_pricings.form.package'), class: "block text-xs font-black uppercase text-slate-500 mb-2" %>
      <%= f.collection_select :membership_package_id, MembershipPackage.active, :id, :name,
          { prompt: t('admin.membership_pricings.form.package_prompt') },
          { class: "block w-full rounded-xl border-slate-300 py-3 focus:ring-indigo-600 disabled:bg-slate-50 disabled:text-slate-400",
            disabled: pricing.persisted? } %>
    </div>

    <div>
      <%= f.label :membership_plan_id, t('admin.membership_pricings.form.plan'), class: "block text-xs font-black uppercase text-slate-500 mb-2" %>
      <%= f.collection_select :membership_plan_id, MembershipPlan.active, :id, :name,
          { prompt: t('admin.membership_pricings.form.plan_prompt') },
          { class: "block w-full rounded-xl border-slate-300 py-3 focus:ring-indigo-600 disabled:bg-slate-50 disabled:text-slate-400",
            disabled: pricing.persisted? } %>
    </div>
  </div>

  <div class="bg-indigo-50 p-6 rounded-2xl border border-indigo-100">
    <%= f.label :price, t('admin.membership_pricings.form.price_label'), class: "block text-xs font-black uppercase text-indigo-600 mb-2" %>
    <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 font-black text-indigo-400 text-xl">₡</span>
      <%= f.number_field :price,
          class: "block w-full rounded-xl border-indigo-200 py-4 pl-10 focus:ring-indigo-600 font-black text-2xl text-indigo-900 shadow-inner",
          placeholder: t('admin.membership_pricings.form.price_placeholder'),
          step: 1 %>
    </div>
    <p class="mt-2 text-[10px] text-indigo-400 font-bold uppercase tracking-tighter">
      * <%= t('admin.membership_pricings.form.price_hint') %>
    </p>
  </div>

  <div class="pt-4">
    <%= f.submit pricing.new_record? ? t('admin.membership_pricings.form.submit_create') : t('admin.membership_pricings.form.submit_update'),
        class: "w-full rounded-2xl bg-indigo-600 py-5 text-white font-black hover:bg-indigo-700 shadow-xl shadow-indigo-200 transition-all cursor-pointer" %>
  </div>
<% end %>
