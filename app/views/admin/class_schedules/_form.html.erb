<%= form_with model: [:admin, class_schedule], class: "space-y-6" do |f| %>
  
  <% if class_schedule.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 border border-red-200 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800"><%= t('admin.errors.header') %></h3>
          <ul class="mt-2 text-sm text-red-700 list-disc pl-5">
            <% class_schedule.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :class_type_id, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :class_type_id, @class_types, :id, :name, { prompt: t('admin.class_schedules.form.select_discipline') }, { class: "block w-full rounded-lg border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
    </div>

    <div>
      <%= f.label :instructor_id, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :instructor_id, @instructors, :id, :first_name, { prompt: t('admin.class_schedules.form.select_instructor') }, { class: "block w-full rounded-lg border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :starts_at, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.datetime_field :starts_at, class: "block w-full rounded-lg border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :duration_minutes, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <div class="relative rounded-md shadow-sm">
        <%= f.number_field :duration_minutes, class: "block w-full rounded-lg border-slate-300 pr-12 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
          <span class="text-slate-500 sm:text-sm">min</span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :capacity, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :capacity, class: "block w-full rounded-lg border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <p class="mt-1 text-xs text-slate-500"><%= t('admin.class_schedules.form.capacity_help') %></p>
    </div>

    <div class="flex items-center h-full pt-6">
      <div class="flex items-center">
        <%= f.check_box :cancelled, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
        <%= f.label :cancelled, class: "ml-2 block text-sm text-slate-900"><%= t('admin.class_schedules.form.cancelled_label') %></label>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
    <%= link_to t('admin.common.cancel'), admin_class_schedules_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
    
    <%= f.submit class_schedule.persisted? ? t('admin.common.update') : t('admin.common.create'), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>