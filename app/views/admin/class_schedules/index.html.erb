<% content_for :page_title, t('admin.class_schedules.index.title') %>

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between border-b border-slate-200 py-6">
  <div class="flex gap-3">
    <%= link_to t('admin.class_schedules.index.new_single'), new_admin_class_schedule_path, class: "rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm" %>
    
    <%= link_to batch_new_admin_class_schedules_path, class: "inline-flex justify-center rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-indigo-700 items-center gap-2 transition-all shadow-lg shadow-indigo-100" do %>
      <%= t('admin.class_schedules.index.program_batch') %>
    <% end %>
  </div>
</div>

<div class="w-full">
    <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-sm overflow-hidden w-full">
      <div class="p-8">
        <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6">Vista de Calendario</h3>
        
        <div class="calendar-wrapper-custom">
          <%= month_calendar(events: @class_schedules, attribute: :starts_at) do |date, classes| %>
            <div class="min-h-[100px] w-full">        
              <div class="flex flex-col gap-1">
                <% classes.each do |schedule| %>
                  <%= link_to admin_class_schedule_path(schedule), class: "group flex items-center gap-1 rounded-xl px-2 py-1.5 text-[10px] leading-tight transition-all border-l-4 hover:translate-x-1 shadow-sm #{schedule.cancelled? ? 'border-red-400 bg-red-50 opacity-60' : 'border-indigo-500 bg-indigo-50 hover:bg-white'}" do %>
                    <span class="font-black text-indigo-700">
                      <%= schedule.starts_at.strftime("%-I:%M") %>
                    </span>
                    <span class="truncate text-slate-900 font-bold uppercase italic tracking-tighter"><%= schedule.class_type.name %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>