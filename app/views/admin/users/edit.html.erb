<% content_for :page_title, t('admin.users.edit.title') %>

<div class="mx-auto max-w-lg">
  <div class="mb-6">
    <%= link_to admin_users_path, class: "text-xs font-black text-slate-400 hover:text-indigo-600 flex items-center gap-1 mb-4 transition-colors" do %>
      <span>←</span> <%= t('admin.users.edit.back') %>
    <% end %>
    <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.users.edit.title') %></h2>
    <p class="mt-1 text-sm text-slate-500"><%= t('admin.users.edit.subtitle', email: @user.email_address) %></p>
  </div>

  <div class="bg-white p-8 shadow-sm rounded-3xl border border-slate-200">
    <%= render "form", user: @user %>
  </div>

  
</div>