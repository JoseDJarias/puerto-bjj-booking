<% content_for :page_title, t('admin.class_schedules.index.title') %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.class_schedules.index.subtitle') %></h2>
  
  <div class="flex gap-2">
    <%= link_to t('admin.class_schedules.index.new_single'), new_admin_class_schedule_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    
    <%= link_to batch_new_admin_class_schedules_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      <%= t('admin.class_schedules.index.program_batch') %>
    <% end %>
  </div>
</div>

<div class="calendar-wrapper">
  <%= month_calendar(events: @class_schedules, attribute: :starts_at) do |date, classes| %>
    
    <div class="flex flex-col gap-1">
      <% classes.each do |schedule| %>
        <%= link_to edit_admin_class_schedule_path(schedule), class: "group flex flex-col rounded px-2 py-1 text-xs leading-tight transition-colors hover:bg-indigo-50 border-l-2 #{schedule.cancelled? ? 'border-red-400 bg-red-50 opacity-60' : 'border-indigo-500 bg-slate-50'}" do %>
          <span class="font-semibold <%= schedule.cancelled? ? 'text-red-700 line-through' : 'text-indigo-700' %>">
            <%= schedule.starts_at.strftime("%l:%M%P") %>
          </span>
          <span class="truncate text-slate-600 group-hover:text-indigo-900">
            <%= schedule.class_type.name %>
          </span>
        <% end %>
      <% end %>
    </div>

  <% end %>
</div>