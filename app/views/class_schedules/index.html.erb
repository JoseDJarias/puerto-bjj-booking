<%# app/views/class_schedules/index.html.erb %>
<% content_for :page_title, t('class_schedules.index.title') %>

<div class="max-w-5xl mx-auto px-4 py-2">
  <%= turbo_stream_from current_user, "bookings" %>
  <header class="flex items-center justify-between mb-8 mt-4">
    <h1 class="text-xl font-black text-slate-900 tracking-tight">Agenda</h1>

    <div class="flex gap-4">
      <%= link_to "DÍA", class_schedules_path(date: @date, view_mode: "day"),
                  class: "text-[10px] font-black tracking-widest #{@view_mode == 'day' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-slate-400'}" %>
      <%= link_to "SEMANA", class_schedules_path(date: @date, view_mode: "week"),
                  class: "text-[10px] font-black tracking-widest #{@view_mode == 'week' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-slate-400'}" %>
    </div>
  </header>

  <%# -- Date Selector -- %>
  <div class="w-full max-w-5xl mx-auto mb-6 mt-4">
    <div class="flex items-center justify-center border-b border-slate-50 pb-8 w-full">

      <div class="flex-none w-8 sm:w-20 flex justify-start">
        <%= link_to class_schedules_path(date: @date - 7.days, view_mode: @view_mode),
                    class: "text-slate-200 hover:text-indigo-600 p-2 transition-all hover:scale-125" do %>
          <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M15 19l-7-7 7-7" /></svg>
        <% end %>
      </div>

      <div class="flex-1 flex items-center justify-between mx-auto max-w-xs sm:max-w-4xl sm:gap-8 transition-all">
        <% @days_range.each do |day| %>
          <% is_selected = (day == @date) %>
          <% has_classes = @schedules_by_date[day].present? %>

          <%= link_to class_schedules_path(date: day, view_mode: @view_mode),
                      class: "flex flex-col items-center justify-center transition-all flex-1 min-w-0 group sm:transform sm:hover:scale-110" do %>

            <span class="text-[11px] sm:text-[13px] font-black uppercase mb-3 tracking-tighter sm:tracking-[0.3em] <%= is_selected ? 'text-indigo-600' : 'text-slate-300' %>">
              <%= t('date.abbr_day_names')[day.wday] %>
            </span>

            <div class="w-10 h-10 sm:w-16 sm:h-16 flex items-center justify-center rounded-full text-[12px] sm:text-xl font-black transition-all relative <%= is_selected ? 'bg-indigo-600 text-white shadow-2xl shadow-indigo-200' : 'text-slate-500 hover:bg-slate-100' %>">
              <%= day.day %>

              <% if has_classes && !is_selected %>
                <div class="absolute -bottom-2 w-1.5 h-1.5 bg-indigo-200 rounded-full"></div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="flex-none w-8 sm:w-20 flex justify-end">
        <%= link_to class_schedules_path(date: @date + 7.days, view_mode: @view_mode),
                    class: "text-slate-200 hover:text-indigo-600 p-2 transition-all hover:scale-125" do %>
          <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M9 5l7 7-7 7" /></svg>
        <% end %>
      </div>
    </div>
  </div>

  <%= turbo_frame_tag "agenda_content" do %>
    <div class="animate-in fade-in duration-300">
      <% if @view_mode == "day" %>
        <div class="flex flex-col gap-4">
          <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">
            <%= l(@date, format: "%A %d, %B") %>
          </p>

          <% if @class_schedules.any? %>
            <% @class_schedules.each do |schedule| %>
              <%= turbo_stream_from "schedule_#{schedule.id}" %>
              <%= render "class_schedules/partials/class_card_universal", schedule: schedule, user: Current.user, context: :agenda %>
            <% end %>
          <% else %>
            <div class="py-20 text-center border-2 border-dashed border-slate-100 rounded-[2rem] text-slate-300 text-xs font-bold uppercase tracking-widest">
              Sin clases hoy
            </div>
          <% end %>
        </div>
      <%   else %>
        <div class="flex flex-col gap-2">
          <% @days_range.each do |day| %>
            <% day_classes = @schedules_by_date[day] || [] %>
            <% next if day_classes.empty? %>
            <section data-controller="accordion"
                     data-accordion-always-active-value="true"
                     class="bg-white rounded-[2rem] overflow-hidden transition-all duration-300 hover:shadow-md px-4"
                     data-accordion-target="card">

              <button type="button"
                      data-action="click->accordion#toggle"
                      class="w-full flex items-center justify-between px-6 py-5 text-left focus:outline-none">

                <div class="flex flex-col">
                  <span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest mb-1">
                    <%= l(day, format: "%A") %>
                  </span>
                  <span class="text-lg font-black text-slate-900 tracking-tight">
                    <%= l(day, format: "%d de %B") %>
                  </span>
                </div>

                <div class="flex items-center gap-3">
                  <span class="text-[10px] font-bold text-slate-400 bg-slate-50 px-3 py-1 rounded-full uppercase">
                    <%= pluralize(day_classes.count, 'clase', 'clases') %>
                  </span>
                  <div class="text-slate-300 transition-transform duration-300" data-accordion-target="icon">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </div>
              </button>

              <div class="grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out"
                   data-accordion-target="wrapper">
                <div class="overflow-hidden">
                  <div class="pb-6 pt-2">
                    <div class="grid gap-6 sm:grid-cols-2">
                      <% day_classes.each do |s| %>
                        <%= render "class_schedules/partials/class_card_universal", schedule: s, user: Current.user, context: :week %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>