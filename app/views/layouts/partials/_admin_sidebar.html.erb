<aside data-sidebar-target="sidebar" 
       class="fixed inset-y-0 left-0 z-50 w-64 transform bg-white shadow-xl transition-transform duration-300 ease-in-out lg:relative lg:translate-x-0 -translate-x-full flex flex-col border-r border-slate-100">
  
  <div class="flex h-16 items-center justify-between px-6 bg-slate-900">
    <span class="text-lg font-black italic text-white tracking-tighter uppercase">
      <%= t('admin.layout.sidebar.brand_room') %> <span class="text-indigo-500"><%= t('admin.layout.sidebar.brand_control') %></span>
    </span>
    <button type="button" data-action="click->sidebar#close" class="lg:hidden text-slate-400 hover:text-white transition-colors">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-4 py-6">
    
    <% link_classes = "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-bold transition-all duration-200 group mb-1" %>
    <% active_classes = "bg-indigo-50 text-indigo-700 shadow-sm ring-1 ring-indigo-200" %>
    <% inactive_classes = "text-slate-600 hover:bg-slate-50 hover:text-slate-900" %>
    <% section_header = "px-3 mb-2 text-[10px] font-black uppercase tracking-widest text-slate-400 mt-6 first:mt-0" %>

    <%# --- OPERATIONAL SECTION (Access: Admin and Instructor) --- %>
    <p class="<%= section_header %>"><%= t('admin.layout.sidebar.operations') %></p>
    
    <%= link_to admin_dashboard_path, class: "#{link_classes} #{current_page?(admin_dashboard_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(admin_dashboard_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span><%= t('admin.layout.sidebar.dashboard') %></span>
    <% end %>

    <%# --- MANAGEMENT SECTION (Access: Only Admin) --- %>
    <% if current_user.admin? %>
      <p class="<%= section_header %>"><%= t('admin.layout.sidebar.academy_management') %></p>
      
      <%= link_to admin_users_path, class: "#{link_classes} #{request.path.include?('/users') ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= request.path.include?('/users') ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span><%= t('admin.users.index.title') %></span>
      <% end %>

      <%= link_to admin_memberships_path, class: "#{link_classes} #{current_page?(admin_memberships_path) ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= current_page?(admin_memberships_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
        </svg>
        <span><%= t('admin.memberships.index.title') %></span>
      <% end %>

      <%= link_to admin_class_schedules_path, class: "#{link_classes} #{request.path.include?('/class_schedules') && !current_page?(admin_dashboard_path) ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= request.path.include?('/class_schedules') && !current_page?(admin_dashboard_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span><%= t('admin.class_schedules.index.title') %></span>
      <% end %>

      <%# --- STORE & ORDERS SECTION (Access: Only Admin) --- %>
      <p class="<%= section_header %>"><%= t('admin.layout.sidebar.catalog_section') %></p>

      <%= link_to admin_products_path, class: "#{link_classes} #{request.path.start_with?('/admin/catalogo') ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= request.path.start_with?('/admin/catalogo') ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span><%= t('admin.layout.sidebar.catalog') %></span>
      <% end %>

      <%= link_to admin_product_orders_path, class: "#{link_classes} #{request.path.start_with?('/admin/pedidos') ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= request.path.start_with?('/admin/pedidos') ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span><%= t('admin.layout.sidebar.orders') %></span>
      <% end %>

      <%# --- CONFIGURATION SECTION (Access: Only Admin) --- %>
      <p class="<%= section_header %>"><%= t('admin.layout.menu.config_section') %></p>

      <%= link_to admin_membership_plans_path, class: "#{link_classes} #{current_page?(admin_membership_plans_path) ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= current_page?(admin_membership_plans_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span><%= t('admin.layout.plans') %></span>
      <% end %>

      <%= link_to admin_membership_pricings_path, class: "#{link_classes} #{current_page?(admin_membership_pricings_path) ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= current_page?(admin_membership_pricings_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z" />
        </svg>
        <span><%= t('admin.membership_pricings.index.title') %></span>
      <% end %>

      <%= link_to admin_membership_packages_path, class: "#{link_classes} #{current_page?(admin_membership_packages_path) ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= current_page?(admin_membership_packages_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span><%= t('admin.packages.index.title') %></span>
      <% end %>

      <%= link_to admin_class_types_path, class: "#{link_classes} #{current_page?(admin_class_types_path) ? active_classes : inactive_classes}" do %>
        <svg class="h-5 w-5 <%= current_page?(admin_class_types_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        <span><%= t('admin.class_types.index.title') %></span>
      <% end %>
    <% end %>

  </nav>

  <%# Escape button to return to the user view %>
  <div class="p-4 border-t border-slate-100 bg-slate-50/50">
    <%= link_to root_path, class: "flex w-full items-center justify-center gap-2 rounded-xl bg-white border border-slate-200 px-4 py-3 text-xs font-black text-slate-700 hover:bg-slate-900 hover:text-white transition-all shadow-sm active:scale-95" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
      <%= t('admin.layout.close_menu') %>
    <% end %>
  </div>
</aside>