<div class="mb-6">
  <%= link_to admin_memberships_path, class: "inline-flex items-center gap-2 text-slate-400 hover:text-indigo-600 transition-colors group" do %>
    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white border border-slate-200 group-hover:border-indigo-100 group-hover:bg-indigo-50 shadow-sm">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7" />
      </svg>
    </div>
    <span class="text-xs font-black uppercase tracking-widest">Volver al listado</span>
  <% end %>
</div>
<div data-controller="membership-preview">
  <%= form_with model: [:admin, membership],
                id: "membership_form",
                data: { membership_preview_target: "form", turbo: false },
                class: "space-y-8" do |f| %>

    <section class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
      <% if membership.errors.any? %>
        <div class="rounded-2xl bg-red-50 p-4 border-2 border-red-100 mb-6 w-full overflow-hidden">
            <div class="flex items-start gap-3 mb-3">
            <div class="h-6 w-6 rounded-full bg-red-100 flex-shrink-0 flex items-center justify-center text-red-600 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
            </div>
            <h3 class="text-sm font-black text-red-800 uppercase tracking-tight leading-tight">
                <%= t("admin.memberships.form.errors_title") %>
            </h3>
            </div>
            
            <ul class="space-y-2 ml-9 break-words">
            <% membership.errors.full_messages.each do |msg| %>
                <li class="text-xs sm:text-sm text-red-700 font-medium leading-relaxed">
                <span class="font-black italic mr-1 text-red-400">•</span> 
                <%= msg %>
                </li>
            <% end %>
            </ul>
        </div>
      <% end %>

      <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-sm italic font-black">1</span>
        <%= t("admin.memberships.form.step_student") %>
      </h3>

    <%= f.collection_select :user_id, User.order(:first_name), :id, :full_legal_name,
        { prompt: t("admin.memberships.form.search_student_prompt") },
        { 
          class: "block w-full rounded-xl border-slate-300 py-3 px-4 focus:ring-indigo-600",
          data: { action: "change->membership-preview#update" } 
        } %>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <section class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-6 italic">2. <%= t("admin.memberships.form.step_config") %></h3>

        <div class="space-y-8">
          <div>
            <label class="block text-xs font-black uppercase text-slate-400 mb-4 text-center tracking-widest"><%= t("admin.memberships.form.package_label") %></label>
            <div class="grid grid-cols-2 gap-3">
              <% MembershipPackage.active.each do |pkg| %>
                <label class="group cursor-pointer">
                  <%= f.radio_button :membership_package_id, pkg.id, 
                      class: "peer sr-only", 
                      data: { action: "change->membership-preview#update" } %>
                  <div class="rounded-xl border-2 border-slate-100 p-4 text-center transition-all peer-checked:border-indigo-600 peer-checked:bg-indigo-50 group-hover:bg-slate-50">
                    <span class="block text-sm font-black text-slate-900 uppercase"><%= pkg.name %></span>
                  </div>
                </label>
              <% end %>
            </div>
          </div>

          <div>
            <label class="block text-xs font-black uppercase text-slate-400 mb-4 text-center tracking-widest"><%= t("admin.memberships.form.plan_duration_label") %></label>
            <div class="flex flex-wrap justify-center gap-2 mb-4">

              <% MembershipPlan.active.each do |plan| %>
                <label class="cursor-pointer">
                  <%= f.radio_button :membership_plan_id, plan.id, 
                      class: "peer sr-only", 
                      data: { action: "change->membership-preview#update" } %>
                  <div class="rounded-full border-2 border-slate-100 px-5 py-2 text-xs font-black transition-all peer-checked:border-indigo-600 peer-checked:bg-indigo-600 peer-checked:text-white">
                    <%= plan.name %>
                  </div>
                </label>
              <% end %>
            </div>
          </div>
        </div>

        <section class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900 mb-6 italic leading-none flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-sm italic font-black">3</span>
            <%= t("admin.memberships.form.dates_section_title") %>
          </h3>
          <div class="p-5 bg-slate-50 rounded-2xl border border-slate-100">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
              <div class="flex-1 w-full">
                <label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  <%= t("activerecord.attributes.membership.start_date") %>
                </label>
                <%= f.date_field :start_date, 
                    class: "block w-full rounded-xl border-slate-200 bg-white py-2.5 px-4 text-sm font-bold text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 transition-all shadow-sm",
                    data: { action: "change->membership-preview#update" } %>
              </div>

              <div class="hidden sm:flex mt-6">
                <div class="h-8 w-8 flex items-center justify-center rounded-full bg-white shadow-sm border border-slate-100">
                  <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </div>
              </div>

              <div class="flex-1 w-full">
                <label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  <%= t("admin.memberships.form.end_date_manual") %>
                </label>
                <%= f.date_field :end_date, 
                    class: "block w-full rounded-xl border-slate-200 bg-white py-2.5 px-4 text-sm font-bold text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 transition-all shadow-sm",
                    data: { membership_preview_target: "endDateInput" } %>
              </div>
            </div>

            <div class="mt-5 pt-4 border-t border-slate-200">
              <label class="block text-[10px] font-black uppercase text-slate-500 mb-2 tracking-widest flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <%= t("activerecord.attributes.membership.status") %>
              </label>
              <%= f.select :status, 
                  Membership.statuses.keys.map { |s| [t("activerecord.attributes.membership.statuses.#{s}"), s] },
                  {},
                  class: "block w-full rounded-xl border-slate-200 bg-white py-2.5 px-4 text-sm font-bold text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 transition-all shadow-sm cursor-pointer" %>
            </div>
          </div>
          <p class="text-[9px] text-slate-400 mt-3 italic"><%= t("admin.memberships.form.dates_help") %></p>
        </section>
      </section>

      <section class="bg-indigo-950 p-8 rounded-3xl text-white shadow-2xl relative overflow-hidden flex flex-col justify-between min-h-[420px]">
        <div>
          <div class="flex justify-between items-start mb-10 border-b border-indigo-800/50 pb-4">
            <h3 class="text-xl font-black italic tracking-tighter leading-none">PUERTO BJJ</h3>
            <span class="bg-indigo-500/20 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest italic"><%= t("admin.memberships.form.preview_badge") %></span>
          </div>

          <div class="space-y-1">
            <p class="text-indigo-400 text-[10px] font-black uppercase tracking-widest"><%= t("admin.memberships.form.total_net") %></p>
            <div class="flex items-center gap-1">
              <%# Símbolo de moneda %>
              <span class="text-indigo-400 font-bold uppercase text-3xl">₡</span>
              
              <%# INPUT EDITABLE: nota que usamos f.number_field %>
              <%= f.number_field :amount_paid, 
                  step: 1,
                  class: "bg-transparent border-0 text-7xl font-black tabular-nums tracking-tighter italic leading-none focus:ring-0 w-full p-0 text-white placeholder:text-indigo-800 appearance-none",
                  data: { membership_preview_target: "amount" },
                  placeholder: "0" %>
                  
              <span class="text-indigo-400 font-bold uppercase text-xl ml-2">CRC</span>
            </div>
            <p class="text-[9px] text-indigo-400/50 italic mt-2">
              * El precio se calcula automáticamente, pero puedes editarlo aquí para convenios (ej: poner 0).
            </p>
         </div>
          
        </div>

        <div class="space-y-6">
          <div class="border-t border-indigo-800/50 pt-6">
            <p class="text-indigo-400 text-[10px] font-black uppercase tracking-widest mb-1"><%= t("admin.memberships.form.due_date") %></p>
            <p class="font-bold italic text-sm" data-membership-preview-target="endDate">
              <%= membership.end_date ? l(membership.end_date, format: :long) : "---" %>
            </p>
          </div>

          <%= f.submit t("admin.memberships.form.confirm_button"), 
              class: "w-full rounded-2xl bg-white py-5 text-indigo-950 font-black text-lg hover:bg-indigo-50 transition-all shadow-xl cursor-pointer disabled:opacity-20 disabled:cursor-not-allowed" %>
        </div>
      </section>
    </div>
  <% end %>
</div>