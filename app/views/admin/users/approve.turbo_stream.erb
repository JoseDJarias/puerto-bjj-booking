<% if @user.errors.any? %>
  <%= turbo_stream.prepend "flash" do %>
    <%= render partial: "layouts/flash", locals: { type: :alert, message: flash.now[:alert] } %>
  <% end %>
<% else %>
    <%= turbo_stream.replace dom_id(@user) do %>
    <%= render partial: "admin/users/partials/user", locals: { user: @user } %>
    <% end %>  
  <%= turbo_stream.prepend "flash" do %>
    <%= render partial: "layouts/flash", locals: { type: :notice, message: flash.now[:notice] } %>
  <% end %>
<% end %>