<% content_for :title, t('product_orders.index.title') %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= t('product_orders.index.title') %></h1>
      <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1"><%= t('product_orders.index.subtitle') %></p>
    </div>

    <%= link_to products_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-xs font-black uppercase tracking-wider shadow-sm transition-all self-start sm:self-auto" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
      Ver Catálogo
    <% end %>
  </div>

  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 overflow-hidden shrink-0 flex items-center justify-center">
                <% if order.product&.images&.attached? %>
                  <%= image_tag order.product.images.first, class: "w-full h-full object-cover" %>
                <% else %>
                  <svg class="w-6 h-6 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                <% end %>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-black text-slate-400">#<%= order.id %></span>
                  <span class="text-xs text-slate-400 font-medium">• <%= l(order.created_at.in_time_zone("America/Costa_Rica"), format: "%d/%m/%Y") %></span>
                </div>
                <h3 class="text-base font-black text-slate-900"><%= order.product_name %></h3>
                <div class="flex flex-wrap gap-x-3 text-xs mt-1">
                  <span class="text-slate-500">Anticipo: <strong class="text-slate-800">₡<%= number_with_delimiter(order.deposit_amount.to_i) %></strong></span>
                  <span class="text-slate-400">Total: ₡<%= number_with_delimiter(order.product_price.to_i) %></span>
                </div>
              </div>
            </div>

            <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-3 pt-3 sm:pt-0 border-t sm:border-t-0 border-slate-100">
              <% status_classes = case order.status
                 when "pending_verification" then "bg-amber-50 text-amber-700 border-amber-200"
                 when "payment_confirmed" then "bg-indigo-50 text-indigo-700 border-indigo-200"
                 when "ordered_from_supplier" then "bg-blue-50 text-blue-700 border-blue-200"
                 when "ready_for_pickup" then "bg-green-50 text-green-700 border-green-200"
                 when "delivered" then "bg-slate-100 text-slate-700 border-slate-200"
                 else "bg-red-50 text-red-700 border-red-200"
                 end %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-xl text-[10px] font-black uppercase tracking-wider border <%= status_classes %>">
                <%= t("product_orders.status.#{order.status}") %>
              </span>

              <%= link_to my_order_path(order), class: "inline-flex items-center gap-1 text-xs font-bold text-indigo-600 hover:text-indigo-800" do %>
                <span><%= t('product_orders.index.view_order') %></span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-3xl p-12 border border-slate-100 shadow-sm text-center">
      <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
      </div>
      <p class="text-sm font-bold text-slate-700 mb-4"><%= t('product_orders.index.empty_state') %></p>
      <%= link_to "Ir al Catálogo", products_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white font-black text-xs uppercase tracking-wider rounded-2xl shadow-lg shadow-indigo-100" %>
    </div>
  <% end %>
</div>
