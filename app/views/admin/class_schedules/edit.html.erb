<%# app/views/admin/class_schedules/edit.html.erb %>
<% content_for :page_title, t('admin.class_schedules.edit.page_title') %>

<div class="w-full py-6 px-4">
  <%# Breadcrumbs %>
  <nav class="mb-6 flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
    <%= link_to admin_class_schedules_path, class: "hover:text-indigo-600 transition-colors" do %>
      <%= t('admin.class_schedules.edit.breadcrumb_calendar') %>
    <% end %>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
    <%= link_to admin_class_schedule_path(@class_schedule), class: "hover:text-indigo-600 transition-colors" do %>
      <%= t('admin.class_schedules.edit.breadcrumb_detail') %>
    <% end %>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
    <span class="text-indigo-600/50 uppercase tracking-[0.2em]"><%= t('admin.class_schedules.edit.breadcrumb_edit') %></span>
  </nav>

  <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-8 lg:p-12">
      <header class="mb-12 border-b border-slate-100 pb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <div class="h-8 w-1.5 bg-indigo-600 rounded-full"></div>
            <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tighter italic leading-none">
              <%= t('admin.class_schedules.edit.title') %>
            </h2>
          </div>
          <p class="text-[11px] font-black text-indigo-600 tracking-[0.3em] uppercase ml-4">
            Modificar Sesión Individual
          </p>
        </div>
        
        <%= button_to admin_class_schedule_path(@class_schedule), 
                      method: :delete, 
                      data: { turbo_confirm: t('admin.class_schedules.edit.delete_confirm') }, 
                      class: "group flex items-center gap-2 px-5 py-3 bg-red-50 hover:bg-red-500 rounded-2xl text-red-500 hover:text-white border border-red-100 transition-all active:scale-95" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          <span class="text-[10px] font-black uppercase tracking-widest"><%= t('admin.class_schedules.edit.delete_class') %></span>
        <% end %>
      </header>
      
      <%= render "admin/class_schedules/partials/form", class_schedule: @class_schedule %>
    </div>
  </div>
</div>