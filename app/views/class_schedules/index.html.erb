<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-slate-900 mb-6"><%= t('class_schedules.index.public_title') %></h1>

  <%= turbo_stream_from current_user, "bookings" %>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% @class_schedules.each do |schedule| %>
      
      <%= turbo_stream_from "schedule_#{schedule.id}" %>

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 hover:shadow-md transition-all">
        <div class="flex justify-between items-start">
          <div>
            <h3 class="font-bold text-slate-900"><%= schedule.class_type.name %></h3>
            <p class="text-sm text-slate-500"><%= schedule.starts_at.strftime("%A %d, %H:%M") %></p>
            <p class="text-xs text-indigo-600 mt-1 font-medium"><%= schedule.instructor.first_name %></p>
          </div>
          
          <%= render "class_schedules/spots", schedule: schedule %>
        </div>

        <div class="mt-4 pt-4 border-t border-slate-100">
          <%= render "class_schedules/action_button", schedule: schedule, user: current_user %>
        </div>
      </div>

    <% end %>
  </div>
</div>