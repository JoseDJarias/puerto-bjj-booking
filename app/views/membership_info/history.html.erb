<% content_for :page_title, t('my_membership.history.title') %>

<div class="min-h-0 max-w-3xl">
  <div class="mb-8">
    <%= link_to my_membership_path, class: "inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 mb-6" do %>
      <%= t('my_membership.history.back') %>
    <% end %>
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2"><%= t('my_membership.history.title') %></h1>
    <p class="text-slate-600"><%= t('my_membership.history.subtitle') %></p>
  </div>

  <section class="mb-12">
    <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t('my_membership.history.memberships_heading') %></h2>
    <% if @past_memberships.any? %>
      <div class="space-y-4">
        <% @past_memberships.each do |m| %>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-6 py-5">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
              <div>
                <p class="font-semibold text-slate-900"><%= m.membership_package.name %></p>
                <p class="text-sm text-slate-600"><%= m.membership_plan.display_name %></p>
              </div>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                <%= t("my_membership.history.membership_status.#{m.status}") %>
              </span>
            </div>
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-1 text-sm">
              <div>
                <dt class="text-slate-500"><%= t('my_membership.start_date') %></dt>
                <dd class="text-slate-900"><%= l(m.start_date, format: :short) %></dd>
              </div>
              <div>
                <dt class="text-slate-500"><%= t('my_membership.end_date') %></dt>
                <dd class="text-slate-900"><%= l(m.end_date, format: :short) %></dd>
              </div>
              <% if m.amount_paid.to_f.positive? %>
                <div class="sm:col-span-2">
                  <dt class="text-slate-500"><%= t('my_membership.history.amount_paid') %></dt>
                  <dd class="text-slate-900"><%= number_to_currency(m.amount_paid, unit: "$", separator: ",", delimiter: ".", format: "%u %n") %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-slate-500 text-sm py-6 rounded-xl bg-slate-50 border border-slate-100 text-center"><%= t('my_membership.history.no_memberships') %></p>
    <% end %>
  </section>

  <section>
    <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t('my_membership.history.drop_in_heading') %></h2>
    <% if @drop_in_history.any? %>
      <div class="space-y-4">
        <% @drop_in_history.each do |ticket| %>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-6 py-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-slate-100 text-slate-600">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
              </span>
              <div>
                <p class="font-medium text-slate-900">
                  <%= ticket.used_at ? l(ticket.used_at.to_date, format: :long) : l(ticket.updated_at.to_date, format: :short) %>
                </p>
                <p class="text-sm text-slate-500"><%= t("my_membership.history.drop_in_status.#{ticket.status}") %></p>
              </div>
            </div>
            <% if ticket.price_paid.to_f.positive? %>
              <p class="text-sm font-medium text-slate-700"><%= number_to_currency(ticket.price_paid, unit: "$", separator: ",", delimiter: ".", format: "%u %n") %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-slate-500 text-sm py-6 rounded-xl bg-slate-50 border border-slate-100 text-center"><%= t('my_membership.history.no_drop_ins') %></p>
    <% end %>
  </section>
</div>