<% content_for :page_title, t('admin.memberships.index.title') %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900">Membresías</h2>
    <%= link_to "Nueva Membresía", new_admin_membership_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-indigo-700 transition-all" %>
  </div>

  <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm sticky top-0 z-20">
    <%= form_with url: admin_memberships_path(format: :turbo_stream), method: :get, data: { turbo_frame: "memberships_list", turbo_action: "advance" } do |f| %>
      <%= hidden_field_tag :filter, params[:filter] %>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>
        <%= f.text_field :query, placeholder: "Buscar alumno...", value: params[:query], oninput: "this.form.requestSubmit()", class: "block w-full rounded-lg border-0 py-3 pl-10 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm shadow-sm" %>
      </div>
    <% end %>
  </div>

  <%# --- TABS PILLS --- %>
  <nav class="flex space-x-2 overflow-x-auto no-scrollbar pb-2" aria-label="Tabs">
    <% [ [nil, 'Todas', 'Historial'], ['active', 'Activas', 'Live'], ['expired', 'Vencidas', nil] ].each do |val, label, sub| %>
      <% active = params[:filter] == val %>
      <%= link_to admin_memberships_path(filter: val, query: params[:query]), 
          class: "whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold transition-all #{active ? 'bg-indigo-600 text-white shadow-md' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50'}", 
          data: { turbo_action: "advance" } do %>
        <div class="flex items-center gap-2">
          <% if val == 'active' %><span class="h-2 w-2 rounded-full bg-green-400 <%= 'animate-pulse' if active %>"></span><% end %>
          <%= label %>
        </div>
      <% end %>
    <% end %>
  </nav>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Alumno</th>
            <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Plan</th>
            <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Vence</th>
            <th class="relative px-4 py-3"></th>
          </tr>
        </thead>
        <%= turbo_frame_tag "memberships_list" do %>
          <tbody id="memberships_table_body" class="divide-y divide-slate-200 bg-white">
            <%= render @memberships %>
          </tbody>
          <% if @pagy.next %>
            <div id="load_more_container" class="p-4 text-center bg-slate-50">
              <%= link_to "Cargar más", admin_memberships_path(page: @pagy.next, query: params[:query], filter: params[:filter]), data: { turbo_stream: true }, class: "inline-flex items-center rounded-full bg-white px-6 py-2 text-sm font-bold text-indigo-600 shadow-sm ring-1 ring-indigo-200 hover:bg-indigo-50 active:scale-95 transition-all" %>
            </div>
          <% end %>
        <% end %>
      </table>
    </div>
  </div>
</div>