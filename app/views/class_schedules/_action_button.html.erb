<div id="action_button_schedule_<%= schedule.id %>">
  <% my_booking = schedule.bookings.find_by(user: user) %>
  
  <% if my_booking&.active_status? %>
    <%= button_to bookings_path(class_schedule_id: schedule.id), 
        class: "group w-full rounded-lg border border-red-200 bg-white px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 hover:border-red-300 transition-all shadow-sm flex items-center justify-center gap-2" do %>
        <svg class="w-4 h-4 text-red-400 group-hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    <%= t('bookings.actions.cancel') %>
  <% end %>

  <% else %>
    <% if schedule.full? && !user.admin? %> 
      <button disabled class="w-full rounded-lg bg-slate-100 px-3 py-2 text-sm font-medium text-slate-400 cursor-not-allowed border border-slate-200 flex justify-center items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          <%= t('bookings.actions.full') %>
      </button>
    <% else %>
      <%= button_to bookings_path(class_schedule_id: schedule.id), 
          class: "w-full rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 hover:shadow-md transition-all flex items-center justify-center gap-2" do %>
          <%= t('bookings.actions.reserve') %>
      <% end %>
    <% end %>
  <% end %>

  <% if my_booking && my_booking.submission_count >= 3 %>
    <p class="mt-2 text-[10px] text-center text-red-500 font-medium bg-red-50 p-1 rounded">
    <%= t('bookings.messages.limit_reached') %>  
    </p>
  <% elsif my_booking %>
     <% end %>
</div>