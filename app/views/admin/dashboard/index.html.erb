<%# app/views/admin/dashboard/index.html.erb %>
<header class="mb-10 px-1 pt-4">
  <div class="flex items-center gap-3 mb-6">
    <div class="px-4 py-1.5 bg-slate-900 rounded-full shadow-lg shadow-slate-200 flex items-center gap-2 border border-slate-800">
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span class="text-[11px] font-black text-white uppercase tracking-[0.2em]">
        <%= current_user.admin? ? "Centro de Mando" : "Modo Instructor" %>
      </span>
    </div>
  </div>
  
  <h1 class="text-6xl font-black text-slate-900 italic uppercase tracking-tighter leading-[0.85] mb-8">
    ¡OSS <br>
    <span class="text-indigo-600"><%= current_user.first_name %>!</span>
  </h1>
  
  <div class="flex items-center gap-6 text-slate-400">
    <div class="flex items-center gap-2.5">
      <div class="bg-indigo-50 p-2 rounded-xl text-indigo-600 border border-indigo-100/50">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9 3.75h.008v.008H12v-.008Z" />
        </svg>
      </div>
      <span class="text-xs font-black uppercase tracking-widest text-slate-900">
        <%= @offset == 0 ? "HOY, #{l(@date, format: "%d %b")}" : l(@date, format: "%d %b") %>
      </span>
    </div>

    <div class="h-4 w-px bg-slate-200"></div>

    <div class="flex items-center gap-2.5">
      <div class="bg-slate-50 p-2 rounded-xl text-slate-400 border border-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
      </div>
      <span class="text-xs font-black uppercase tracking-widest text-slate-400">
        <%= @schedules.count %> Sesiones
      </span>
    </div>
  </div>
</header>

<div class="grid grid-cols-2 gap-4 mb-12 px-2">
  <div class="bg-white p-6 rounded-[2.5rem] border border-slate-100 shadow-sm text-center md:text-left">
    <span class="block text-[9px] font-black text-slate-400 uppercase mb-2 tracking-widest leading-none">Inscritos</span>
    <span class="text-4xl font-black text-slate-900 italic tracking-tighter leading-none"><%= @schedules.sum { |s| s.active_bookings.count } %></span>
  </div>
  <div class="bg-slate-900 p-6 rounded-[2.5rem] text-white shadow-xl shadow-slate-200 border border-slate-800 text-center md:text-left">
    <span class="block text-[9px] font-black text-slate-500 uppercase mb-2 tracking-widest leading-none">En Tatami</span>
    <div class="flex items-baseline justify-center md:justify-start gap-2 mt-1">
      <span class="text-4xl font-black italic tracking-tighter leading-none text-white"><%= @schedules.sum { |s| s.bookings.attended.count } %></span>
      <span class="text-[10px] font-black text-green-500 uppercase tracking-tighter italic">PRES</span>
    </div>
  </div>
</div>

<%= turbo_frame_tag "dashboard_sessions" do %>
  <div class="mb-8 px-3">
    <div class="flex flex-col mb-5">
      <h2 class="text-xs font-black text-slate-900 uppercase tracking-widest italic leading-none mb-1.5">
        <%= current_user.admin? ? "Plan Operativo" : "Mis Clases" %>
      </h2>
      
      <div class="flex items-center gap-1.5">
        <span class="text-[10px] font-black text-indigo-600 uppercase tracking-[0.1em]">
          <% if @offset == 0 %>
            HOY (BLOQUE ACTUAL)
          <% elsif @offset == 1 %>
            MAÑANA
          <% elsif @offset == -1 %>
            AYER
          <% else %>
            <%= l(@date, format: "%A, %d de %B") %>
          <% end %>
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2 bg-white p-1.5 rounded-2xl border border-slate-100 shadow-sm w-full">
      
      <%= link_to admin_dashboard_path(offset: @offset - 1), 
                  class: "flex items-center justify-center gap-2 min-w-[80px] px-3 py-2.5 hover:bg-slate-50 rounded-xl transition-all text-slate-400 hover:text-indigo-600 group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0">
          <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
        </svg>
        <span class="text-[10px] font-black uppercase tracking-tighter">
          <%= (@date - 1.day).strftime("%d/%m") %>
        </span>
      <% end %>

      <div class="flex-1 flex justify-center">
        <% if @offset != 0 %>
          <%= link_to admin_dashboard_path(offset: 0), 
                      class: "w-full flex items-center justify-center px-4 py-2.5 bg-slate-900 rounded-xl text-[10px] font-black text-white uppercase tracking-widest shadow-lg shadow-slate-200 active:scale-95 transition-all" do %>
            HOY
          <% end %>
        <% else %>
          <div class="h-1 w-8 bg-slate-100 rounded-full"></div>
        <% end %>
      </div>

      <%= link_to admin_dashboard_path(offset: @offset + 1), 
                  class: "flex items-center justify-center gap-2 min-w-[80px] px-3 py-2.5 hover:bg-slate-50 rounded-xl transition-all text-slate-400 hover:text-indigo-600 group text-right" do %>
        <span class="text-[10px] font-black uppercase tracking-tighter">
          <%= (@date + 1.day).strftime("%d/%m") %>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0">
          <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </div>

    <div class="mt-4 px-1">
      <div class="flex items-center gap-2 text-[9px] font-bold text-slate-400 uppercase tracking-tighter bg-slate-50/50 p-2 rounded-lg border border-slate-100/50 w-fit">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 text-slate-300">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <span>Viendo bloque del <%= l(@date, format: "%d %b %Y") %></span>
      </div>
    </div>
  </div>

  <div class="space-y-6 px-2 pb-24 transition-all duration-300">
    <% if @schedules.any? %>
      <% @schedules.each do |schedule| %>
        <div class="relative group">

          <% if current_user.admin? %>
            <%= link_to admin_class_schedule_path(schedule), 
                        data: { turbo: false },
                        class: "absolute right-4 top-4 z-10 p-3 bg-slate-50 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-2xl transition-all border border-slate-100/50 shadow-sm" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            <% end %>
          <% end %>
          <%= link_to attendance_admin_class_schedule_path(schedule), 
                      data: { turbo: false },
                      class: "block bg-white rounded-[2.5rem] border border-slate-100 p-6 shadow-sm active:scale-[0.97] transition-all" do %>
            <div class="flex items-start justify-between mb-6">
              <div class="flex items-center gap-4">
                <div class="bg-indigo-50 px-3 py-2 rounded-2xl flex flex-col items-center justify-center min-w-[65px] border border-indigo-100/50 text-indigo-900">
                  <span class="text-base font-black leading-none"><%= schedule.starts_at.strftime("%H:%M") %></span>
                  <span class="text-[8px] font-bold text-indigo-400 uppercase"><%= schedule.starts_at.strftime("%P") %></span>
                </div>
                <div>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-slate-50 text-[8px] font-black text-slate-400 uppercase tracking-widest mb-1">SESIÓN</span>
                  <h3 class="text-2xl font-black text-slate-900 tracking-tighter leading-none uppercase italic"><%= schedule.class_type.name %></h3>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="bg-slate-50/50 rounded-2xl p-4 border border-slate-100 flex flex-col items-center justify-center text-center">
                <span class="text-3xl font-black text-slate-900 leading-none tracking-tighter"><%= schedule.active_bookings.count %></span>
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest mt-1">Inscritos</span>
              </div>
              <div class="bg-green-50/30 rounded-2xl p-4 border border-green-100/50 flex flex-col items-center justify-center text-center">
                <span class="text-3xl font-black text-green-600 leading-none tracking-tighter"><%= schedule.bookings.attended.count %></span>
                <span class="text-[10px] font-black text-green-500 uppercase tracking-widest mt-1">Presentes</span>
              </div>
            </div>
            
            <div class="flex items-center gap-2 px-1">
              <div class="w-1.5 h-1.5 rounded-full bg-indigo-400"></div>
              <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                Instructor: <span class="text-slate-600"><%= schedule.instructor.display_name %></span>
              </p>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="py-20 bg-white rounded-[3rem] border-2 border-dashed border-slate-100 flex flex-col items-center justify-center text-center px-6 text-slate-400 uppercase italic">
        No hay clases registradas en este bloque.
      </div>
    <% end %>
  </div>
<% end %>