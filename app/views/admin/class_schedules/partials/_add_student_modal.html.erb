<div data-modal-target="container" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/90 backdrop-blur-sm">
  <div class="bg-white w-full max-w-lg rounded-[3rem] shadow-2xl overflow-hidden shadow-indigo-500/20 animate-in fade-in zoom-in duration-300">
    
    <div class="p-8" data-controller="search-list">
      <%# HEADER DEL MODAL %>
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-black text-slate-900 uppercase italic tracking-tighter"><%= t('admin.class_schedules.add_student_modal.title') %></h2>
        <button data-action="click->modal#close" class="text-slate-400 p-2 hover:bg-slate-50 rounded-full transition-colors active:scale-90">
           <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <%# BUSCADOR E INTERRUPTOR DE ACCESO %>
      <div class="space-y-4 mb-6">
        <%# Input de búsqueda %>
        <div class="relative">
          <input type="text" 
                 data-action="input->search-list#filter"
                 placeholder="<%= t('admin.class_schedules.add_student_modal.search_placeholder') %>" 
                 class="w-full bg-slate-50 border-none rounded-2xl py-4 pl-12 pr-4 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-slate-300">
          <svg class="w-5 h-5 text-slate-300 absolute left-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>

        <%# Toggle sutil para ver usuarios sin acceso %>
        <div class="flex items-center justify-between px-4 py-3 bg-indigo-50/50 rounded-2xl border border-indigo-100/30">
          <span class="text-[10px] font-black text-indigo-900 uppercase tracking-tighter"><%= t('admin.class_schedules.add_student_modal.show_without_membership') %></span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" data-action="change->search-list#toggleAll" class="sr-only peer">
            <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-indigo-600 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all"></div>
          </label>
        </div>
      </div>

      <%# FORMULARIO %>
      <%= form_with url: admin_bookings_path(@schedule), method: :post do |f| %>
        <div class="max-h-[40vh] overflow-y-auto pr-2 space-y-2 mb-8 custom-scrollbar">
          <% @available_users.each do |user| %>
            <% has_access = user.has_booking_access? %>
            <label class="flex items-center gap-4 p-4 rounded-3xl border border-slate-50 hover:bg-indigo-50 hover:border-indigo-100 cursor-pointer transition-all group relative <%= 'hidden opacity-60' unless has_access %>" 
                   data-search-list-target="item" 
                   data-has-access="<%= has_access %>"
                   data-search-name="<%= user.full_legal_name.downcase %> <%= user.nickname&.downcase %>">
              
              <%= f.radio_button :user_id, user.id, class: "peer absolute opacity-0", required: true %>
              
              <%# Avatar %>
              <div class="w-12 h-12 rounded-2xl bg-slate-100 group-hover:bg-white flex items-center justify-center font-black text-sm <%= has_access ? 'text-indigo-600' : 'text-slate-400' %> shadow-sm transition-colors">
                <%= user.first_name[0] %>
              </div>

              <div class="flex-1 min-w-0">
                <p class="text-sm font-black text-slate-900 uppercase italic leading-none truncate mb-1">
                   <%= user.nickname.presence || user.first_name %>
                </p>
                <p class="text-[9px] font-bold <%= has_access ? 'text-green-500' : 'text-red-400' %> uppercase tracking-tighter">
                  <%= has_access ? t('admin.class_schedules.add_student_modal.access_ok') : t('admin.class_schedules.add_student_modal.no_membership') %>
                </p>
              </div>

              <%# Radio visual decorado %>
              <div class="w-6 h-6 rounded-full border-2 border-slate-200 peer-checked:border-indigo-600 peer-checked:bg-indigo-600 flex items-center justify-center transition-all">
                <div class="w-2 h-2 rounded-full bg-white scale-0 peer-checked:scale-100 transition-transform"></div>
              </div>
            </label>
          <% end %>
        </div>

        <%= f.submit t('admin.class_schedules.add_student_modal.submit'), 
                     class: "w-full bg-slate-900 text-white py-5 rounded-[2rem] font-black text-[11px] uppercase tracking-[0.2em] shadow-2xl shadow-slate-200 active:scale-95 transition-all" %>
      <% end %>
    </div>
  </div>
</div>