<% is_mine = message.user == current_user %>
<div class="flex <%= is_mine ? 'justify-end' : 'justify-start' %> mb-4">
  <div class="max-w-[70%] flex flex-col <%= is_mine ? 'items-end' : 'items-start' %>">
    <% unless is_mine %>
      <span class="text-[10px] font-bold text-slate-400 ml-2 mb-1 uppercase tracking-widest"><%= message.user.display_name %></span>
    <% end %>
    
    <div class="px-4 py-2.5 rounded-2xl <%= is_mine ? 'bg-indigo-600 text-white rounded-tr-sm' : 'bg-slate-100 text-slate-800 rounded-tl-sm' %> shadow-sm relative">
      <% if message.content.present? %>
        <p class="text-sm"><%= message.content %></p>
      <% end %>

      <% if message.attachments.attached? %>
        <div class="mt-2 space-y-2">
          <% message.attachments.each do |attachment| %>
            <% if attachment.image? %>
              <%= image_tag attachment, class: "rounded-xl max-w-full h-auto object-cover max-h-64" %>
            <% else %>
              <%= link_to url_for(attachment), target: "_blank", class: "flex items-center gap-2 p-2 bg-black/5 rounded-lg hover:bg-black/10 transition text-xs font-medium" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                <%= attachment.filename.to_s %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <span class="text-[10px] text-slate-400 mt-1 mx-2"><%= message.created_at.in_time_zone.strftime(t("time.formats.time_only")) %></span>
  </div>
</div>
