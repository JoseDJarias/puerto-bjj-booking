<%# 1. ACTUALIZACIÓN DE ESTADÍSTICAS (SIEMPRE ARRIBA) %>
<%= turbo_stream.replace "user_stats_container" do %>
  <div id="user_stats_container" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Total</p>
      <p class="text-2xl font-black text-slate-900"><%= @stats.total %></p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-yellow-500">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Pendientes</p>
      <p class="text-2xl font-black text-yellow-600"><%= @stats.pending %></p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-green-500">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Aprobados</p>
      <p class="text-2xl font-black text-green-600"><%= @stats.approved %></p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-slate-400">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Inactivos</p>
      <p class="text-2xl font-black text-slate-500"><%= @stats.inactive %></p>
    </div>
  </div>
<% end %>

<% if params[:page].to_i > 1 %>
  <%# 1. ESCENARIO DE PAGINACIÓN: Solo añadimos los nuevos al final de la tabla %>
  <%= turbo_stream.append "users_table_body" do %>
    <%= render partial: "admin/users/partials/user", collection: @users, as: :user %>
  <% end %>

  <%# 2. Actualizamos el botón de "Cargar más" para que apunte a la página siguiente %>
  <%= turbo_stream.replace "load_more_container" do %>
    <% if @pagy.next %>
      <tbody id="load_more_container">
        <tr>
          <td colspan="5" class="p-6 text-center bg-slate-50/50 border-t border-slate-100">
            <%= link_to "Cargar más", admin_users_path(page: @pagy.next, query: params[:query], filter: params[:filter], package_id: params[:package_id]), data: { turbo_stream: true }, class: "inline-flex items-center rounded-full bg-white px-8 py-2.5 text-sm font-black text-indigo-600 shadow-sm ring-1 ring-indigo-100 hover:bg-indigo-600 hover:text-white transition-all" %>
          </td>
        </tr>
      </tbody>
    <% else %>
     <tbody id="load_more_container"></tbody> <%# Se elimina el botón si no hay más páginas %>
    <% end %>
  <% end %>

<% else %>
  <%# 3. ESCENARIO DE FILTRO/BÚSQUEDA: Lo que ya tenías (reemplaza todo) %>
  <%= turbo_stream.replace "users_list" do %>
    <%= turbo_frame_tag "users_list", target: "_top" do %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-full divide-y divide-slate-200 table-fixed sm:table-auto" style="min-width: 640px;">
          <thead class="bg-slate-50 text-left">
            <tr>
              <th scope="col" class="sticky left-0 z-10 w-[200px] lg:w-[30%] bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-wider text-slate-500 shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
                <%= t('activerecord.models.user') %>
              </th>
              <th scope="col" class="px-4 py-3 text-xs font-bold uppercase text-slate-500"><%= t('activerecord.attributes.user.role') %></th>
              <th scope="col" class="px-4 py-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Aprobación</th>
              <th scope="col" class="px-4 py-3 text-xs font-bold uppercase text-slate-500">Estado</th>
              <th scope="col" class="px-6 py-4 text-center text-xs font-bold uppercase tracking-wider text-slate-500">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody id="users_table_body" class="divide-y divide-slate-200 bg-white">
            <% if @users.any? %>
              <%= render partial: "admin/users/partials/user", collection: @users, as: :user %>
            <% else %>
              <tr>
                <td colspan="5" class="py-24 text-center bg-slate-50/30">
                  <div class="flex flex-col items-center justify-center space-y-3">
                    <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-black text-slate-900 uppercase italic italic tracking-tight">
                        Sin coincidencias para "<%= params[:query] %>"
                      </h3>
                      <p class="text-[10px] text-slate-500 uppercase font-bold tracking-widest mt-1">
                        Verifica que el nombre o ID sean correctos
                      </p>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
          <% if @pagy.next %>
            <tbody id="load_more_container">
              <tr>
                <td colspan="5" class="p-6 text-center bg-slate-50/50 border-t border-slate-100">
                  <%= link_to "Cargar más", admin_users_path(page: @pagy.next, query: params[:query], filter: params[:filter], package_id: params[:package_id]), data: { turbo_stream: true }, class: "inline-flex items-center rounded-full bg-white px-8 py-2.5 text-sm font-black text-indigo-600 shadow-sm ring-1 ring-indigo-100 hover:bg-indigo-600 hover:text-white transition-all" %>
                </td>
              </tr>
            </tbody>
          <% end %>
        </table>
      </div>
    <% end %>
  <% end %>

   <%= turbo_stream.update "flash" do %>
        <%= render partial: "layouts/flash", locals: { type: :notice, message: t('admin.users.flash.updated') } %>
      <% end %>
<% end %>