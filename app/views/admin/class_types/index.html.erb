<% content_for :page_title, t('admin.class_types.index.title') %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.class_types.index.title') %></h2>
  <%= link_to t('admin.class_types.index.new'), new_admin_class_type_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 shadow-sm transition-all hover:shadow-md" %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="sticky left-0 z-10 bg-slate-50 px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
            <%= t('activerecord.attributes.class_type.name') %>
          </th>
          
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('activerecord.attributes.class_type.description') %>
          </th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('admin.common.active') %>
          </th>
          <th scope="col" class="relative px-4 py-3 whitespace-nowrap">
            <span class="sr-only"><%= t('admin.common.actions') %></span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @class_types.each do |class_type| %>
          <tr class="group hover:bg-slate-50 transition-colors">
            
            <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 px-4 py-3 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)] text-sm font-medium text-slate-900">
              <%= class_type.name %>
            </td>

            <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap max-w-xs truncate" title="<%= class_type.description %>">
              <%= class_type.description %>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm">
              <% if class_type.active? %>
                <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                  <%= t('admin.common.yes') %>
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">
                  <%= t('admin.common.no') %>
                </span>
              <% end %>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <%= link_to t('admin.common.edit'), edit_admin_class_type_path(class_type), class: "font-medium text-indigo-600 hover:text-indigo-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>