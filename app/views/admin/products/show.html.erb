<% content_for :page_title, "#{@product.name} | Admin" %>

<% image_urls = @product.images.attached? ? @product.images.map { |img| url_for(img) } : [] %>

<div class="max-w-5xl mx-auto space-y-6"
     data-controller="product-gallery"
     data-product-gallery-images-value="<%= image_urls.to_json %>">
  
  <%# Breadcrumb & Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to admin_products_path, class: "inline-flex items-center gap-1.5 text-xs font-black text-slate-400 hover:text-slate-600 uppercase tracking-widest mb-2" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        Volver a Catálogo Admin
      <% end %>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= @product.name %></h1>
        <% if @product.active? %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black bg-green-50 text-green-700 uppercase tracking-wider">
            <%= t('admin.products.index.status.active') %>
          </span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black bg-slate-100 text-slate-500 uppercase tracking-wider">
            <%= t('admin.products.index.status.inactive') %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to edit_admin_product_path(@product), class: "inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-xs font-black uppercase tracking-wider shadow-md shadow-indigo-100 active:scale-95 transition-all" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
        <span>Editar</span>
      <% end %>

      <%= button_to admin_product_path(@product), method: :delete, data: { turbo_confirm: "¿Estás seguro de eliminar este producto del catálogo?" }, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-red-50 hover:bg-red-100 text-red-700 rounded-2xl text-xs font-black uppercase tracking-wider transition-all cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        <span>Eliminar</span>
      <% end %>
    </div>
  </div>

  <%# Content Grid %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
    
    <%# Left Column: Image Gallery & Lightbox Preview %>
    <div class="space-y-3">
      <div class="relative w-full aspect-square bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm flex items-center justify-center p-2 group">
        <% if @product.images.attached? %>
          <%# Swipeable Scroll Container %>
          <div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide w-full h-full rounded-2xl overscroll-x-contain"
               data-product-gallery-target="container"
               data-action="scroll->product-gallery#onScroll">
            <% @product.images.each_with_index do |img, idx| %>
              <div class="snap-center shrink-0 w-full h-full flex items-center justify-center bg-slate-50 cursor-zoom-in"
                   data-action="click->product-gallery#openLightbox"
                   data-index="<%= idx %>">
                <%= image_tag img, class: "w-full h-full object-cover rounded-2xl pointer-events-none select-none" %>
              </div>
            <% end %>
          </div>

          <%# Floating Counter Badge & Expand Icon %>
          <div class="absolute top-4 right-4 flex items-center gap-2 z-10">
            <% if @product.images.count > 1 %>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-slate-900/80 text-white backdrop-blur-md shadow-sm"
                    data-product-gallery-target="counter">
                1 / <%= @product.images.count %>
              </span>
            <% end %>
            <button type="button"
                    data-action="click->product-gallery#openLightbox"
                    class="p-2 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white backdrop-blur-md shadow-sm transition-transform active:scale-90 cursor-pointer"
                    title="Ampliar foto">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
            </button>
          </div>

          <%# Navigation Arrows %>
          <% if @product.images.count > 1 %>
            <button type="button"
                    data-action="click->product-gallery#prevSlide"
                    class="hidden sm:flex absolute left-4 top-1/2 -translate-y-1/2 w-9 h-9 items-center justify-center rounded-full bg-white/90 hover:bg-white text-slate-800 shadow-md backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100 active:scale-90 cursor-pointer z-10">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <button type="button"
                    data-action="click->product-gallery#nextSlide"
                    class="hidden sm:flex absolute right-4 top-1/2 -translate-y-1/2 w-9 h-9 items-center justify-center rounded-full bg-white/90 hover:bg-white text-slate-800 shadow-md backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100 active:scale-90 cursor-pointer z-10">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
          <% end %>

          <%# Floating Dots Indicator %>
          <% if @product.images.count > 1 %>
            <div class="absolute bottom-4 inset-x-0 flex justify-center gap-1.5 z-10 pointer-events-none">
              <% @product.images.each_with_index do |_, idx| %>
                <span class="h-1.5 rounded-full transition-all duration-300 shadow-sm <%= idx.zero? ? 'bg-white w-5' : 'bg-white/50 w-2' %>"
                      data-product-gallery-target="dot"></span>
              <% end %>
            </div>
          <% end %>

        <% else %>
          <div class="text-slate-300 flex flex-col items-center justify-center">
            <svg class="w-20 h-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
        <% end %>
      </div>

      <%# Thumbnail Strip %>
      <% if @product.images.attached? && @product.images.count > 1 %>
        <div class="flex gap-2.5 overflow-x-auto pb-2 scrollbar-hide pt-1">
          <% @product.images.each_with_index do |img, idx| %>
            <button type="button"
                    data-action="click->product-gallery#goToSlide"
                    data-index="<%= idx %>"
                    data-product-gallery-target="thumbnail"
                    class="w-16 h-16 rounded-2xl overflow-hidden border border-slate-200 shrink-0 bg-slate-50 transition-all duration-200 cursor-pointer <%= idx.zero? ? 'ring-2 ring-indigo-600 scale-105' : 'opacity-70 hover:opacity-100' %>">
              <%= image_tag img, class: "w-full h-full object-cover" %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Right Column: Details & Orders Stats %>
    <div class="space-y-5">
      <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-4">
        <% if @product.category.present? %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black bg-indigo-50 text-indigo-700 uppercase tracking-wider">
            <%= @product.category %>
          </span>
        <% end %>

        <div class="grid grid-cols-2 gap-4 p-4 bg-slate-50 rounded-2xl">
          <div>
            <p class="text-xs font-bold text-slate-400 uppercase">Precio Total</p>
            <p class="text-2xl font-black text-slate-900">₡<%= number_with_delimiter(@product.price.to_i) %></p>
          </div>
          <div>
            <p class="text-xs font-bold text-indigo-600 uppercase">Anticipo (<%= @product.deposit_percentage %>%)</p>
            <p class="text-2xl font-black text-indigo-600">₡<%= number_with_delimiter(@product.deposit_amount.to_i) %></p>
          </div>
        </div>

        <% if @product.description.present? %>
          <div class="space-y-1 pt-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Descripción</h3>
            <p class="text-sm text-slate-600 leading-relaxed"><%= @product.description %></p>
          </div>
        <% end %>

        <% if @product.notes.present? %>
          <div class="space-y-1 pt-2 border-t border-slate-100">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Notas de Entrega</h3>
            <p class="text-xs text-slate-500 leading-relaxed"><%= @product.notes %></p>
          </div>
        <% end %>
      </div>

      <%# Orders Summary Card %>
      <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-3">
        <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Pedidos de este producto</h3>
        
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 bg-slate-50 rounded-2xl">
            <span class="text-[10px] text-slate-400 font-bold uppercase">Total Solicitudes</span>
            <p class="text-xl font-black text-slate-900"><%= @product.product_orders.count %></p>
          </div>
          <div class="p-3 bg-indigo-50 rounded-2xl">
            <span class="text-[10px] text-indigo-600 font-bold uppercase">Entregados</span>
            <p class="text-xl font-black text-indigo-700"><%= @product.product_orders.delivered.count %></p>
          </div>
        </div>

        <div class="pt-2">
          <%= link_to admin_product_orders_path, class: "w-full flex items-center justify-center gap-2 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-2xl text-xs font-black uppercase tracking-wider transition-all" do %>
            <span>Ver Todos los Pedidos</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Fullscreen Lightbox Modal %>
  <div class="fixed inset-0 z-[200] bg-slate-950/95 backdrop-blur-xl hidden items-center justify-center p-4 sm:p-6"
       data-product-gallery-target="modal"
       data-action="click->product-gallery#closeLightbox">
    
    <%# Top Controls Bar %>
    <div class="absolute top-4 inset-x-4 sm:inset-x-6 flex items-center justify-between z-20 pointer-events-none">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-black bg-white/10 text-white backdrop-blur-md"
            data-product-gallery-target="modalCounter">
        1 / <%= @product.images.count %>
      </span>

      <button type="button"
              data-action="click->product-gallery#closeLightbox"
              data-close-lightbox="true"
              class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white backdrop-blur-md transition-all cursor-pointer pointer-events-auto active:scale-90"
              title="Cerrar (Esc)">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <%# Main Lightbox Image %>
    <div class="relative max-w-5xl max-h-[85vh] w-full h-full flex items-center justify-center pointer-events-auto"
         data-action="click->event#stopPropagation">
      <img src=""
           alt="<%= @product.name %>"
           class="max-w-full max-h-[85vh] w-auto h-auto object-contain rounded-2xl shadow-2xl select-none"
           data-product-gallery-target="modalImage">

      <%# Modal Navigation Arrows %>
      <% if @product.images.count > 1 %>
        <button type="button"
                data-action="click->product-gallery#prevLightbox"
                class="absolute left-2 sm:-left-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/15 hover:bg-white/30 text-white backdrop-blur-md shadow-lg transition-all active:scale-90 cursor-pointer">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>

        <button type="button"
                data-action="click->product-gallery#nextLightbox"
                class="absolute right-2 sm:-right-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/15 hover:bg-white/30 text-white backdrop-blur-md shadow-lg transition-all active:scale-90 cursor-pointer">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      <% end %>
    </div>
  </div>
</div>
