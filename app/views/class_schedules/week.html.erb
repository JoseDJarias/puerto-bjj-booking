<% content_for :page_title, t('class_schedules.week.title') %>
<%= turbo_frame_tag "modal_detail" %>

<div class="min-h-0">
  <header class="mb-12 flex flex-col items-center">
    <div class="flex flex-col items-center gap-2 mb-6">
      <div class="inline-flex items-center gap-3 px-5 py-1.5 bg-slate-100 rounded-full border border-slate-200">
        <p class="text-[11px] font-black tracking-[0.2em] text-slate-500 uppercase">
          <%= l(@week_start, format: "%d %b") %> 
          <span class="mx-2 text-slate-300">/</span> 
          <%= l(@week_end, format: "%d %b") %>
        </p>
      </div>
      
      <% unless @week_start == Date.current.beginning_of_week(:monday) %>
        <span class="text-[10px] font-bold text-indigo-500 uppercase tracking-tighter animate-in fade-in slide-in-from-top-1">
          <%= @week_start < Date.current ? "Viendo semanas pasadas" : "Explorando próximas semanas" %>
        </span>
      <% end %>
    </div>

    <nav class="flex items-center gap-2 bg-white p-1.5 rounded-2xl shadow-sm border border-slate-200">
      <%= link_to week_class_schedules_path(week: @week_start - 7.days), 
          title: "Semana Anterior",
          class: "p-3 rounded-xl text-slate-400 hover:bg-slate-50 hover:text-indigo-600 transition-all" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      <% end %>

      <% is_current_week = (@week_start == Date.current.beginning_of_week(:monday)) %>
      <%= link_to week_class_schedules_path(week: Date.current.beginning_of_week(:monday)), 
          class: "px-6 py-2.5 rounded-xl text-[10px] font-black tracking-widest transition-all duration-300 border #{is_current_week ? 'bg-indigo-50 text-indigo-600 border-indigo-100' : 'bg-slate-50 text-slate-500 border-slate-100 hover:bg-indigo-600 hover:text-white'}" do %>
        <%= is_current_week ? "SEMANA ACTUAL" : "VOLVER AHORA" %>
      <% end %>

      <%= link_to week_class_schedules_path(week: @week_start + 7.days), 
          title: "Siguiente Semana",
          class: "p-3 rounded-xl text-slate-400 hover:bg-slate-50 hover:text-indigo-600 transition-all" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <% end %>
    </nav>
  </header>


  <%# Mobile: scroll vertical %>
  <div class="md:hidden space-y-8">
    <% @days.each do |day| %> <%# <--- ¡ESTE BUCLE ES VITAL! %>
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-slate-100 border-b border-slate-200 px-5 py-4">
          <span class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1"><%= t('date.abbr_day_names')[day.wday] %></span>
          <p class="text-2xl font-bold text-slate-900"> <%= l(day, format: :short) %></p>
        </div>
        <div class="p-5 space-y-4">
          <% ( @schedules_by_date[day] || [] ).each do |schedule| %>
            <%= render "class_schedules/partials/calendar_card", schedule: schedule, user: @user %>
          <% end %>
          <% if ( @schedules_by_date[day] || [] ).empty? %>
            <p class="text-sm text-slate-400 py-3"><%= t('class_schedules.week.no_classes') %></p>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <%# Desktop: scroll horizontal %>
  <div class="hidden md:block overflow-x-auto pb-4 -mx-1 px-1">
    <div class="flex gap-6 min-w-max">
      <% @days.each do |day| %> <%# <--- ¡Y ESTE TAMBIÉN! %>
        <div class="w-56 flex-shrink-0 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
          <div class="bg-slate-100 border-b border-slate-200 px-4 py-5 text-center flex-shrink-0">
            <span class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1"><%= t('date.abbr_day_names')[day.wday] %></span>
            <p class="text-2xl font-bold text-slate-900 leading-tight text-center w-full"><%= day.day %></p>
            <p class="text-sm text-slate-500 mt-1"><%= l(day, format: :short) %></p>
          </div>
          <div class="p-4 space-y-4 flex-1 min-h-[140px]">
            <% ( @schedules_by_date[day] || [] ).each do |schedule| %>
            <%= turbo_stream_from "schedule_#{schedule.id}" %>
            <%= turbo_stream_from [@user, "bookings"] %>
              <%= render "class_schedules/partials/calendar_card", schedule: schedule, user: @user %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>