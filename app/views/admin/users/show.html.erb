<% content_for :page_title, t('admin.users.show.title') %>

<div class="mb-6">
  <%= link_to admin_users_path, class: "text-sm text-slate-500 hover:text-slate-700 flex items-center gap-1 mb-4" do %>
    <span>←</span> <%= t('admin.users.show.back') %>
  <% end %>

  <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
    <div class="flex items-center gap-4">
      <div class="h-16 w-16 rounded-full bg-slate-200 flex items-center justify-center text-2xl font-bold text-slate-600 uppercase">
        <%= @user.first_name&.first || @user.email_address.first %>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= @user.first_name %> <%= @user.last_name %></h1>
        <p class="text-slate-500"><%= @user.email_address %></p>
        <div class="mt-1 flex gap-2">
           <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-600/10">
             <%= t("enums.user.role.#{@user.role}") %>
           </span>
           <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= @user.active? ? 'bg-green-50 text-green-700 ring-green-600/20' : 'bg-red-50 text-red-700 ring-red-600/10' %>">
             <%= t("enums.user.status.#{@user.status}") %>
           </span>
        </div>
      </div>
    </div>
    
    <%= link_to t('admin.common.edit'), edit_admin_user_path(@user), class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
</div>

<hr class="my-8 border-slate-200">

<div>
  <div class="flex justify-between items-center mb-6">
    <h3 class="text-lg font-semibold text-slate-900"><%= t('admin.users.show.memberships_title') %></h3>
    
    <%= link_to new_admin_membership_path(user_id: @user.id), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <%= t('admin.users.show.new_membership') %>
    <% end %>
  </div>

  <% if @memberships.any? %>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600"><%= t('activerecord.attributes.membership.membership_plan') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600"><%= t('activerecord.attributes.membership.status') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600">Vigencia</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600">Monto</th>
            <th class="relative px-4 py-3"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @memberships.each do |membership| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3">
                <div class="text-sm font-medium text-slate-900"><%= membership.membership_plan.name %></div>
                <div class="text-xs text-slate-500"><%= membership.membership_package.name %></div>
              </td>
              
              <td class="px-4 py-3 text-sm">
                 <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium 
                  <%= membership.active? ? 'bg-green-100 text-green-800' : (membership.expired? ? 'bg-orange-100 text-orange-800' : 'bg-slate-100 text-slate-800') %>">
                  <%= t("enums.membership.status.#{membership.status}") %>
                </span>
              </td>
              
              <td class="px-4 py-3 text-sm text-slate-600">
                <div class="flex flex-col">
                  <span><%= l(membership.start_date, format: :short) %> - <%= l(membership.end_date, format: :short) %></span>
                  <% if membership.active? %>
                     <span class="text-xs text-indigo-600 font-medium"><%= membership.days_remaining %> días restantes</span>
                  <% end %>
                </div>
              </td>

              <td class="px-4 py-3 text-sm font-medium text-slate-900">
                <%= number_to_currency(membership.amount_paid) %>
              </td>

              <td class="px-4 py-3 text-right text-sm font-medium">
                <%= link_to t('admin.common.edit'), edit_admin_membership_path(membership), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
      <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-slate-900">Sin historial</h3>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.users.show.no_memberships') %></p>
    </div>
  <% end %>
</div>