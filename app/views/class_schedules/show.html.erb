<%# app/views/class_schedules/show.html.erb %>

<%= turbo_frame_tag "modal_detail" do %>

  <%= turbo_stream_from "schedule_#{@schedule.id}" %>
  <%= turbo_stream_from [current_user, "bookings"] %>

  <div class="fixed inset-0 z-[100] bg-slate-900/40 backdrop-blur-sm transition-opacity animate-in fade-in duration-300" 
    onclick="const frame = this.closest('turbo-frame'); frame.src = ''; frame.innerHTML = '';">    
    <div class="fixed inset-y-0 right-0 w-full h-full max-w-lg bg-white shadow-2xl flex flex-col animate-in slide-in-from-right duration-500 ease-out" 
         onclick="event.stopPropagation();">
      
      <div class="sticky top-0 z-10 bg-white/80 backdrop-blur-md px-6 py-5 border-b border-slate-100 flex items-center gap-4">
       <div class="flex items-center gap-3">
        <button type="button" 
          onclick="const frame = this.closest('turbo-frame'); frame.src = ''; frame.innerHTML = '';" 
          class="group p-2 -ml-2 rounded-full hover:bg-slate-50 transition-all cursor-pointer">
          <svg class="w-6 h-6 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <h2 class="text-lg font-black text-slate-800 uppercase tracking-tight">Detalle</h2>
       </div>
      </div>
        
      <div class="flex-1 overflow-y-auto p-8 pb-32 space-y-10 custom-scrollbar">
        <div class="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-150 fill-mode-both">
          <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black bg-indigo-50 text-indigo-700 uppercase tracking-widest border border-indigo-100">
              <%= @schedule.class_type.name %>
            </span>
          </div>
          <%# Title: Time and Date %>
          <div class="space-y-1"> <%# Reducimos el space-y del padre para controlar el margen manualmente %>
            
            <%# Time container: gap-2 to separate PM and mb-1 to separate from the date %>
            <div class="flex items-baseline gap-2 mb-1">
              <h1 class="text-4xl font-black text-slate-900 tracking-tight leading-none">
                <%= l(@schedule.starts_at, format: "%-I:%M") %>
              </h1>
              <span class="text-lg font-bold text-slate-400 uppercase leading-none"><%= l(@schedule.starts_at, format: "%P") %></span>
            </div>
            
            <%# Date with more open tracking for readability %>
            <p class="text-sm font-black text-slate-500 uppercase tracking-tight opacity-90">
              <%= l(@schedule.starts_at, format: "%A %d de %B") %>
            </p>
          </div>

          <%# Class topic improved %>
          <% if @schedule.topic.present? %>
            <div class="bg-amber-50/50 border-l-4 border-amber-400 p-4 rounded-r-2xl">
              <p class="text-[9px] font-black text-amber-600 uppercase tracking-widest mb-1">Enfoque de hoy</p>
              <p class="text-base font-bold text-amber-900 leading-tight">🎯 <%= @schedule.topic %></p>
            </div>
          <% end %>
        </div>
        <div class="grid grid-cols-2 gap-4 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-200 fill-mode-both">
          
          <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100 flex flex-col items-center justify-center text-center">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-3">Profesor</span>
            <div class="space-y-1">
              <p class="text-base font-black text-slate-800 leading-none"><%= @schedule.displayed_instructor_name %></p>
              <p class="text-[10px] text-slate-500 font-bold uppercase tracking-tighter">
                <%= @schedule.special_guest? ? "Invitado Especial" : "Instructor Principal" %>
              </p>
            </div>
          </div>

          <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100 flex flex-col items-center justify-center text-center">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-3">Disponibilidad</span>
            <div id="spots_schedule_<%= @schedule.id %>" class="flex justify-center w-full">
              <%= render "class_schedules/partials/spots", schedule: @schedule %>
            </div>
          </div>

        </div>

        <div class="space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-150 fill-mode-both">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-black text-slate-800 uppercase tracking-tight">Participantes</h3>
            <span id="user_enrolled_count_<%= @schedule.id %>" class="bg-slate-100 text-slate-500 text-[10px] font-black px-2 py-0.5 rounded-full">
              <%= @schedule.active_bookings_count %> Inscritos
            </span>
          </div>
          <div id="participants_container_<%= @schedule.id %>">
            <%= render "class_schedules/partials/participants_list", schedule: @schedule %>
          </div>
        </div>
      </div>

      <div class="shrink-0 inset-x-0 p-6 z-20">
        <div class="absolute inset-x-0 -top-12 h-12 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
        
        <div class="bg-white/80 backdrop-blur-xl p-4 rounded-3xl border border-slate-200 shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] transition-all duration-500 animate-in slide-in-from-bottom-8 fill-mode-both">
          <div id="action_button_schedule_<%= @schedule.id %>">
            <%= render "class_schedules/partials/action_button", schedule: @schedule, user: current_user %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>