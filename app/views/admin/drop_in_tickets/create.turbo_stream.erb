<%# Reemplaza la tabla completa con el nuevo ticket ya incluido %>
<%= turbo_stream.replace "drop_in_management_#{@user.id}" do %>
  <%= render "admin/users/drop_in_management", user: @user %>
<% end %>

<%# Notificación visual para el Admin %>
<%= turbo_stream.prepend "flash" do %>
  <div class="fixed top-4 right-4 z-50 animate-in slide-in-from-top duration-300" data-controller="autohide">
    <div class="bg-slate-900 text-white px-6 py-3 rounded-2xl shadow-2xl font-black text-xs tracking-widest flex items-center gap-3">
      <div class="h-2 w-2 rounded-full bg-green-400 animate-pulse"></div>
      TICKET REGISTRADO Y DISPONIBLE
    </div>
  </div>
<% end %>