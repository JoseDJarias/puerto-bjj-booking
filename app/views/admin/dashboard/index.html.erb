<%# app/views/admin/dashboard/index.html.erb %>
<header class="mb-10 px-1 pt-4">
  <div class="flex items-center gap-3 mb-6">
    <div class="px-4 py-1.5 bg-slate-900 rounded-full shadow-lg shadow-slate-200 flex items-center gap-2 border border-slate-800">
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span class="text-[11px] font-black text-white uppercase tracking-[0.2em]">
        <%= current_user.admin? ? t('admin.dashboard.index.badge_command_center') : t('admin.dashboard.index.badge_instructor') %>
      </span>
    </div>
  </div>
  
  <h1 class="text-6xl font-black text-slate-900 italic uppercase tracking-tighter leading-[0.85] mb-8">
    <%= t('admin.dashboard.index.greeting') %> <br>
    <span class="text-indigo-600"><%= current_user.first_name %>!</span>
  </h1>
  
  <div class="flex items-center gap-6 text-slate-400">
    <div class="flex items-center gap-2.5">
      <div class="bg-indigo-50 p-2 rounded-xl text-indigo-600 border border-indigo-100/50">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9 3.75h.008v.008H12v-.008Z" />
        </svg>
      </div>
      <span class="text-xs font-black uppercase tracking-widest text-slate-900">
        <%="FECHA #{l(@date, format: "%d %b")}"%>
      </span>
    </div>

    <div class="h-4 w-px bg-slate-200"></div>

    <div class="flex items-center gap-2.5">
      <div class="bg-slate-50 p-2 rounded-xl text-slate-400 border border-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
      </div>
      <span class="text-xs font-black uppercase tracking-widest text-slate-400">
        <%= t('admin.dashboard.index.sessions_count', count: @schedules.size) %>
      </span>
    </div>
  </div>
</header>

<div class="w-full mt-4 px-1">
  <div class="flex justify-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-tighter bg-slate-50/50 p-2 rounded-lg border border-slate-100/50">
    <span> Mueve las flechas para cambiar de dia</span>
  </div>
</div>

<%= turbo_frame_tag "dashboard_sessions" do %>
  <div class="mb-8 px-3">
    <div class="flex items-center gap-2 bg-white p-1.5 rounded-2xl border border-slate-100 shadow-sm w-full">

      <%= link_to admin_dashboard_path(offset: @offset - 1), 
                  class: "flex items-center justify-center gap-2 min-w-[80px] px-3 py-2.5 hover:bg-slate-50 rounded-xl transition-all text-slate-400 hover:text-indigo-600 group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0">
          <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
        </svg>
        <span class="text-[10px] font-black uppercase tracking-tighter">
          <%= (@date - 1.day).strftime("%d/%m") %>
        </span>
      <% end %>

      <div class="flex-1 flex justify-center">
        <% if @offset != 0 %>
          <%= link_to admin_dashboard_path(offset: 0), 
                      class: "w-fit flex items-center justify-center px-4 py-2.5 bg-slate-900 rounded-xl text-[10px] font-black text-white uppercase tracking-widest shadow-lg shadow-slate-200 active:scale-95 transition-all" do %>
            <span class="block w-full text-center font-black uppercase tracking-tighter">
              <%= t('admin.dashboard.index.go_to_today') %>
            </span>
          <% end %>
        <% else %>
          <div class="h-1 w-8 bg-slate-100 rounded-full"></div>
        <% end %>
      </div>

      <%= link_to admin_dashboard_path(offset: @offset + 1), 
                  class: "flex items-center justify-center gap-2 min-w-[80px] px-3 py-2.5 hover:bg-slate-50 rounded-xl transition-all text-slate-400 hover:text-indigo-600 group text-right" do %>
        <span class="text-[10px] font-black uppercase tracking-tighter">
          <%= (@date + 1.day).strftime("%d/%m") %>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0">
          <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </div>
  </div>

  <div class="w-full mt-4 px-1 pb-4">
    <div class="flex text-center gap-2 text-[11px] font-bold text-slate-400 uppercase tracking-tighter bg-slate-50/50 p-2 rounded-lg border border-slate-100/50">
      <span>¡A partir de las 9:00 pm, se mostrará la lista de clases del día siguiente!</span>
    </div>
  </div>

  <div class="xl:col-span-4 space-y-6">
    <div class="space-y-3">
      <% if @schedules.any? %>
        <% @schedules.each do |schedule| %>
          <div class="bg-white rounded-2xl border border-slate-100 p-4 shadow-sm hover:border-indigo-200 transition-all group relative">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="text-center">
                  <span class="block text-sm font-black text-slate-900"><%= schedule.starts_at.strftime("%-I:%M") %></span>
                  <span class="block text-[10px] font-bold text-slate-400 uppercase"><%= schedule.starts_at.strftime("%p") %></span>
                </div>
                <div>
                  <h4 class="font-black text-slate-900 uppercase italic text-sm"><%= schedule.class_type.name %></h4>
                  <p class="text-[10px] font-bold text-slate-400 uppercase"><%= t('admin.dashboard.index.instructor_prefix') %> <%= schedule.instructor&.first_name || t('admin.dashboard.index.no_instructor') %></p>
                </div>
              </div>

              <%# Accesos Rápidos %>
              <div class="flex gap-3">
                <%= link_to attendance_admin_class_schedule_path(schedule),
                data: { turbo_frame: "_top" },
                 class: "p-2 rounded-lg bg-slate-900 text-white hover:bg-indigo-600 transition-colors", title: t('admin.dashboard.index.take_attendance') do %>
                   <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
                <% end %>
                
                <%# Este botón abrirá el SHOW (que podemos meter en modal luego) %>
                <%= link_to admin_class_schedule_path(schedule),
                 data: { turbo_frame: "_top" },
                 class: "p-2 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors" do %>
                   <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-400 italic bg-slate-50 p-4 rounded-2xl border border-dashed border-slate-200 text-center"><%= t('admin.dashboard.index.no_classes') %></p>
      <% end %>
    </div>
  </div>
<% end %>