<%# app/views/class_schedules/_class_card_universal.html.erb %>

<%# This ID allows the model to replace the entire card if necessary %>
<%= turbo_frame_tag "universal_card_#{schedule.id}" do %>
  <%
    card_state_classes = if schedule.cancelled?
    "bg-slate-50 border-slate-200 opacity-80"
    elsif schedule.past_grace_period?
      "opacity-60 grayscale bg-slate-50"
    else
      "bg-white hover:shadow-xl hover:border-indigo-100"
    end
  %>
  <div class="relative group rounded-2xl shadow-sm border border-slate-200/60 p-6 transition-all duration-300 flex flex-col justify-between <%= card_state_classes %>">
    <% if schedule.cancelled? %>
      <div class="absolute top-4 left-4 z-20">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] sm:text-[10px] font-black bg-red-600 text-white uppercase tracking-tighter sm:tracking-widest shadow-lg shadow-red-200 ring-1 ring-red-700">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-100 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
          </span>
          Clase Cancelada
        </span>
      </div>
    <% end %>

    <%= link_to class_schedule_path(schedule),
              data: { turbo_frame: "modal_detail" },
              class: "p-6 pb-0 block group/card" do %>
      <div class="space-y-5">
        <div class="flex justify-between items-start">
          <div class="flex flex-col">
            <% if schedule.topic.present? %>
              <div class="mb-1">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-black bg-amber-50 text-amber-700 border border-amber-100 uppercase tracking-wider">
                  🎯 <%= schedule.topic %>
                </span>
              </div>
            <% end %>

            <div class="mb-2 flex flex-col items-start gap-1.5">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 uppercase tracking-wider">
                <%= schedule.class_type.name %>
              </span>
              <div class="mx-2">
                <%= modality_badge(schedule) %>
              </div>
            </div>

            <h3 class="text-3xl font-black text-slate-900 leading-tight tracking-tight">
              <%= l(schedule.starts_at, format: "%l:%M %P") %>
            </h3>
          </div>

          <div id="spots_schedule_<%= schedule.id %>" class="shrink-0">
            <%= render "class_schedules/partials/spots", schedule: schedule %>
          </div>
        </div>

        <div class="space-y-3">
          <% if context == :dashboard %>
            <div class="flex items-center text-indigo-600 text-sm font-bold">
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <%= l(schedule.starts_at, format: "%A %d %b").capitalize %>
            </div>
          <% end %>

          <div class="flex items-center pt-2 border-t border-slate-50">
            <div class="h-9 w-9 rounded-full bg-slate-100 flex items-center justify-center mr-3 border border-slate-200 shadow-sm">
              <svg class="w-5 h-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <% instructor_label = schedule.special_guest? ? "Profesor / Invitado Especial" : "Profesor" %>
            <div class="flex flex-col">
              <span class="text-[9px] text-slate-400 uppercase font-black tracking-widest mb-0.5"> <%= instructor_label%> </span>
              <span class="text-sm font-bold text-slate-700 leading-none"><%= schedule.displayed_instructor_name %></span>
            </div>
          </div>
        </div>

          <%# --- Participants List --- %>
        <div class="pt-1">
          <details class="group/details">
            <summary class="list-none cursor-pointer">
              <div class="flex items-center justify-between py-2.5 px-4 rounded-xl bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-widest group-hover/details:bg-indigo-50 group-hover/details:text-indigo-600 transition-all border border-transparent group-hover/details:border-indigo-100">
                <span class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                  <%= t('class_schedules.index.view_participants') %>
                </span>
                <svg class="w-4 h-4 transition-transform group-open/details:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </summary>

            <div class="mt-3 px-1">
              <%# ID to update the Participants list in real time %>
              <div id="participants_container_<%= schedule.id %>">
                <%= turbo_frame_tag "frame_participants_#{schedule.id}", src: participants_class_schedule_path(schedule), loading: :lazy do %>
                  <div class="flex justify-center py-4 text-slate-300 italic text-xs animate-pulse">
                    Cargando lista...
                  </div>
                <% end %>
              </div>
            </div>
          </details>
        </div>
      </div>
    <% end %>

    <%# --- ACTION BUTTON (Book/Cancel/Lock) --- %>
    <div class="mt-6">
      <%# ID to update the user's action button in real time %>
      <div id="action_button_schedule_<%= schedule.id %>">
        <%= render "class_schedules/partials/action_button", schedule: schedule, user: user %>
      </div>
    </div>

  </div>
<% end %>