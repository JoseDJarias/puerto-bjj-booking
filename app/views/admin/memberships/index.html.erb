<% content_for :page_title, t("admin.memberships.index.title") %>

<div class="flex flex-col gap-6">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <%= link_to new_admin_membership_path, class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-all" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <%= t('admin.memberships.index.new') %>
    <% end %>
  </div>
  <%# Membership Stats %>
  <div class="flex items-center gap-2 ml-1">
    <div class="h-5 w-1 bg-indigo-600 rounded-full"></div> <%# Acento visual %>
    <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500">
      <%= t('admin.users.index.stats_overview', default: 'Resumen de Membresías') %>
    </h3>
  </div>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Total</p>
      <p class="text-2xl font-black text-slate-900"><%= @stats.total %></p>
    </div>
    
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-green-500">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Activas</p>
      <p class="text-2xl font-black text-green-600"><%= @stats.active %></p>
    </div>

    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-slate-400">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Vencidas</p>
      <p class="text-2xl font-black text-slate-500"><%= @stats.expired %></p>
    </div>
  </div>

    <%# Search and Package Filter Bar %>
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm sticky top-0 z-20 mb-8 overflow-hidden">
    <%= form_with url: admin_memberships_path(format: :turbo_stream), method: :get, data: { turbo_frame: "memberships_list", turbo_action: "advance" } do |f| %>
      <%= hidden_field_tag :filter, params[:filter] %>
      
      <div class="p-4 sm:p-6 lg:p-8 space-y-6">
        
        <%# 1. Search Bar%>
        <div class="group relative">
          <div class="px-4 pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400 group-focus-within:text-indigo-500 transition-colors">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <%= f.text_field :query, 
              placeholder: t("admin.memberships.index.search_placeholder"), 
              value: params[:query], 
              oninput: "this.form.requestSubmit()", 
              class: "block w-full rounded-2xl border-0 py-4 pl-12 pr-4 text-slate-700 bg-slate-50 ring-1 ring-inset ring-slate-200 focus:ring-2 focus:ring-indigo-600 focus:bg-white sm:text-lg shadow-inner transition-all placeholder:text-slate-400" %>
        </div>

        <%# 2. Program Filter %>
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2 border-t border-slate-100">
          
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 w-full sm:w-auto">
            <label class="text-[10px] font-bold uppercase tracking-widest text-slate-400 ml-1">
              Filtrar por Programa
            </label>
            
            <div class="relative w-full sm:w-72">
              <%= f.select :package_id, 
                  options_from_collection_for_select(MembershipPackage.active, :id, :name, params[:package_id]), 
                  { include_blank: "Todos los programas" }, 
                  { onchange: "this.form.requestSubmit()", 
                    class: "px-4 block w-full rounded-xl border-0 py-2.5 pl-4 pr-10 text-sm font-semibold text-slate-600 bg-white ring-1 ring-inset ring-slate-200 focus:ring-2 focus:ring-indigo-500 shadow-sm cursor-pointer appearance-none hover:ring-slate-300 transition-all" } %>
              
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <nav class="flex space-x-2 overflow-x-auto no-scrollbar pb-2" aria-label="<%= t('admin.memberships.index.tabs_aria') %>">
    <% [[nil, t("admin.memberships.index.filter_all")], ["active", t("admin.memberships.index.filter_active")], ["expired", t("admin.memberships.index.filter_expired")]].each do |val, label| %>
      <% active = params[:filter] == val %>
      <%= link_to admin_memberships_path(filter: val, query: params[:query], package_id: params[:package_id]), 
          class: "whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold transition-all #{active ? 'bg-indigo-600 text-white shadow-md' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50'}",
          data: { turbo_action: "advance" } do %>
        <div class="flex items-center gap-2">
          <% if val == "active" %><span class="h-2 w-2 rounded-full bg-green-400 <%= "animate-pulse" if active %>"></span><% end %>
          <%= label %>
        </div>
      <% end %>
    <% end %>
  </nav>

 <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500"><%= t("admin.memberships.index.user_column") %></th>
            <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500"><%= t("admin.memberships.index.table_plan") %></th>
            <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500"><%= t("admin.memberships.index.table_due") %></th>
            <th class="relative px-4 py-3"></th>
          </tr>
        </thead>

        <%# EL TRUCO: El frame es el tbody mismo para que no rompa el HTML %>
        <%= turbo_frame_tag "memberships_list", class: "contents" do %>
          <tbody id="memberships_table_body" class="divide-y divide-slate-200 bg-white">
            <%= render @memberships %>
          </tbody>

          <% if @pagy.next %>
            <tbody id="load_more_container">
              <tr>
                <td colspan="4" class="p-6 text-center bg-slate-50/50 border-t border-slate-100">
                  <%= link_to t("admin.memberships.index.load_more"), 
                      admin_memberships_path(page: @pagy.next, query: params[:query], filter: params[:filter]), 
                      data: { turbo_stream: true }, 
                      class: "inline-flex items-center rounded-full bg-white px-8 py-2.5 text-sm font-black text-indigo-600 shadow-sm ring-1 ring-indigo-100 hover:bg-indigo-600 hover:text-white transition-all active:scale-95" %>
                </td>
              </tr>
            </tbody>
          <% end %>
        <% end %>
      </table>
    </div>
  </div>
</div>