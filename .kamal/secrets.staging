# Staging Environment Secrets
# This file contains secrets specific to the staging environment
# All secrets should be pulled from either password manager, ENV, or a file.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Use the same registry password as production
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Use the same Rails master key as production (or create a separate one for staging)
RAILS_MASTER_KEY=$(cat config/master.key) 