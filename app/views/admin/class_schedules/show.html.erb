<%# app/views/admin/class_schedules/show.html.erb %>
<%= turbo_stream_from "schedule_#{@class_schedule.id}" %>

<div data-controller="modal" data-action="keyup@window->modal#handleKeyup" class="w-full py-6 px-4">
  <%# 1. BREADCRUMB %>
  <nav class="mb-6 flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
    <%= link_to @back_path, class: "hover:text-indigo-600 transition-colors" do %>
      <%= @back_label %>
    <% end %>

    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path d="M9 5l7 7-7 7" stroke-width="3"/>
    </svg>

    <span class="text-indigo-600/50">Expediente de Sesión</span>
  </nav>

  <div class="bg-white rounded-[3rem] shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-8 lg:p-12">
      
      <%# 2. HEADER CON ACCIONES %>
      <header class="mb-6 border-b border-slate-100 pb-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-3 mb-2">
              <div class="h-8 w-1.5 bg-indigo-600 rounded-full"></div>
              <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter italic leading-none">
                <%= @class_schedule.class_type.name %>
              </h1>
            </div>
            <div class="flex items-center gap-4 text-[11px] font-black text-indigo-600 tracking-[0.2em] uppercase ml-4">
              <span>Hora: <%= @class_schedule.starts_at.strftime("%I:%M %p") %></span>
              <span class="text-slate-300">•</span>
              <span>Fecha: <%= l(@class_schedule.starts_at, format: "%d %B %Y") %></span>
            </div>
          </div>

          <div class="flex items-center gap-3">
             <%= link_to edit_admin_class_schedule_path(@class_schedule), 
                        class: "px-6 py-3 bg-amber-500 text-white rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-amber-600 transition-all shadow-md shadow-amber-100 active:scale-95" do %>
              <%= t('admin.class_schedules.show.edit_class') %>
            <% end %>
            
            <%= link_to admin_class_schedules_path, class: "p-3 bg-slate-50 text-slate-400 hover:text-red-500 rounded-xl transition-all" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M6 18L18 6M6 6l12 12" /></svg>
            <% end %>
          </div>
        </div>
      </header>

      <%# 3. CONTENIDO PRINCIPAL (Centrado y en una sola columna) %>
      <div class="max-w-4xl mx-auto space-y-10">
        
        <%# Quick Stats Mini %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 py-4">
          <div class="bg-indigo-600 p-6 rounded-3xl shadow-xl shadow-indigo-100">
            <span class="block text-[9px] font-black text-indigo-200 uppercase tracking-widest mb-1">
              <%= @class_schedule.special_guest? ? "Invitado Especial" : "Instructor Responsable" %>
            </span>
            <span class="text-xl font-black italic text-white uppercase"><%= @class_schedule.displayed_instructor_name %></span>
            <% if @class_schedule.special_guest? %>
              <span class="block mt-2 text-[9px] font-black text-indigo-200/80 uppercase tracking-widest">
                Backup: <%= @class_schedule.instructor.first_name %>
              </span>
            <% end %>
          </div>
          <div class="bg-slate-50 border-2 border-slate-100 p-6 rounded-3xl">
            <span class="block text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Capacidad Total</span>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-black italic text-slate-900">
                <%= @class_schedule.capacity %> Espacios
              </span>
            </div>
          </div>
        </div>

        <%# Contadores en tiempo real (Ocupación y Presencia) %>
        <div class="grid grid-cols-2 gap-8 px-2 py-4 border-y border-slate-50 bg-slate-50/30 rounded-2xl">
          <div class="flex flex-col items-center text-center md:items-start md:text-left">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Alumnos inscritos</span>
            <div class="flex items-baseline gap-2">
              <span id="user_enrolled_count_<%= @class_schedule.id %>" class="text-4xl font-black italic text-indigo-600 leading-none">
                <%= @class_schedule.active_bookings_count %> Inscritos
              </span>
            </div>
          </div>

          <div class="flex flex-col items-center text-center md:items-start md:text-left border-l border-slate-200 pl-8">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">En Tatami</span>
            <div class="flex items-baseline gap-2">
              <span id="admin_attended_bookings_counter_<%= @class_schedule.id %>" class="text-4xl font-black italic text-emerald-500 leading-none">
                <%= @class_schedule.attended_bookings_count %>
              </span>
              <span class="text-slate-400 font-bold uppercase text-[9px]">Presentes</span>
            </div>
          </div>
        </div>

        <%# LISTA DE ASISTENCIA %>
        <div class="space-y-4">
          <div class="flex items-center justify-between px-2">
            <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest">Lista de Inscritos</h3>
          </div>
          <div class="border-2 border-slate-50 rounded-[2.5rem] overflow-hidden bg-white">
            <%= render "admin/class_schedules/partials/attendance_list", schedule: @class_schedule %>
          </div>
        </div>

        <%# INSCRIPCIÓN MANUAL%>
        <div class="sticky bottom-6 mt-10 z-30 flex justify-center pointer-events-none">
          <button data-action="click->modal#open" 
                  class="pointer-events-auto flex items-center gap-3 bg-slate-900 text-white px-8 py-4 sm:px-10 sm:py-5 rounded-[2rem] sm:rounded-[2.5rem] font-black text-[10px] sm:text-[11px] uppercase tracking-widest shadow-2xl hover:bg-indigo-600 transition-all active:scale-95 shadow-indigo-500/40 border border-white/10 backdrop-blur-sm">
            <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            <%= t('admin.class_schedules.attendance.add_manual') %>
          </button>
        </div>
        <%= render "admin/class_schedules/partials/add_student_modal" %>

      </div> <%# Fin de max-w-4xl %>
    </div> <%# Fin de p-8 %>
  </div> <%# Fin de bg-white rounded-3xl %>
</div>