<div id="review-prompt-banner" data-controller="review-prompt" class="bg-gradient-to-r from-amber-50 to-orange-50 border border-orange-100 rounded-3xl p-5 sm:p-6 mb-6 shadow-sm relative overflow-hidden transition-all duration-300 transform origin-top">
  <!-- Subtle background pattern or accent -->
  <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-orange-100/50 blur-2xl pointer-events-none"></div>
  
  <div class="relative z-10 flex flex-col gap-4 sm:gap-5">
    <div class="flex-1 min-w-0">
      <h3 class="text-base sm:text-lg font-black text-slate-800 mb-1.5 tracking-tight leading-snug">¡Nos encanta verte entrenar en nuestra nueva sede!</h3>
      <p class="text-sm font-medium text-slate-600 leading-relaxed max-w-3xl">
        Si estás disfrutando de las clases y del nuevo espacio de Puerto BJJ, nos ayudaría muchísimo si nos dejas una pequeña reseña y alguna foto del local nuevo en Google.
      </p>
    </div>
      
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto mt-1">
      <!-- Google Search Button -->
      <a href="https://www.google.com/search?q=puerto+jiu+jitsu" 
         target="_blank" 
         data-action="click->review-prompt#acknowledge"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 sm:py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-xl shadow-md shadow-blue-500/20 transition-all active:scale-95">
        <svg class="w-5 h-5 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Buscar en Google
      </a>
      
      <div class="flex w-full sm:w-auto items-center gap-2 sm:gap-3">
        <!-- Later Button -->
        <button type="button" 
                data-action="click->review-prompt#hideTemporarily"
                class="flex-1 sm:flex-none inline-flex items-center justify-center px-3 py-3 sm:py-2.5 bg-white text-slate-600 hover:text-slate-800 text-xs sm:text-sm font-bold whitespace-nowrap rounded-xl border border-slate-200 shadow-sm transition-all active:scale-95">
          Más tarde
        </button>
        
        <!-- Acknowledge Button -->
        <button type="button" 
                data-action="click->review-prompt#acknowledge"
                class="flex-1 sm:flex-none inline-flex items-center justify-center px-3 py-3 sm:py-2.5 bg-white text-slate-600 hover:text-slate-800 text-xs sm:text-sm font-bold whitespace-nowrap rounded-xl border border-slate-200 shadow-sm transition-all active:scale-95">
          Ya los apoyé
        </button>
      </div>
    </div>
  </div>
</div>
