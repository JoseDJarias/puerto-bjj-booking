<% content_for :page_title, t('admin.users.show.title') %>

<div class="mb-6">
  <%= link_to admin_users_path, class: "text-sm text-slate-500 hover:text-slate-700 flex items-center gap-1 mb-4" do %>
    <span>←</span> <%= t('admin.users.show.back') %>
  <% end %>

  <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
    <div class="flex items-center gap-4">
      <div class="h-16 w-16 rounded-full bg-slate-200 flex items-center justify-center text-2xl font-bold text-slate-600 uppercase">
        <%= @user.first_name&.first || @user.email_address.first %>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= @user.first_name %> <%= @user.last_name %></h1>
        <p class="text-slate-500"><%= @user.email_address %></p>
        <div class="mt-1 flex gap-2">
           <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-600/10">
             <%= t("enums.user.role.#{@user.role}") %>
           </span>
           <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= @user.active? ? 'bg-green-50 text-green-700 ring-green-600/20' : 'bg-red-50 text-red-700 ring-red-600/10' %>">
             <%= t("enums.user.status.#{@user.status}") %>
           </span>
        </div>
      </div>
    </div>
    
    <%= link_to t('admin.common.edit'), edit_admin_user_path(@user), class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
</div>

<hr class="my-8 border-slate-200">

<div>
  <div class="flex justify-between items-center mb-6">
    <h3 class="text-lg font-semibold text-slate-900"><%= t('admin.users.show.memberships_title') %></h3>
    
    <%= link_to new_admin_membership_path(user_id: @user.id), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 flex items-center gap-2" do %>
      <%= t('admin.users.show.new_membership') %>
    <% end %>
  </div>

  <% if @memberships.any? %>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th scope="col" class="sticky left-0 z-10 bg-slate-50 px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
                <%= t('activerecord.attributes.membership.membership_plan') %>
              </th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap"><%= t('activerecord.attributes.membership.status') %></th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap"><%= t('admin.users.show.validity') %></th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">Monto</th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% @memberships.each do |membership| %>
              <tr class="group hover:bg-slate-50">
                <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 px-4 py-3 shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
                  <div class="min-w-0">
                    <div class="truncate text-sm font-medium text-slate-900" title="<%= membership.membership_plan.name %>"><%= membership.membership_plan.name %></div>
                    <div class="truncate text-xs text-slate-500" title="<%= membership.membership_package.name %>"><%= membership.membership_package.name %></div>
                  </div>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-center">
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                    <%= membership.current? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= t("enums.membership.status.#{membership.current? ? 'active' : 'expired'}") %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600 text-center">
                  <div class="flex flex-col">
                    <span><%= l(membership.start_date, format: :short) %> - <%= l(membership.end_date, format: :short) %></span>
                    <% if membership.current? %>
                      <span class="text-xs text-indigo-600 font-medium"><%= t('admin.users.show.days_remaining', count: membership.days_remaining) %></span>
                    <% end %>
                  </div>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-slate-900 text-center">
                  <%= number_to_currency(membership.amount_paid) %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-center text-sm font-medium">
                  <%= link_to t('admin.common.edit'), edit_admin_membership_path(membership), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
      <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-slate-900"><%= t('admin.users.show.no_history') %></h3>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.users.show.no_memberships') %></p>
    </div>
  <% end %>

    <div class="mt-12">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-lg font-semibold text-slate-900 italic"><%= t('admin.users.show.credits_wallet') %></h3>
        
      </div>
      <section id="drop-in-section">
        <%= render "admin/users/drop_in_management", user: @user %>
      </section>
     </div>
</div>