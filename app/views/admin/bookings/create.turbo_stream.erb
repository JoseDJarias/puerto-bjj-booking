<%= turbo_stream.prepend "attendance_list_#{@schedule.id}" do %>
  <%= render "admin/class_schedules/partials/booking_row", booking: @booking %>
<% end %>

<%= turbo_stream.remove "empty_tatami_msg" %>

<%= turbo_stream.update "spots_counter", "#{@schedule.active_bookings_count}/#{@schedule.capacity}" %>
<%= turbo_stream.update "attended_counter", @schedule.attended_bookings_count %>
<%= turbo_stream.update "enrolled_badge", "#{@schedule.active_bookings_count} #{t('admin.class_schedules.attendance.enrolled_label').downcase.capitalize}" %>

<%= turbo_stream.remove "user_sidebar_#{@booking.user_id}" %>

<%= turbo_stream.update "flash", partial: "layouts/flash", locals: { notice: t('admin.bookings.flash.enrolled') } %>