<div id="spots_schedule_<%= schedule.id %>" class="transition-all duration-300">
  <% if schedule.full? %>
    <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">
      <%= t('class_schedules.spots.full_badge') %>    
    </span>
  <% else %>
    <div class="flex items-baseline gap-1">
      <span class="text-lg font-bold text-green-600"><%= schedule.spots_left %></span>
      <span class="text-xs text-slate-500 font-medium"><%= t('class_schedules.spots.available_suffix') %></span>
    </div>
  <% end %>
</div>