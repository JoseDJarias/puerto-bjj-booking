<div class="flex items-center justify-between rounded-xl bg-white px-4 py-3 border border-slate-200 hover:border-slate-300 transition-colors">
  <span class="text-sm font-semibold text-slate-800">
    <%= plan.name %>
  </span>
  <span class="text-base font-bold tabular-nums text-indigo-700 bg-indigo-50 px-3 py-1.5 rounded-lg border border-indigo-200">
    <%= number_to_currency(package.price_for(plan) || 0, precision: 0) %>
  </span>
</div>