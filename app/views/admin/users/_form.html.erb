<div class="mb-6">
  <h2 class="text-xl font-bold text-slate-900 mb-2"><%= t('admin.users.new.title') %></h2>
  <p class="mt-2 text-sm text-slate-500"><%= t('admin.users.new.subtitle') %></p>
</div>
<%= form_with model: [:admin, user], class: "space-y-6" do |f| %>
 <% if user.errors.any? %>
    <div class="rounded-2xl bg-red-50 p-4 border-2 border-red-100 mb-6 w-full overflow-hidden">
        <div class="flex items-start gap-3 mb-3">
        <div class="h-6 w-6 rounded-full bg-red-100 flex-shrink-0 flex items-center justify-center text-red-600 mt-0.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
        </div>
        <h3 class="text-sm font-black text-red-800 uppercase tracking-tight leading-tight">
            <%= t('auth.sign_up.errors.title') %>
        </h3>
        </div>
        
        <ul class="space-y-2 ml-9 break-words">
        <% user.errors.full_messages.each do |msg| %>
            <li class="text-xs sm:text-sm text-red-700 font-medium leading-relaxed">
            <span class="font-black italic mr-1 text-red-400">•</span> 
            <%= msg %>
            </li>
        <% end %>
        </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :first_name, t('activerecord.attributes.user.first_name'), class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :first_name, class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :last_name, t('activerecord.attributes.user.last_name'), class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :last_name, class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :identification, t('activerecord.attributes.user.identification'), class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :identification, placeholder: "Ej: 1234567890", class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :nickname, t('activerecord.attributes.user.nickname'), class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :nickname, placeholder: "Ej: conejitsu", class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :email_address, t('activerecord.attributes.user.email_address'), class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email_address, placeholder: "Ej: usuario@ejemplo.com", class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :phone_number, t('activerecord.attributes.user.phone_number'), class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.telephone_field :phone_number, placeholder: "Ej: 88223344", class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="pt-4 border-t border-slate-100">
    <h3 class="text-sm font-medium text-slate-900 mb-3"><%= t('admin.users.edit.admin_section') %></h3>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :role, t('admin.users.index.role'), class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.select :role, User.roles.keys.map { |r| [t("enums.user.role.#{r}"), r] }, {}, class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= f.label :status, t('admin.common.active'), class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.select :status, User.statuses.keys.map { |s| [t("enums.user.status.#{s}"), s] }, {}, class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
      </div>
    </div>
  </div>

  <div class="pt-4 border-t border-slate-100">
    <h3 class="text-sm font-medium text-slate-900 mb-1">Seguridad</h3>
    <p class="text-[10px] text-slate-500 mb-3 italic">Si se deja vacío en creación, el default es: Puerto123!</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.password_field :password, placeholder: "Nueva contraseña", class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= f.password_field :password_confirmation, placeholder: "Confirmar contraseña", class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
      </div>
    </div>
  </div>

  <div class="flex gap-3 pt-6">
    <%= f.submit t("admin.common.#{user.new_record? ? 'create' : 'update'}"), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to t('admin.common.cancel'), admin_users_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>

<%# Delete Button: Only appears if the user already exists (we are editing) %>
<% if user.persisted? && user != Current.user %>
  <div class="mt-12 pt-8 border-t-2 border-slate-100">
    <div class="rounded-3xl bg-rose-50 p-6 sm:p-8 border border-rose-100">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="space-y-1">
          <h3 class="text-base font-black text-rose-800 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Zona de Peligro
          </h3>
          <p class="text-sm text-rose-600 font-medium leading-relaxed max-w-xl">
            ¿Deseas eliminar a <span class="font-bold"><%= user.full_legal_name %></span>? Esta acción es irreversible y borrará todo su historial de membresías y asistencias.
          </p>
        </div>
        
        <%= button_to admin_user_path(user), 
            method: :delete, 
            class: "w-full lg:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white hover:bg-rose-600 text-rose-600 hover:text-white text-sm font-black uppercase tracking-widest rounded-2xl transition-all border-2 border-rose-200 hover:border-rose-600 shadow-sm",
            data: { turbo_confirm: "¡ALTO! ¿Estás seguro de que quieres borrar permanentemente a #{user.full_legal_name}? Esta acción no se puede deshacer." } do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Borrar Usuario
        <% end %>
      </div>
    </div>
  </div>
<% end %>