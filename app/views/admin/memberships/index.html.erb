<% content_for :page_title, t('admin.memberships.index.title') %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.memberships.index.title') %></h2>
  <%= link_to t('admin.memberships.index.new'), new_admin_membership_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-slate-200">
    <thead class="bg-slate-50">
      <tr>
        <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600"><%= t('admin.memberships.index.user_column') rescue "Alumno" %></th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600"><%= t('admin.memberships.index.table.plan_details') %></th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600"><%= t('activerecord.attributes.membership.status') %></th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600"><%= t('admin.memberships.index.table.validity') %></th>
        <th scope="col" class="relative px-4 py-3"><span class="sr-only"><%= t('admin.common.actions') %></span></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @memberships.each do |membership| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3">
            <div class="flex items-center">
              <div class="h-8 w-8 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600">
                <%= membership.user.first_name&.first %>
              </div>
              <div class="ml-3">
                <div class="text-sm font-medium text-slate-900"><%= membership.user.first_name %> <%= membership.user.last_name %></div>
              </div>
            </div>
          </td>
          
          <td class="px-4 py-3">
            <div class="text-sm font-medium text-slate-900"><%= membership.membership_plan.name %></div>
            <div class="text-xs text-slate-500"><%= membership.membership_package.name %></div>
          </td>

          <td class="whitespace-nowrap px-4 py-3 text-sm">
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium 
              <%= membership.active? ? 'bg-green-100 text-green-800' : (membership.expired? ? 'bg-orange-100 text-orange-800' : 'bg-red-100 text-red-800') %>">
              <%= t("enums.membership.status.#{membership.status}") %>
            </span>
          </td>

          <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-500">
            <div class="flex flex-col">
              <span><%= l(membership.start_date, format: :short) %> - <%= l(membership.end_date, format: :short) %></span>
              <% if membership.active? %>
                <span class="text-xs text-indigo-600 font-medium"><%= membership.days_remaining %> días restantes</span>
              <% end %>
            </div>
          </td>

          <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium">
            <%= link_to t('admin.common.edit'), edit_admin_membership_path(membership), class: "text-indigo-600 hover:text-indigo-900" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>