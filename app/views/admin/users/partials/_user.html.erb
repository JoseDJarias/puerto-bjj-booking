<tr id="<%= dom_id(user) %>" class="group hover:bg-slate-50/50 transition-colors">
  <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50/50 px-4 py-4 shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
    <div class="flex items-center">
      <div class="h-9 w-9 flex-shrink-0 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 font-black text-xs">
        <%= user.first_name&.first || user.email_address.first.upcase %>
      </div>
      <div class="ml-3 min-w-0 max-w-[120px] sm:max-w-[200px]"> <%# Limitamos el ancho para forzar el truncado %>
        <div class="text-[12px] text-slate-900 truncate tracking-tight">
          <%= user.full_legal_name %>
        </div>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">EMAIL</span>
          <span class="text-[11px] font-medium text-slate-500 truncate italic">
            <%= user.email_address.truncate(18) %>
          </span>
        </div>
      </div>
    </div>
  </td>

  <%# ROL%>
  <td class="px-3 py-4 whitespace-nowrap">
    <span class="inline-flex items-center rounded-lg bg-slate-100 px-2 py-1 text-[9px] font-black uppercase tracking-widest text-slate-600 ring-1 ring-inset ring-slate-200">
      <%# Lógica para mostrar ADMIN en lugar de ADMINISTRADOR %>
      <%= user.admin? ? "ADMIN" : t("enums.user.role.#{user.role}").upcase.truncate(10) %>
    </span>
  </td>

  <%# Status %>
  <td class="px-3 py-4 whitespace-nowrap">
    <% if user.approved_at.present? %>
      <div class="flex items-center gap-1.5">
        <div class="h-2 w-2 rounded-full bg-green-500"></div>
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-700">APROBADO</span>
      </div>
    <% else %>
      <%= button_to approve_admin_user_path(user), method: :patch, 
          class: "inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[9px] font-black uppercase tracking-widest text-red-600 shadow-sm ring-1 ring-inset ring-indigo-100 hover:bg-indigo-600 hover:text-white transition-all",
          data: { turbo_confirm: "¿Aprobar a este usuario?" } do %>
        <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4"><path d="M5 13l4 4L19 7"/></svg>
        PENDIENTE
      <% end %>
    <% end %>
  </td>

  <%# Actions %>
  <td class="px-4 py-4 whitespace-nowrap text-center">
    <div class="flex justify-center items-center gap-1">
      <%= link_to admin_user_path(user), data: { turbo_frame: "_top" }, class: "p-2 text-slate-400 hover:text-indigo-600 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
      <% end %>
      <%= link_to edit_admin_user_path(user), data: { turbo_frame: "_top" }, class: "p-2 text-slate-400 hover:text-indigo-600 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
      <% end %>
    </div>
  </td>
</tr>