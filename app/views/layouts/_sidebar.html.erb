<aside data-sidebar-target="sidebar"
       class="fixed inset-y-0 left-0 z-50 w-64 transform bg-white shadow-xl transition-transform duration-300 ease-in-out lg:relative lg:translate-x-0 -translate-x-full flex flex-col border-r border-slate-100">

  <div class="flex h-16 items-center justify-between px-6 bg-white">
    <span class="text-lg font-black italic text-slate-900 tracking-tighter uppercase">
      <%= t("auth.branding.title") %>
    </span>
    <button type="button" data-action="click->sidebar#close" class="lg:hidden text-slate-400 hover:text-slate-600 transition-colors">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-4 py-6">
    
    <% link_classes = "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-bold transition-all duration-200 group" %>
    <% active_classes = "bg-indigo-50 text-indigo-700 shadow-sm ring-1 ring-indigo-200" %>
    <% inactive_classes = "text-slate-600 hover:bg-slate-50 hover:text-slate-900" %>
    <% section_header = "px-3 mb-2 text-[10px] font-black uppercase tracking-widest text-slate-400 mt-6 first:mt-0" %>

    <p class="<%= section_header %>"><%= t("nav.sections.general") %></p>
    
    <%= link_to root_path, class: "#{link_classes} #{current_page?(root_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(root_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span><%= t("nav.home") %></span>
    <% end %>

    <%= link_to contact_path, class: "#{link_classes} #{current_page?(contact_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(contact_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      <span><%= t("nav.contact") %></span>
    <% end %>


    <p class="<%= section_header %>"><%= t("nav.sections.tatami") %></p>

    <%= link_to class_schedules_path, class: "#{link_classes} #{current_page?(class_schedules_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(class_schedules_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span><%= t("nav.bookings") %></span>
    <% end %>
    
    <%= link_to week_class_schedules_path, class: "#{link_classes} #{current_page?(week_class_schedules_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(week_class_schedules_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= t("class_schedules.week.title") %></span>
    <% end %>

    <%= link_to dog_fights_path, class: "#{link_classes} #{current_page?(dog_fights_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(dog_fights_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span><%= t("nav.dog_fights") %></span>
    <% end %>


    <p class="<%= section_header %>"><%= t("nav.sections.account") %></p>

    <%= link_to my_membership_path, class: "#{link_classes} #{current_page?(my_membership_path) ? active_classes : inactive_classes}" do %>
      <svg class="h-5 w-5 <%= current_page?(my_membership_path) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
      </svg>
      <span><%= t("nav.my_membership") %></span>
    <% end %>

  </nav>

  <div class="p-4 border-t border-slate-100">
    <div class="rounded-xl bg-slate-50 p-3 text-center">
      <p class="text-[10px] text-slate-400 font-medium">Puerto BJJ © <%= Time.current.year %></p>
    </div>
  </div>
</aside>