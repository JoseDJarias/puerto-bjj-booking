<%= form_with model: [:admin, membership_package], class: "space-y-6" do |f| %>
  
  <% if membership_package.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 border border-red-200">
      <ul class="list-disc pl-5 text-sm text-red-700">
        <% membership_package.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500", placeholder: "Ej: Ticket Total, Solo Boxeo..." %>
  </div>
    
  <div>
    <%= f.label :description, class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 2, class: "block w-full rounded-lg border border-slate-300 px-4 py-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <label class="mb-3 block text-sm font-medium text-slate-700">
      <%= t('admin.packages.form.select_classes') rescue "Disciplinas incluidas" %>
    </label>
    
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <%= f.collection_check_boxes :class_type_ids, ClassType.active, :id, :name do |b| %>
        <div class="relative">
          <%= b.check_box class: "peer sr-only" %> 
          
          <%= b.label class: "flex cursor-pointer items-center justify-between rounded-lg border border-slate-200 bg-white p-3 hover:bg-slate-50 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 transition-all select-none" do %>
            <span class="font-medium"><%= b.text %></span>
            <svg class="hidden h-5 w-5 text-indigo-600 peer-checked:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
    <%= f.label :active, t('admin.common.active_record'), class: "text-sm text-slate-700" %>
  </div>

  <div class="flex gap-3 pt-4 border-t border-slate-100">
    <%= f.submit membership_package.persisted? ? t('admin.common.update') : t('admin.common.create'), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to t('admin.common.cancel'), admin_membership_packages_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>