<% content_for :page_title, t('my_membership.title') %>

<div class="min-h-0 max-w-3xl px-1 sm:px-0">
  <header class="mb-12 sm:mb-10">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6 sm:gap-4">
      <div class="space-y-2">
        <p class="text-slate-600 text-base sm:text-[0.9375rem] leading-relaxed"><%= t('my_membership.subtitle') %></p>
      </div>
      <%= link_to my_membership_history_path, class: "inline-flex items-center justify-center sm:justify-start gap-2.5 rounded-xl border border-slate-200 bg-white px-5 py-3.5 sm:px-4 sm:py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 hover:border-slate-300 transition-colors flex-shrink-0 w-full sm:w-auto" do %>
        <svg class="h-5 w-5 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <%= t('my_membership.view_history') %>
      <% end %>
    </div>
  </header>

  <% if @current_memberships.any? %>
    <div class="space-y-8 sm:space-y-8">
      <% @current_memberships.each do |membership| %>
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-5 py-7 sm:px-8 sm:py-8">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
              <div>
                <h2 class="text-lg font-semibold text-slate-900"><%= membership.membership_package.name %></h2>
                <p class="text-slate-600 mt-0.5"><%= membership.membership_plan.display_name %></p>
              </div>
              <% if membership.days_remaining <= 7 && membership.days_remaining > 0 %>
                <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-medium text-amber-800">
                  <%= t('my_membership.expires_soon') %>
                </span>
              <% elsif membership.days_remaining == 0 %>
                <span class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-800">
                  <%= t('my_membership.expires_today') %>
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-800">
                  <%= t('my_membership.active') %>
                </span>
              <% end %>
            </div>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
              <div>
                <dt class="text-sm font-medium text-slate-500"><%= t('my_membership.start_date') %></dt>
                <dd class="mt-1 text-base text-slate-900"><%= l(membership.start_date, format: :long) %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-slate-500"><%= t('my_membership.end_date') %></dt>
                <dd class="mt-1 text-base text-slate-900"><%= l(membership.end_date, format: :long) %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-slate-500"><%= t('my_membership.days_remaining') %></dt>
                <dd class="mt-1 text-xl font-semibold text-slate-900"><%= membership.days_remaining %> <%= t('my_membership.days') %></dd>
              </div>
              <% if membership.membership_package.class_types.any? %>
                <div class="sm:col-span-2">
                  <dt class="text-sm font-medium text-slate-500"><%= t('my_membership.includes_classes') %></dt>
                  <dd class="mt-1 text-base text-slate-700"><%= membership.membership_package.class_type_names %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm px-6 sm:px-8 py-12 sm:py-12 text-center">
      <p class="text-slate-600 text-lg mb-3"><%= t('my_membership.no_active') %></p>
      <p class="text-slate-500 text-sm max-w-md mx-auto leading-relaxed"><%= t('my_membership.no_active_hint') %></p>
    </section>
  <% end %>

   <% if @unused_drop_in_count.to_i.positive? || @drop_in_active_today %>
    <section class="mt-10 sm:mt-10 bg-indigo-50 rounded-2xl border border-indigo-100 px-6 sm:px-8 py-7 sm:py-8 space-y-4">
      <h2 class="text-lg font-semibold text-indigo-900 mb-2"><%= t('my_membership.drop_in_title') %></h2>
      <% if @unused_drop_in_count.to_i.positive? %>
        <p class="text-indigo-800"><%= t('my_membership.drop_in_count', count: @unused_drop_in_count) %></p>
      <% end %>
      <% if @drop_in_active_today %>
        <p class="text-indigo-800 font-medium"><%= t('my_membership.drop_in_active_today') %></p>
      <% end %>
    </section>
  <% end %>
</div>