<h2 class="mb-2 text-xl font-semibold text-slate-900"><%= t('auth.sign_up.title') %></h2>
<p class="mb-6 text-sm text-slate-600"><%= t('auth.sign_up.subtitle') %></p>

<%= form_with model: @user, url: registration_path do |form| %>
  <!-- Error Messages -->
  <% if @user.errors.any? %>
    <div class="mb-6 rounded-lg bg-red-50 p-4" role="alert">
      <h3 class="mb-2 text-sm font-semibold text-red-800"><%= t('auth.sign_up.errors.title') %></h3>
      <ul class="list-disc pl-5 text-sm text-red-700">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Email Field -->
  <div class="mb-5">
    <%= form.label :email_address, t('auth.sign_up.email_label'), class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= form.email_field :email_address,
        required: true,
        autofocus: true,
        autocomplete: "username",
        placeholder: t('auth.sign_up.email_placeholder'),
        class: "block w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 transition focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
  </div>

  <!-- Password Field -->
  <div class="mb-5">
    <%= form.label :password, t('auth.sign_up.password_label'), class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= form.password_field :password,
        required: true,
        autocomplete: "new-password",
        placeholder: t('auth.sign_up.password_placeholder'),
        maxlength: 72,
        class: "block w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 transition focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
    <p class="mt-2 text-xs text-slate-500"><%= t('auth.sign_up.password_hint') %></p>
  </div>

  <!-- Password Confirmation Field -->
  <div class="mb-6">
    <%= form.label :password_confirmation, t('auth.sign_up.password_confirmation_label'), class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= form.password_field :password_confirmation,
        required: true,
        autocomplete: "new-password",
        placeholder: t('auth.sign_up.password_confirmation_placeholder'),
        maxlength: 72,
        class: "block w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 transition focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10" %>
  </div>

  <!-- Submit Button -->
  <%= form.submit t('auth.sign_up.submit_button'),
      class: "mb-4 w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/50 active:bg-indigo-800" %>

  <!-- Sign In Link -->
  <div class="text-center">
    <span class="text-sm text-slate-600"><%= t('auth.sign_up.already_have_account') %></span>
    <%= link_to t('auth.sign_up.sign_in_link'), new_session_path,
        class: "text-sm font-medium text-indigo-600 transition hover:text-indigo-700" %>
  </div>
<% end %>
