<%# app/views/layouts/_topbar.html.erb %>
<% hide_on_mobile = local_assigns.fetch(:hide_on_mobile, false) %>
<header class="sticky top-0 z-30 <%= hide_on_mobile ? 'hidden lg:flex' : 'flex' %> h-16 items-center justify-between border-b border-slate-200 bg-white px-4 lg:px-8">
  <div class="flex items-center gap-4">
    <button type="button" data-action="click->sidebar#open" class="lg:hidden -ml-2 p-2 text-slate-500 hover:bg-slate-100 rounded-md">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
    <h1 class="text-lg font-semibold text-slate-900"><%= content_for(:page_title) || t("auth.branding.title") %></h1>
  </div>

  <div class="relative" data-controller="dropdown">
    <button type="button" 
            data-action="click->dropdown#toggle click@window->dropdown#hide"
            class="flex items-center gap-3 p-1 pr-3 rounded-full hover:bg-slate-50 transition-all border border-transparent hover:border-slate-100">
      
      <div class="h-9 w-9 rounded-full bg-indigo-600 flex items-center justify-center text-[11px] font-black text-white uppercase shadow-md shadow-indigo-100">
        <%= Current.user.first_name&.first || Current.user.email_address.first %>
      </div>
      
      <div class="hidden md:block text-left">
        <p class="text-[10px] font-black text-slate-900 uppercase tracking-tight leading-none">
          <%= Current.user.nickname.presence || Current.user.first_name %>
        </p>
        <p class="text-[9px] font-medium text-slate-400 lowercase italic">
          <%= t("enums.user.role.#{Current.user.role}") %>
        </p>
      </div>

      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-width="3" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div data-dropdown-target="menu" 
          class="hidden absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-200/50 z-50 overflow-hidden animate-in fade-in zoom-in-95 duration-100">
      
      <div class="p-3 border-b border-slate-50 bg-slate-50/50">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1"><%= t('topbar.active_session') %></p>
        <p class="text-xs font-bold text-slate-700 truncate"><%= Current.user.email_address %></p>
      </div>

      <div class="p-1">
        <%= link_to edit_user_path, class: "flex items-center gap-3 px-3 py-2.5 text-xs font-bold text-slate-700 rounded-xl hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <%= t('admin.users.edit.title') %>
        <% end %>

        <% if Current.user.admin? || Current.user.instructor? %>
          <% if request.path.start_with?('/admin') %>
            <%= link_to root_path, class: "flex items-center justify-between px-3 py-2 rounded-xl bg-slate-50 hover:bg-indigo-600 group transition-all duration-200" do %>
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-indigo-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <span class="text-[10px] font-black uppercase tracking-tight text-slate-600 group-hover:text-white transition-colors">
                  <%= t('topbar.view_as_student') %>
                </span>
              </div>
              <svg class="w-3 h-3 text-slate-300 group-hover:text-indigo-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          <% else %>
            <%= link_to admin_dashboard_path, class: "flex items-center gap-2 px-3 py-2 text-xs font-bold text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <%= t('topbar.management_mode') %>
            <% end %>
          <% end %>
      <% end %>
      </div>

      <div class="h-[1px] bg-slate-100 my-1"></div>

      <div class="p-1">
        <%= button_to session_path, method: :delete, class: "w-full flex items-center gap-3 px-3 py-2.5 text-xs font-bold text-red-500 rounded-xl hover:bg-red-50 transition-colors cursor-pointer" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <%= t('topbar.sign_out') %>
        <% end %>
      </div>
    </div>
  </div>
</header>