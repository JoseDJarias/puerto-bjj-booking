<%# app/views/dashboard/show.html.erb %>
<% content_for :page_title, t("nav.home") %>
<article class="mx-auto w-full max-w-2xl px-4 py-2 overflow-x-hidden">
  <% if @user.pending_approval? %>
    <%= render "dashboard/states/pending" %>
  <% elsif @user.approved? && !@user.has_booking_access? %>
    <%= render "dashboard/states/pricing_options", packages: @packages, plans: @plans %>
  <% else %>
    <%= render "dashboard/states/active_member", user: @user %>
  <% end %>
</article>