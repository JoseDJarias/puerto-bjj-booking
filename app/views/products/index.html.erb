<% content_for :title, t('products.index.title') %>

<div class="space-y-6">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= t('products.index.title') %></h1>
      <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1"><%= t('products.index.subtitle') %></p>
    </div>

    <% if current_user.product_orders.any? %>
      <div>
        <%= link_to my_orders_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-2xl text-xs font-black uppercase tracking-wider shadow-sm transition-all" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
          <span><%= t('nav.my_orders') %></span>
          <span class="bg-indigo-500 text-white text-[10px] font-black px-1.5 py-0.5 rounded-full"><%= current_user.product_orders.size %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Catalog List %>
  <% if @products.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <% @products.each do |product| %>
        <% product_image_urls = product.images.attached? ? product.images.map { |img| url_for(img) } : [] %>

        <div class="group bg-white rounded-3xl p-4 sm:p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between"
             data-controller="product-gallery"
             data-product-gallery-images-value="<%= product_image_urls.to_json %>">
          <div>
            <%# Product Image Carousel %>
            <div class="relative w-full aspect-square bg-slate-50 rounded-2xl overflow-hidden mb-4 border border-slate-100 flex items-center justify-center group/img">
              <% if product.images.attached? %>
                <%# Swipeable Image Container %>
                <div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide w-full h-full overscroll-x-contain"
                     data-product-gallery-target="container"
                     data-action="scroll->product-gallery#onScroll">
                  <% product.images.each_with_index do |img, idx| %>
                    <div class="snap-center shrink-0 w-full h-full flex items-center justify-center bg-slate-50 cursor-zoom-in"
                         data-action="click->product-gallery#openLightbox"
                         data-index="<%= idx %>">
                      <%= image_tag img, class: "w-full h-full object-cover select-none pointer-events-none" %>
                    </div>
                  <% end %>
                </div>

                <%# Top Badges & Controls %>
                <div class="absolute top-3 left-3 z-10 pointer-events-none">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-xl text-[10px] font-black bg-slate-900/80 text-white backdrop-blur-md uppercase tracking-wider shadow-sm">
                    <%= t('products.index.order_badge') %>
                  </span>
                </div>

                <div class="absolute top-3 right-3 flex items-center gap-1.5 z-10">
                  <% if product.images.size > 1 %>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-slate-900/80 text-white backdrop-blur-md shadow-sm"
                          data-product-gallery-target="counter">
                      1 / <%= product.images.size %>
                    </span>
                  <% end %>
                  <button type="button"
                          data-action="click->product-gallery#openLightbox"
                          class="p-1.5 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white backdrop-blur-md shadow-sm transition-transform active:scale-90 cursor-pointer"
                          title="Ampliar foto">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                  </button>
                </div>

                <%# Navigation Arrows (Desktop / Hover) %>
                <% if product.images.size > 1 %>
                  <button type="button"
                          data-action="click->product-gallery#prevSlide"
                          class="hidden sm:flex absolute left-2 top-1/2 -translate-y-1/2 w-7 h-7 items-center justify-center rounded-full bg-white/90 hover:bg-white text-slate-800 shadow-md backdrop-blur-sm transition-all opacity-0 group-hover/img:opacity-100 active:scale-90 cursor-pointer z-10">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                  </button>
                  <button type="button"
                          data-action="click->product-gallery#nextSlide"
                          class="hidden sm:flex absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 items-center justify-center rounded-full bg-white/90 hover:bg-white text-slate-800 shadow-md backdrop-blur-sm transition-all opacity-0 group-hover/img:opacity-100 active:scale-90 cursor-pointer z-10">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                  </button>
                <% end %>

                <%# Dots Indicator %>
                <% if product.images.size > 1 %>
                  <div class="absolute bottom-2.5 inset-x-0 flex justify-center gap-1 z-10 pointer-events-none">
                    <% product.images.each_with_index do |_, idx| %>
                      <span class="h-1 rounded-full transition-all duration-300 shadow-sm <%= idx.zero? ? 'bg-white w-4' : 'bg-white/50 w-1.5' %>"
                            data-product-gallery-target="dot"></span>
                    <% end %>
                  </div>
                <% end %>

              <% else %>
                <div class="flex flex-col items-center justify-center text-slate-300">
                  <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
              <% end %>
            </div>

            <%# Lightbox Modal for this card %>
            <% if product.images.attached? %>
              <div class="fixed inset-0 z-[200] bg-slate-950/95 backdrop-blur-xl hidden items-center justify-center p-4 sm:p-6"
                   data-product-gallery-target="modal"
                   data-action="click->product-gallery#closeLightbox">
                
                <%# Top Controls Bar %>
                <div class="absolute top-4 inset-x-4 sm:inset-x-6 flex items-center justify-between z-20 pointer-events-none">
                  <span class="px-3.5 py-1.5 rounded-full text-xs font-black bg-white/10 text-white backdrop-blur-md"
                        data-product-gallery-target="modalCounter">
                    1 / <%= product.images.size %>
                  </span>

                  <button type="button"
                          data-action="click->product-gallery#closeLightbox"
                          data-close-lightbox="true"
                          class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white backdrop-blur-md transition-all cursor-pointer pointer-events-auto active:scale-90"
                          title="Cerrar (Esc)">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>

                <%# Main Lightbox Image %>
                <div class="relative max-w-5xl max-h-[85vh] w-full h-full flex items-center justify-center pointer-events-auto"
                     data-action="click->event#stopPropagation">
                  <img src=""
                       alt="<%= product.name %>"
                       class="max-w-full max-h-[85vh] w-auto h-auto object-contain rounded-2xl shadow-2xl select-none"
                       data-product-gallery-target="modalImage">

                  <%# Modal Navigation Arrows %>
                  <% if product.images.size > 1 %>
                    <button type="button"
                            data-action="click->product-gallery#prevLightbox"
                            class="absolute left-2 sm:-left-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/15 hover:bg-white/30 text-white backdrop-blur-md shadow-lg transition-all active:scale-90 cursor-pointer">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                    </button>

                    <button type="button"
                            data-action="click->product-gallery#nextLightbox"
                            class="absolute right-2 sm:-right-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/15 hover:bg-white/30 text-white backdrop-blur-md shadow-lg transition-all active:scale-90 cursor-pointer">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# Category & Title %>
            <% if product.category.present? %>
              <p class="text-[10px] font-black text-indigo-600 uppercase tracking-widest mb-1"><%= product.category %></p>
            <% end %>
            <h3 class="text-base sm:text-lg font-black text-slate-900 leading-tight group-hover:text-indigo-600 transition-colors mb-2">
              <%= product.name %>
            </h3>

            <% if product.description.present? %>
              <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed"><%= product.description %></p>
            <% end %>
          </div>

          <%# Price & CTA %>
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
            <div>
              <p class="text-lg font-black text-slate-900">₡<%= number_with_delimiter(product.price.to_i) %></p>
              <p class="text-[10px] font-bold text-slate-400">
                Anticipo 50%: ₡<%= number_with_delimiter(product.deposit_amount.to_i) %>
              </p>
            </div>

            <%= link_to product_path(product), class: "inline-flex items-center justify-center h-10 w-10 sm:h-auto sm:w-auto sm:px-4 sm:py-2.5 bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-200 active:scale-95 shrink-0" do %>
              <span class="hidden sm:inline"><%= t('products.index.view_details') %></span>
              <svg class="w-4 h-4 sm:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="relative bg-white rounded-3xl p-8 sm:p-12 border border-slate-100 shadow-sm text-center max-w-2xl mx-auto overflow-hidden">
      <%# Ambient background decoration %>
      <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-indigo-50/60 blur-2xl pointer-events-none"></div>
      <div class="absolute -bottom-16 -left-16 w-48 h-48 rounded-full bg-slate-50 blur-2xl pointer-events-none"></div>

      <div class="relative z-10 space-y-5">
        <%# Icon Badge %>
        <div class="w-16 h-16 rounded-2xl bg-indigo-50 border border-indigo-100/80 flex items-center justify-center mx-auto text-indigo-600 shadow-xs">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>

        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-indigo-50 text-indigo-700 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
            <%= t('products.index.empty_title') %>
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            <%= t('products.index.empty_state') %>
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-medium max-w-lg mx-auto leading-relaxed">
            <%= t('products.index.empty_subtitle') %>
          </p>
        </div>

        <%# Helpful notice %>
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 text-left max-w-lg mx-auto">
          <p class="text-xs text-slate-500 leading-relaxed">
            <%= t('products.index.empty_hint') %>
          </p>
        </div>

        <%# Back Action %>
        <div class="pt-2">
          <%= link_to root_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white font-black text-xs uppercase tracking-wider rounded-2xl shadow-sm transition-all active:scale-95" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            <span><%= t('products.index.empty_cta') %></span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
