<% content_for :page_title, t('admin.class_schedules.batch_new.title') %>

<div class="w-full py-6 px-4" data-controller="batch-schedule">
  <%# Breadcrumb %>
  <nav class="mb-6 flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
    <%= link_to admin_class_schedules_path, class: "hover:text-indigo-600 transition-colors" do %>
      <%= t('admin.class_schedules.batch_new.back') %>
    <% end %>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
    <span class="text-indigo-600/50"><%= t('admin.class_schedules.batch_new.breadcrumb') %></span>
  </nav>

  <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-8 lg:p-12">
      <header class="mb-12 border-b border-slate-100 pb-8">
        <div class="flex items-center gap-3 mb-2">
          <div class="h-8 w-1.5 bg-indigo-600 rounded-full"></div>
          <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tighter italic">
            <%= t('admin.class_schedules.batch_new.heading') %>
          </h2>
        </div>
        <p class="text-[11px] font-black text-indigo-600 tracking-[0.3em] uppercase ml-4">
          <%= t('admin.class_schedules.batch_new.subtitle') %>
        </p>
      </header>

      <%= form_with url: process_batch_admin_class_schedules_path, method: :post, scope: :class_schedule, class: "space-y-12" do |f| %>
        
        <%# 1. DISCIPLINE SELECTOR %>
        <div class="space-y-5">
          <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
            <%= t('admin.class_schedules.form.select_discipline') %>
          </label>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            <% @class_types.each do |type| %>
              <label class="group relative cursor-pointer">
                <input type="radio" name="class_schedule[class_type_id]" value="<%= type.id %>" class="sr-only peer" required>
                <div class="p-5 rounded-2xl bg-slate-50 border-2 border-transparent transition-all peer-checked:bg-blue-600 peer-checked:border-indigo-400 peer-checked:shadow-lg peer-checked:shadow-indigo-100 group-hover:bg-slate-100 flex flex-col items-center gap-2 text-center h-full justify-center">
                  <span class="text-[11px] font-black text-slate-500 peer-checked:text-white uppercase leading-tight transition-colors">
                    <%= type.name %>
                  </span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

       <%# 2. MODALITY SELECTOR Dropdown %>
        <div class="py-8 border-b border-slate-50">
          <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
            Modalidad de Jiu Jitsu (Gi o No-Gi)
          </label>

          <div class="relative max-w-xs" data-controller="dropdown" data-action="click@window->dropdown#hide">
            <input type="hidden" name="class_schedule[modality]" id="selected_modality" value="no_modality" data-dropdown-target="input">

            <button type="button" 
                    data-action="dropdown#toggle" 
                    class="flex items-center justify-between w-full bg-white border-2 border-slate-100 rounded-2xl py-4 px-6 text-[12px] font-black text-slate-700 uppercase tracking-widest hover:border-indigo-500 transition-all shadow-sm">
              <span data-dropdown-target="label" id="modality_label">Seleccionar Modalidad</span>
              <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <%# Dropdown Modality Menu %>
            <div data-dropdown-target="menu" 
              class="hidden absolute z-30 w-full mt-2 bg-white border-2 border-slate-100 rounded-2xl shadow-xl overflow-hidden animate-in fade-in slide-in-from-top-2 duration-200">
            
              <% ClassSchedule.modalities.each do |name, value| %>
                <button type="button" 
                        data-action="click->dropdown#select"
                        data-value="<%= name %>"
                        data-label="<%= name == 'no_modality' ? 'N/A' : name.upcase %>"
                        class="w-full text-left px-6 py-4 text-[11px] font-black text-slate-600 uppercase tracking-widest hover:bg-indigo-50 hover:text-indigo-700 transition-colors border-b border-slate-50 last:border-0">
                  <%= name == 'no_modality' ? 'N/A' : name.upcase %>
                </button>
              <% end %>
            </div>

          </div>
        </div>

        <%# 3. INSTRUCTOR SELECTOR%>
        <div class="py-8">
          <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] flex items-center gap-2 mb-6">
            <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
            <%= t('admin.class_schedules.form.select_instructor') %>
          </label>
          <div class="flex flex-wrap gap-4">
            <% @instructors.each do |instructor| %>
              <label class="group relative cursor-pointer">
                <input type="radio" name="class_schedule[instructor_id]" value="<%= instructor.id %>" class="sr-only peer" required>
                <div class="flex items-center gap-3 px-5 py-3 rounded-2xl bg-white border-2 border-slate-100 transition-all peer-checked:border-indigo-600 peer-checked:bg-indigo-50 group-hover:bg-slate-50 shadow-sm active:scale-95">
                  <div class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center text-[10px] font-black text-white uppercase peer-checked:bg-indigo-600">
                    <%= instructor.first_name[0] %><%= instructor.last_name.to_s[0] %>
                  </div>
                  <span class="text-[12px] font-black text-slate-700 peer-checked:text-indigo-700 uppercase">
                    <%= instructor.first_name %>
                  </span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# 3. DINAMIC TIME SELECTOR - Con margen superior generoso para que destaque el bloque azul %>
        <%# 4. DINAMIC TIME SELECTOR %>
        <div class="bg-indigo-50/50 p-6 sm:p-8 rounded-[2.5rem] border border-indigo-100/50 space-y-8 mt-4">
          <label class="text-[11px] font-black text-indigo-700 uppercase tracking-[0.2em] block text-center">
            Definir Horarios de Clase
          </label>    
          
          <div data-batch-schedule-target="container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            
            <button type="button" data-action="batch-schedule#add"
                    class="order-last sm:order-first flex items-center justify-center border-2 border-dashed border-indigo-300 rounded-2xl bg-white/50 hover:bg-white hover:border-indigo-600 transition-all group min-h-[64px] shadow-sm">
              <svg class="w-6 h-6 text-indigo-400 group-hover:text-indigo-600 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path d="M12 4v16m8-8H4" />
              </svg>
            </button>

            <div class="time-slot-item">
              <input type="time" name="schedule[times][]" required 
                    class="block w-full bg-white border-2 border-indigo-100 rounded-2xl py-4 px-3 sm:px-4 text-base sm:text-sm font-black text-slate-700 focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all shadow-sm [color-scheme:light]">
            </div>
          </div>
        </div>

        <%# 5. DAY SELECTOR %>
        <div class="space-y-6 mt-6">
          <label class="text-[11px] font-black text-slate-900 uppercase tracking-[0.2em] block text-center">Días de Entrenamiento</label>
          <div class="flex flex-wrap justify-center gap-3">
            <% t('date.day_names').each_with_index do |day_name, index| %>
              <label class="group relative cursor-pointer">
                <input type="checkbox" name="schedule[days][]" value="<%= index %>" class="sr-only peer">
                <div class="w-14 h-14 rounded-2xl bg-white border-2 border-slate-100 flex items-center justify-center transition-all peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 peer-checked:shadow-lg peer-checked:shadow-indigo-100 group-hover:border-slate-300 shadow-sm">
                  <span class="text-xs font-black uppercase tracking-tighter"><%= day_name[0..2] %></span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# 6. CONFIG EXTRA %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pt-10 border-t border-slate-100">
          <div class="space-y-3">
            <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
              <svg class="w-3 h-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Inicia
            </label>
            <input type="date" name="schedule[start_date]" value="<%= @default_start %>" required class="block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3 px-4 text-sm font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm">
          </div>

          <div class="space-y-3">
            <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
              <svg class="w-3 h-3 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Finaliza
            </label>
            <input type="date" name="schedule[end_date]" value="<%= @default_end %>" required class="block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3 px-4 text-sm font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm">
          </div>

          <div class="space-y-3">
            <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
              <svg class="w-3 h-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Duración
            </label>
            <div class="relative">
              <%= f.number_field :duration_minutes, value: 60, class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3 px-4 text-sm font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm" %>
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-[9px] font-black text-slate-400">MIN</span>
            </div>
          </div>

          <div class="space-y-3">
            <label class="text-[10px] font-black text-slate-900 uppercase tracking-widest ml-1 flex items-center gap-2">
              <svg class="w-3 h-3 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
              Cupo
            </label>
            <%= f.number_field :capacity, value: 20, class: "block w-full bg-slate-50 border-2 border-slate-100 rounded-2xl py-3 px-4 text-sm font-black text-slate-700 focus:bg-white focus:border-indigo-500 transition-all shadow-sm" %>
          </div>
        </div>

        <%# Actions Buttons %>
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-12 mt-8 border-t-2 border-slate-50">
          <button type="submit" name="bulk_action" value="destroy" data-turbo-confirm="¿ELIMINAR ESTE LOTE? Las clases y reservas desaparecerán."
                  class="w-full md:w-auto px-10 py-5 bg-white border-2 border-red-100 text-red-500 hover:bg-red-500 hover:text-white hover:border-red-500 rounded-2xl font-black text-[11px] uppercase tracking-[0.2em] transition-all flex items-center justify-center gap-2 group">
            <svg class="w-4 h-4 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Eliminar Programación
          </button>
          <%= f.button type: "submit", 
                       name: "bulk_action", 
                       value: "create",
                       class: "w-full md:w-auto px-12 py-5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-black text-[11px] uppercase tracking-[0.2em] shadow-xl shadow-indigo-200 transition-all cursor-pointer active:scale-95" do %>
            GENERAR PROGRAMACIÓN MASIVA
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Time Slot Template %>
  <template data-batch-schedule-target="template">
    <div class="time-slot-item relative group animate-in slide-in-from-top-2 duration-300">
      <input type="time" name="schedule[times][]" required 
             class="block w-full bg-white border-2 border-indigo-100 rounded-2xl py-4 px-4 text-sm font-black text-slate-700 focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all shadow-sm">
      <button type="button" data-action="batch-schedule#remove"
              class="absolute -top-3 -right-3 bg-slate-900 text-white rounded-full w-7 h-7 flex items-center justify-center shadow-lg opacity-0 group-hover:opacity-100 transition-all hover:bg-red-500">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </template>
</div>