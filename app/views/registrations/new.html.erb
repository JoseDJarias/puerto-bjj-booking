<div class="max-w-md mx-auto">
  <h2 class="mb-2 text-2xl font-black italic text-slate-900 tracking-tighter uppercase"><%= t('auth.sign_up.title') %></h2>
  <p class="mb-8 text-sm text-slate-500 font-medium"><%= t('auth.sign_up.subtitle') %></p>

  <%= form_with model: @user, url: registration_path, novalidate: true, class: "space-y-5" do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-2xl bg-red-50 p-4 border-2 border-red-100 mb-6 w-full overflow-hidden">
        <div class="flex items-start gap-3 mb-2">
          <div class="h-6 w-6 rounded-full bg-red-100 flex-shrink-0 flex items-center justify-center text-red-600 mt-0.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
          </div>
          <h3 class="text-sm font-black text-red-800 uppercase tracking-tight leading-tight">
            <%= t('auth.sign_up.errors.title') %>
          </h3>
        </div>
        <ul class="space-y-1 ml-9 break-words">
          <% @user.errors.full_messages.each do |msg| %>
            <li class="text-xs text-red-700 font-medium leading-relaxed">
              <span class="font-black italic mr-1 text-red-400">•</span> <%= msg %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, t('activerecord.attributes.user.first_name'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
        <%= f.text_field :first_name, placeholder: "Nombre", class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
      </div>
      <div>
        <%= f.label :last_name, t('activerecord.attributes.user.last_name'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
        <%= f.text_field :last_name, placeholder: "Apellido", class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
      </div>
    </div>

    <div>
      <%= f.label :identification, t('activerecord.attributes.user.identification'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
      <%= f.text_field :identification, 
          placeholder: "Cédula o Pasaporte", 
          class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all",
          autocomplete: "off" %>
      <p class="mt-1 text-[10px] text-slate-400 italic">
        * Para extranjeros, ingresar número de pasaporte o ID oficial.
      </p>
    </div>
    <div>
      <%= f.label :email_address, t('auth.sign_up.email_label'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
      <%= f.text_field :email_address, placeholder: t('auth.sign_up.email_placeholder'), inputmode: "email", autocomplete: "email", class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
    </div>

    <div class="space-y-4">
      <div class="w-full">
        <%= f.label :password, t('auth.sign_up.password_label'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
        <div class="flex items-center w-full rounded-xl border border-slate-200 focus-within:ring-4 focus-within:ring-indigo-500/10 focus-within:border-indigo-500 bg-white">
          <%= f.text_field :password, placeholder: "micontra01jj", class: "flex-1 min-w-0 w-full py-3 px-4 text-sm focus:ring-0 focus:outline-none border-0 rounded-l-xl rounded-r-none bg-transparent" %>
        </div>
      </div>
      <div class="w-full">
        <%= f.label :password_confirmation, t('auth.sign_up.password_confirmation_label'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
        <div class="flex items-center w-full rounded-xl border border-slate-200 focus-within:ring-4 focus-within:ring-indigo-500/10 focus-within:border-indigo-500 bg-white">
          <%= f.text_field :password_confirmation, placeholder: "micontra01jj", class: "flex-1 min-w-0 w-full py-3 px-4 text-sm focus:ring-0 focus:outline-none border-0 rounded-l-xl rounded-r-none bg-transparent" %>
        </div>

        <div class="mt-4 bg-slate-50 rounded-2xl p-4 border border-slate-100">
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-indigo-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            
            <div class="flex flex-col gap-1">
              <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 leading-none">
                <%= t('auth.sign_up.security_label') %>
              </span>
              <p class="text-[11px] text-slate-600 font-medium leading-normal">
                <%= t('auth.sign_up.password_hint') %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= f.submit t('auth.sign_up.submit_button'), class: "w-full cursor-pointer rounded-xl bg-indigo-600 px-4 py-4 font-black text-sm text-white uppercase tracking-widest shadow-lg shadow-indigo-100 hover:bg-indigo-700 hover:-translate-y-0.5 transition-all active:scale-95" %>

    <div class="text-center pt-4 border-t border-slate-100">
      <span class="text-xs font-medium text-slate-500"><%= t('auth.sign_up.already_have_account') %></span>
      <%= link_to t('auth.sign_up.sign_in_link'), new_session_path, class: "text-xs font-black text-indigo-600 hover:text-indigo-800 ml-1" %>
    </div>
  <% end %>
</div>