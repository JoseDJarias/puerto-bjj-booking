<% content_for :title, "Solicitar Pedido | Puerto BJJ" %>

<div class="max-w-2xl mx-auto space-y-6">
  <div>
    <%= link_to product_path(@product), class: "inline-flex items-center gap-1.5 text-xs font-black text-slate-400 hover:text-slate-600 uppercase tracking-widest mb-2" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      Volver al producto
    <% end %>
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= t('product_orders.new.title') %></h1>
    <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1"><%= t('product_orders.new.subtitle') %></p>
  </div>

  <%# Product Summary Card %>
  <div class="bg-white rounded-3xl p-5 border border-slate-100 shadow-sm flex items-center gap-4">
    <div class="w-16 h-16 rounded-2xl bg-slate-50 border border-slate-100 overflow-hidden shrink-0 flex items-center justify-center">
      <% if @product.images.attached? %>
        <%= image_tag @product.images.first, class: "w-full h-full object-cover" %>
      <% else %>
        <svg class="w-6 h-6 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
      <% end %>
    </div>
    <div class="flex-1">
      <h3 class="font-extrabold text-slate-900"><%= @product.name %></h3>
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs mt-1">
        <span class="text-slate-500"><%= t('product_orders.new.total_price') %> <strong class="text-slate-800">₡<%= number_with_delimiter(@product.price.to_i) %></strong></span>
        <span class="text-indigo-600"><%= t('product_orders.new.deposit_required', percentage: @product.deposit_percentage) %> <strong>₡<%= number_with_delimiter(@product.deposit_amount.to_i) %></strong></span>
      </div>
    </div>
  </div>

  <%# Payment Instructions Box %>
  <div class="bg-gradient-to-br from-indigo-50 to-slate-50 rounded-3xl p-5 border border-indigo-100/80 shadow-sm space-y-3">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-white">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
      </div>
      <div>
        <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider">Paso 1: Transfiere el anticipo por SINPE Móvil</h4>
      </div>
    </div>

    <div class="p-3.5 bg-white rounded-2xl border border-indigo-100/60 text-xs font-bold text-slate-800 space-y-1.5">
      <div class="flex justify-between items-center">
        <span class="text-slate-400 font-medium">Monto del Anticipo:</span>
        <span class="text-sm font-black text-indigo-600">₡<%= number_with_delimiter(@product.deposit_amount.to_i) %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-slate-400 font-medium">Teléfono SINPE:</span>
        <span class="font-black text-slate-900">7202-6863</span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-slate-400 font-medium">A nombre de:</span>
        <span class="text-slate-800">Kevin Matarrita Lara</span>
      </div>
    </div>
  </div>

  <%# Order Form %>
  <%= form_with model: [@product, @product_order], url: product_product_orders_path(@product), class: "space-y-6", data: { turbo: false } do |f| %>
    <% if @product_order.errors.any? %>
      <div class="rounded-2xl bg-red-50 p-4 border border-red-100 text-red-700 text-sm">
        <p class="font-bold mb-1"><%= t('product_orders.create.error') %></p>
        <ul class="list-disc pl-5 space-y-1 text-xs">
          <% @product_order.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-5">
      <div>
        <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider mb-3">Paso 2: Especificaciones y Comprobante</h4>
      </div>

      <div>
        <%= f.label :user_notes, t('product_orders.new.notes_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
        <%= f.text_area :user_notes, rows: 2, placeholder: t('product_orders.new.notes_placeholder'), class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
      </div>

      <div>
        <%= f.label :payment_receipt, t('product_orders.new.receipt_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-1" %>
        <p class="text-[11px] text-slate-400 font-medium mb-3"><%= t('product_orders.new.receipt_hint') %></p>
        <%= f.file_field :payment_receipt, required: true, accept: "image/*,application/pdf", class: "w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-black file:uppercase file:tracking-wider file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
      </div>

      <%# Terms and Conditions Box %>
      <div class="pt-3 border-t border-slate-100 space-y-3">
        <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider"><%= t('product_orders.new.terms_title') %></h4>
        <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-100 text-xs text-slate-600 leading-relaxed max-h-32 overflow-y-auto overscroll-none">
          <%= t('product_orders.new.terms_body') %>
        </div>

        <label class="flex items-start gap-3 cursor-pointer pt-1">
          <%= f.check_box :terms_accepted, required: true, class: "rounded-lg border-slate-300 text-indigo-600 focus:ring-indigo-500 h-5 w-5 mt-0.5" %>
          <span class="text-xs font-bold text-slate-700 leading-snug"><%= t('product_orders.new.terms_checkbox') %></span>
        </label>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <%= link_to t('product_orders.new.cancel'), product_path(@product), class: "px-5 py-3 rounded-2xl text-xs font-black uppercase tracking-wider text-slate-500 hover:bg-slate-100 transition-all" %>
      <%= f.submit t('product_orders.new.submit_button'), class: "px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-xs font-black uppercase tracking-wider shadow-lg shadow-indigo-100 active:scale-95 transition-all cursor-pointer" %>
    </div>
  <% end %>
</div>
