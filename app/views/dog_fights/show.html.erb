<% content_for :page_title, t('dog_fights.title') %>

<div class="min-h-0">
  <%# Hero — nombre y tagline %>
  <header class="rounded-2xl bg-slate-900 px-6 sm:px-10 py-12 sm:py-16 mb-10 sm:mb-14 text-center">
    <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-4"><%= t('dog_fights.badge') %></p>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">
      <%= t('dog_fights.name') %>
    </h1>
    <p class="text-slate-300 text-lg sm:text-xl max-w-2xl mx-auto"><%= t('dog_fights.tagline') %></p>
  </header>

  <%# Puntos clave — grid de features %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-12 sm:mb-16">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 text-amber-700 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
      </span>
      <h2 class="text-lg font-semibold text-slate-900 mb-2"><%= t('dog_fights.everyone_can_enter') %></h2>
      <p class="text-slate-600 text-sm sm:text-base"><%= t('dog_fights.everyone_can_enter_desc') %></p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 text-amber-700 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </span>
      <h2 class="text-lg font-semibold text-slate-900 mb-2"><%= t('dog_fights.pay_fee') %></h2>
      <p class="text-slate-600 text-sm sm:text-base"><%= t('dog_fights.pay_fee_desc') %></p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 sm:col-span-2 lg:col-span-1">
      <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 text-amber-700 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
      </span>
      <h2 class="text-lg font-semibold text-slate-900 mb-2"><%= t('dog_fights.winner_takes_all') %></h2>
      <p class="text-slate-600 text-sm sm:text-base"><%= t('dog_fights.winner_takes_all_desc') %></p>
    </div>
  </div>

  <%# No rules + ADCC — dos bloques destacados %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16">
    <div class="rounded-2xl bg-slate-800 px-6 sm:px-8 py-8 sm:py-10 text-white">
      <h3 class="text-xl font-bold mb-2"><%= t('dog_fights.no_rules') %></h3>
      <p class="text-slate-300 text-sm sm:text-base"><%= t('dog_fights.no_rules_desc') %></p>
    </div>
    <div class="rounded-2xl bg-slate-800 px-6 sm:px-8 py-8 sm:py-10 text-white">
      <h3 class="text-xl font-bold mb-2"><%= t('dog_fights.adcc_style') %></h3>
      <p class="text-slate-300 text-sm sm:text-base"><%= t('dog_fights.adcc_style_desc') %></p>
    </div>
  </div>

  <%# CTA Próximamente %>
  <div class="rounded-2xl border-2 border-dashed border-amber-400 bg-amber-50 px-6 sm:px-10 py-10 sm:py-14 text-center">
    <p class="text-amber-800 text-lg sm:text-xl font-semibold mb-2"><%= t('dog_fights.coming_soon') %></p>
    <p class="text-amber-700/90 text-sm sm:text-base max-w-md mx-auto"><%= t('dog_fights.coming_soon_desc') %></p>
  </div>
</div>