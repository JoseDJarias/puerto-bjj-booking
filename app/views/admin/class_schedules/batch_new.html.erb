<%# app/views/admin/class_schedules/batch_new.html.erb %>
<% content_for :page_title, t('admin.class_schedules.batch_new.title') %>

<div class="mx-auto max-w-4xl py-10 px-4">
  <%# Breadcrumb %>
  <nav class="mb-8 flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-500">
    <%= link_to admin_class_schedules_path, class: "hover:text-indigo-500 transition-colors" do %>
      <%= t('admin.class_schedules.batch_new.back') %>
    <% end %>
    <svg class="w-3 h-3 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
    <span class="text-indigo-600"><%= t('admin.class_schedules.batch_new.breadcrumb') %></span>
  </nav>

  <div class="bg-slate-900 rounded-[3rem] shadow-2xl overflow-hidden border border-slate-800">
    <div class="p-8 lg:p-12">
      <header class="mb-12">
        <h2 class="text-4xl font-black text-white italic uppercase tracking-tighter leading-none mb-3">
          <%= t('admin.class_schedules.batch_new.heading') %><br>
          <span class="text-indigo-500 text-lg tracking-widest not-italic font-bold"><%= t('admin.class_schedules.batch_new.subtitle') %></span>
        </h2>
      </header>

      <%= form_with url: process_batch_admin_class_schedules_path, method: :post, scope: :class_schedule, class: "space-y-10" do |f| %>
        
        <%# 1. Discipline and Instructor %>
        <%# 1. DISCIPLINE SELECTOR (Visual Cards) %>
        <div class="space-y-4">
          <label class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] ml-1">
            <%= t('admin.class_schedules.form.select_discipline') %>
          </label>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <% @class_types.each do |type| %>
              <label class="group relative cursor-pointer">
                <input type="radio" name="class_schedule[class_type_id]" value="<%= type.id %>" class="sr-only peer" required>
                <div class="p-4 rounded-3xl bg-slate-800 border-2 border-slate-700 transition-all duration-300 peer-checked:bg-indigo-600 peer-checked:border-indigo-400 peer-checked:shadow-[0_0_20px_rgba(79,70,229,0.2)] group-hover:border-slate-500 flex flex-col items-center gap-2 text-center h-full justify-center">
                  <span class="text-xs font-black text-slate-300 peer-checked:text-white uppercase leading-tight">
                    <%= type.name %>
                  </span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# 2. INSTRUCTOR SELECTOR (Circular Avatars/Initials) %>
        <div class="space-y-4 mt-8">
          <label class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] ml-1">
            <%= t('admin.class_schedules.form.select_instructor') %>
          </label>
          <div class="flex flex-wrap gap-4">
            <% @instructors.each do |instructor| %>
              <label class="group relative cursor-pointer">
                <input type="radio" name="class_schedule[instructor_id]" value="<%= instructor.id %>" class="sr-only peer" required>
                <div class="flex items-center gap-3 px-5 py-3 rounded-2xl bg-slate-800 border-2 border-slate-700 transition-all duration-300 peer-checked:bg-slate-700 peer-checked:border-indigo-500 group-hover:border-slate-500">
                  <div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-[10px] font-black text-white uppercase">
                    <%= instructor.first_name[0] %><%= instructor.last_name.to_s[0] %>
                  </div>
                  <span class="text-xs font-bold text-slate-300 peer-checked:text-white uppercase">
                    <%= instructor.first_name %>
                  </span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# 2. Day Selector %>
        <div class="bg-slate-800/50 p-8 rounded-[2rem] border border-slate-700/50">
          <label class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] block mb-6 text-center"><%= t('admin.class_schedules.form.days_label') %></label>
          <div class="flex flex-wrap justify-center gap-3">
            <% days = t('date.day_names') %>
            <% days.each_with_index do |day_name, index| %>
              <label class="group relative cursor-pointer">
                <input type="checkbox" name="schedule[days][]" value="<%= index %>" class="sr-only peer">
                <div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-slate-800 border-2 border-slate-700 flex items-center justify-center transition-all duration-300 peer-checked:bg-indigo-600 peer-checked:border-indigo-400 peer-checked:shadow-[0_0_20px_rgba(79,70,229,0.3)] group-hover:border-slate-500">
                  <span class="text-xs font-black text-slate-400 peer-checked:text-white uppercase"><%= day_name[0..2] %></span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <%# 3. Time and Range %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-2">
            <label class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1"><%= t('admin.class_schedules.form.start_time') %></label>
            <input type="time" name="schedule[time]" required class="block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 transition-all [color-scheme:dark]">
          </div>
          
          <div class="space-y-2">
            <label class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1"><%= t('admin.class_schedules.form.start_date') %></label>
            <input type="date" name="schedule[start_date]" value="<%= @default_start %>" required class="block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 transition-all [color-scheme:dark]">
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1"><%= t('admin.class_schedules.form.end_date') %></label>
            <input type="date" name="schedule[end_date]" value="<%= @default_end %>" required class="block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 transition-all [color-scheme:dark]">
          </div>
        </div>

        <%# 4. Capacity and Duration %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-2">
            <%= f.label :duration_minutes, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
            <div class="relative group">
              <%= f.number_field :duration_minutes, value: 60, class: "block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 transition-all" %>
              <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
                <span class="text-[10px] font-black text-slate-500 uppercase"><%= t('admin.class_schedules.form.duration_unit') %></span>
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <%= f.label :capacity, class: "text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1" %>
            <%= f.number_field :capacity, value: 20, class: "block w-full bg-slate-800 border-slate-700 rounded-2xl py-4 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-indigo-500 transition-all" %>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-10 border-t border-slate-800/50 mt-10">
          <%# Botón de ELIMINACIÓN MASIVA (Izquierda) %>
          <button type="submit" 
                  name="bulk_action" 
                  value="destroy" 
                  data-turbo-confirm="¿ESTÁS SEGURO? Esta acción eliminará TODAS las clases que coincidan con estos días, horas y rango de fechas, incluyendo sus reservas."
                  class="w-full md:w-auto px-8 py-5 bg-red-500/10 hover:bg-red-600 border border-red-500/20 text-red-500 hover:text-white rounded-2xl font-black text-xs uppercase tracking-[0.2em] transition-all active:scale-95 flex items-center justify-center gap-3 group">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <%= t('admin.class_schedules.form.destroy_batch') %>
          </button>

          <%# Botón de CREACIÓN MASIVA (Derecha) %>
          <%= f.submit t('admin.class_schedules.form.submit_batch'), 
              name: "bulk_action", 
              value: "create",
              class: "w-full md:w-auto px-12 py-5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-2xl font-black text-xs uppercase tracking-[0.2em] shadow-xl shadow-indigo-500/20 transition-all active:scale-95 cursor-pointer" %>
        </div>
      
      <% end %>
    </div>
  </div>
</div>