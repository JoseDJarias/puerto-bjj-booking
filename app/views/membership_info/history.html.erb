<%# app/views/my_memberships/history.html.erb %>
<div class="w-full mx-auto px-2 py-2">
  
  <%# Back Button %>
  <div class="mb-4">
    <%= link_to my_membership_path, class: "group inline-flex items-center gap-3 py-2 text-slate-400 hover:text-indigo-600 transition-all" do %>
      <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center group-hover:bg-indigo-50 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </div>
      <span class="text-[10px] font-black uppercase tracking-[0.2em]"><%= t('my_membership.history.back') %></span>
    <% end %>
  </div>

  <%# Main Title %>
  <header class="mb-6">
    <h1 class="text-3xl font-black text-slate-900 leading-[0.9] tracking-tighter italic uppercase mb-4">
      <%= t('my_membership.history.title').gsub(' ', '<br>').html_safe %>
    </h1>
    <p class="text-sm font-bold text-slate-400 leading-tight border-l-4 border-slate-100 pl-4 italic">
      <%= t('my_membership.history.subtitle') %>
    </p>
  </header>

  <%# Previous Memberships Section %>
  <section class="mb-16">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="text-[11px] font-black text-indigo-600/50 uppercase tracking-[0.25em] whitespace-nowrap">
        <%= t('my_membership.history.memberships_heading') %>
      </h2>
      <div class="h-[2px] bg-slate-50 flex-1"></div>
    </div>

    <% if @past_memberships.any? %>
      <div class="space-y-6">
        <% @past_memberships.each do |m| %>
          <div class="relative bg-white rounded-[2.5rem] border-2 border-slate-50 p-7 shadow-sm overflow-hidden">
            <div class="absolute top-0 right-0 p-4">
               <span class="text-[9px] font-black px-3 py-1 bg-slate-100 text-slate-500 rounded-full uppercase tracking-widest">
                <%= t("my_membership.history.membership_status.#{m.status}") %>
              </span>
            </div>

            <div class="mb-6">
              <p class="text-2xl font-black text-slate-900 uppercase italic tracking-tighter leading-none mb-1">
                <%= m.membership_package.name %>
              </p>
              <p class="text-xs font-bold text-indigo-500 uppercase tracking-tight">
                <%= m.membership_plan.display_name %>
              </p>
            </div>
            
            <div class="grid grid-cols-2 gap-y-6 border-t border-slate-50 pt-6">
              <div class="space-y-1">
                <p class="text-[9px] font-black text-slate-300 uppercase tracking-widest"><%= t('my_membership.start_date') %></p>
                <p class="text-sm font-black text-slate-700 uppercase italic"><%= l(m.start_date, format: "%d %b %y") %></p>
              </div>
              <div class="space-y-1">
                <p class="text-[9px] font-black text-slate-300 uppercase tracking-widest"><%= t('my_membership.end_date') %></p>
                <p class="text-sm font-black text-slate-700 uppercase italic"><%= l(m.end_date, format: "%d %b %y") %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
     
    <% end %>
  </section>

  <%# Tickets Drop-in Section %>
  <div class="py-12 px-6 rounded-[2rem] bg-slate-50 border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center shadow-inner">
      <div class="w-14 h-14 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 mb-4 shadow-sm">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <p class="text-[11px] font-black text-slate-500 uppercase tracking-[0.15em] italic max-w-[200px] leading-relaxed">
        <%= t('my_membership.history.no_memberships') %>
      </p>
  </div>
  <section>
    <div class="flex items-center gap-4 mt-6 mb-6">
      <h2 class="text-[11px] font-black text-indigo-600/50 uppercase tracking-[0.25em] whitespace-nowrap">
        <%= t('my_membership.history.drop_in_heading') %>
      </h2>
      <div class="h-[1.5px] bg-slate-100 flex-1"></div>
    </div>

    <% if @drop_in_history.any? %>
      <div class="grid gap-4">
        <% @drop_in_history.each do |ticket| %>
          <div class="bg-slate-50/50 rounded-3xl p-5 flex items-center justify-between border border-transparent hover:border-slate-100 transition-all">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-2xl bg-white shadow-sm flex items-center justify-center text-slate-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-black text-slate-800 uppercase italic leading-none mb-1">
                  <%= ticket.used_at ? l(ticket.used_at.to_date, format: :long) : l(ticket.updated_at.to_date, format: :short) %>
                </p>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">
                  <%= t("my_membership.history.drop_in_status.#{ticket.status}") %>
                </p>
              </div>
            </div>
            <% if ticket.price_paid.to_f.positive? %>
              <p class="text-sm font-black text-slate-900 italic"><%= number_to_currency(ticket.price_paid, precision: 0) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-12 px-6 rounded-[2rem] bg-slate-50 border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center shadow-inner">
        <div class="w-14 h-14 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 mb-4 shadow-sm">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>
        <p class="text-[11px] font-black text-slate-500 uppercase tracking-[0.15em] italic max-w-[200px] leading-relaxed">
          <%= t('my_membership.history.no_drop_ins') %>
        </p>
      </div>
    <% end %>
  </section>
</div>