<tr class="group hover:bg-indigo-50/30 transition-colors">
  <td class="px-4 py-4 whitespace-nowrap">
    <div class="flex items-center">
      <div class="h-9 w-9 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-xs ring-1 ring-indigo-200">
        <%= membership.user.first_name&.first %>
      </div>
      <div class="ml-3">
        <div class="text-sm font-bold text-slate-900"><%= membership.user.first_name %> <%= membership.user.last_name %></div>
      </div>
    </div>
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <span class="text-sm text-slate-700 font-medium"><%= membership.membership_plan.name %></span>
    <span class="block text-[10px] text-slate-400"><%= membership.membership_package.name %></span>
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <div class="flex flex-col">
      <span class="text-sm <%= membership.current? ? 'text-slate-900 font-semibold' : 'text-red-500 font-medium' %>">
        <%= l(membership.end_date, format: :short) %>
      </span>
      <% if membership.current? %>
        <span class="text-[10px] text-green-600 font-bold"><%= t("admin.memberships.index.days_left", count: membership.days_remaining) %></span>
      <% end %>
    </div>
  </td>
  <td class="px-4 py-4 text-center">
    <%= link_to t("admin.common.edit"), edit_admin_membership_path(membership), class: "text-indigo-600 hover:text-indigo-900 font-bold text-sm" %>
  </td>
  <td class="px-4 py-4 text-center">
    <%= link_to t("admin.common.delete"), admin_membership_path(membership), method: :delete, data: { turbo_method: :delete, turbo_confirm: t("admin.common.delete_confirm") }, class: "text-red-600 hover:text-red-900 font-bold text-sm" %>
  </td>
</tr>