<% content_for :page_title, t('admin.class_schedules.edit.page_title') %>

<div class="mx-auto max-w-2xl">
  <div class="mb-6 flex items-center gap-2 text-sm text-slate-500">
    <%= link_to t('admin.class_schedules.edit.breadcrumb_calendar'), admin_class_schedules_path, class: "hover:text-indigo-600" %>
    <span>/</span>
    <%= link_to t('admin.class_schedules.edit.breadcrumb_detail'), admin_class_schedule_path(@class_schedule), class: "hover:text-indigo-600" %>
    <span>/</span>
    <span class="text-slate-900 font-medium"><%= t('admin.class_schedules.edit.breadcrumb_edit') %></span>
  </div>

  <div class="bg-white p-6 shadow-sm rounded-xl border border-slate-200">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-slate-900"><%= t('admin.class_schedules.edit.title') %></h2>
      
      <%= button_to admin_class_schedule_path(@class_schedule), method: :delete, data: { turbo_confirm: t('admin.class_schedules.edit.delete_confirm') }, class: "text-sm text-red-600 hover:text-red-800 font-medium" do %>
        <%= t('admin.class_schedules.edit.delete_class') %>
      <% end %>
    </div>
    
    <%= render "form", class_schedule: @class_schedule %>
  </div>
</div>