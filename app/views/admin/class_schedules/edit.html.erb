<%# app/views/admin/class_schedules/edit.html.erb %>
<% content_for :page_title, t('admin.class_schedules.edit.page_title') %>

<div class="mx-auto max-w-4xl py-10 px-4">
  <%# Breadcrumbs %>
  <nav class="mb-8 flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-500">
    <%= link_to admin_class_schedules_path, class: "hover:text-indigo-500 transition-colors" do %>
      <%= t('admin.class_schedules.edit.breadcrumb_calendar') %>
    <% end %>
    <svg class="w-3 h-3 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
    <%= link_to admin_class_schedule_path(@class_schedule), class: "hover:text-indigo-500 transition-colors" do %>
      <%= t('admin.class_schedules.edit.breadcrumb_detail') %>
    <% end %>
    <svg class="w-3 h-3 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 5l7 7-7 7" stroke-width="3"/></svg>
    <span class="text-indigo-600"><%= t('admin.class_schedules.edit.breadcrumb_edit') %></span>
  </nav>

  <div class="bg-slate-900 rounded-[3rem] shadow-2xl overflow-hidden border border-slate-800">
    <div class="p-8 lg:p-12">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
        <div>
          <h2 class="text-4xl font-black text-white italic uppercase tracking-tighter leading-none">
            <%= t('admin.class_schedules.edit.title') %><br>
            <span class="text-indigo-500 text-lg tracking-widest not-italic font-bold">Modificar Sesión</span>
          </h2>
        </div>
        
        <%= button_to admin_class_schedule_path(@class_schedule), 
                      method: :delete, 
                      data: { turbo_confirm: t('admin.class_schedules.edit.delete_confirm') }, 
                      class: "group flex items-center gap-2 px-5 py-2.5 bg-red-500/10 hover:bg-red-500 rounded-2xl text-red-500 hover:text-white border border-red-500/20 transition-all duration-300" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-4v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-width="2"/></svg>
          <span class="text-xs font-black uppercase tracking-widest"><%= t('admin.class_schedules.edit.delete_class') %></span>
        <% end %>
      </div>
      
      <%= render "admin/class_schedules/partials/form", class_schedule: @class_schedule %>
    </div>
  </div>
</div>