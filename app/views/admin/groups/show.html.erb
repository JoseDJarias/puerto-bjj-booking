<div class="max-w-6xl mx-auto space-y-6">
  <div class="flex items-center gap-4">
    <%= link_to admin_groups_path, class: "text-slate-400 hover:text-slate-600 transition" do %>
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <div>
      <h1 class="text-3xl font-black italic tracking-tighter uppercase text-slate-900"><%= @group.name %></h1>
      <p class="text-slate-500 text-sm"><%= @group.description %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Chat Section -->
    <div class="lg:col-span-2 h-[calc(100vh-14rem)] flex flex-col bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          <%= t("admin.groups.chat") %>
        </h2>
      </div>

      <%= turbo_stream_from "group_#{@group.id}_messages" %>
      
      <div class="flex-1 overflow-y-auto p-6 space-y-4" id="group_<%= @group.id %>_messages_list">
        <% if @messages.any? %>
          <%= render partial: "messages/message", collection: @messages, as: :message %>
        <% else %>
          <div class="h-full flex items-center justify-center text-slate-400 italic" id="empty_chat_message">
            Aún no hay mensajes.
          </div>
        <% end %>
      </div>

      <div class="p-4 border-t border-slate-100 bg-white">
        <%= form_with model: [:admin, @group, Message.new], class: "flex flex-col gap-3", data: { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" } do |f| %>
          
          <div class="flex gap-2 items-center">
            <div class="relative flex-1">
              <%= f.text_field :content, class: "w-full rounded-full border-slate-200 bg-slate-50 px-4 py-3 focus:ring-indigo-500 focus:border-indigo-500 pr-12", placeholder: t("groups.show.type_message"), required: true, autocomplete: "off" %>
              
              <!-- Attachment Button -->
              <label class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 cursor-pointer transition p-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                <%= f.file_field :attachments, multiple: true, class: "hidden", accept: "image/*, .pdf, .doc, .docx" %>
              </label>
            </div>
            
            <%= f.submit t("groups.show.send"), class: "bg-indigo-600 text-white font-bold px-6 py-3 rounded-full hover:bg-indigo-700 transition cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Members Management Section -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 flex flex-col shadow-sm max-h-[calc(100vh-14rem)]">
      <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        <%= t("admin.groups.members") %>
      </h2>

      <div class="mb-6">
        <%= form_with url: admin_group_group_memberships_path(@group), class: "flex flex-col gap-2" do |f| %>
          <%= f.collection_select :user_id, @users, :id, :display_name, { prompt: "Seleccionar usuario..." }, { class: "w-full rounded-xl border-slate-200 focus:ring-indigo-500 focus:border-indigo-500 text-sm", required: true } %>
          <%= f.submit t("admin.groups.invite"), class: "w-full bg-slate-900 text-white font-bold py-2 rounded-xl hover:bg-slate-800 transition text-sm cursor-pointer" %>
        <% end %>
      </div>

      <div class="flex-1 overflow-y-auto pr-2 space-y-3">
        <% @group.group_memberships.includes(:user).each do |membership| %>
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div>
              <p class="font-bold text-sm text-slate-800"><%= membership.user.display_name %></p>
              <p class="text-[10px] uppercase font-bold tracking-widest <%= membership.accepted? ? 'text-green-600' : (membership.invited? ? 'text-amber-500' : 'text-red-500') %>">
                <%= membership.status %>
              </p>
            </div>
            
            <%= button_to admin_group_group_membership_path(@group, membership), method: :delete, form: { data: { turbo_confirm: "¿Estás seguro?" } }, class: "text-slate-400 hover:text-red-600 transition p-1" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            <% end %>
          </div>
        <% end %>

        <% if @group.group_memberships.empty? %>
          <p class="text-sm text-slate-500 text-center italic mt-4"><%= t("admin.groups.no_members") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
