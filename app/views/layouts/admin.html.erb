<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:page_title) || t('admin.layout.title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-900">
    
    <div class="flex min-h-screen relative" data-controller="sidebar">

      <aside data-sidebar-target="sidebar" 
             class="fixed inset-y-0 left-0 z-50 w-64 transform bg-white shadow-xl transition-transform duration-300 ease-in-out lg:relative lg:translate-x-0 -translate-x-full flex flex-col">
        
        <div class="flex h-16 items-center justify-between border-b border-slate-100 px-6">
          <span class="text-lg font-bold text-slate-900"><%= t('admin.layout.brand') %></span>
          <button type="button" data-action="click->sidebar#close" class="lg:hidden text-slate-500 hover:text-slate-700">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <nav class="flex-1 overflow-y-auto px-4 py-6 space-y-1">
          
          <%= link_to admin_root_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_root_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span><%= t('admin.layout.home') %></span>
          <% end %>

          <div class="pt-4 pb-1 px-3">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Gestión</p>
          </div>

          <%= link_to admin_users_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_users_path) || request.path.include?('/users') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <span><%= t('admin.users.index.title') %></span>
          <% end %>

          <%= link_to admin_memberships_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_memberships_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
            <span><%= t('admin.memberships.index.title') %></span>
          <% end %>

          <div class="pt-4 pb-1 px-3">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Configuración</p>
          </div>

          <%= link_to admin_membership_plans_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_membership_plans_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span><%= t('admin.layout.plans') %></span>
          <% end %>
          
          <%= link_to admin_class_types_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_class_types_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}" do %>
             <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
             <span><%= t('admin.class_types.index.title') %></span>
          <% end %>

          <%= link_to admin_membership_packages_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium #{current_page?(admin_membership_packages_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}" do %>
             <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
             <span><%= t('admin.packages.index.title') %></span>
          <% end %>

        </nav>
        
        <div class="border-t border-slate-100 p-4">
           <%= link_to t('admin.layout.close_menu'), root_path, class: "flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:bg-slate-100 hover:text-slate-900" %>
        </div>
      </aside>

      <div data-sidebar-target="overlay" 
           data-action="click->sidebar#close" 
           class="fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden">
      </div>

      <div class="flex flex-1 flex-col overflow-hidden">
        
        <header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b border-slate-200 bg-white px-4 lg:hidden">
          <button type="button" data-action="click->sidebar#open" class="-ml-2 p-2 text-slate-500 hover:bg-slate-100 rounded-md">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <h1 class="text-lg font-semibold text-slate-900"><%= content_for(:page_title) %></h1>
        </header>

        <main class="flex-1 overflow-auto bg-slate-50 p-4 sm:p-6 lg:p-8">
          <div class="mx-auto max-w-6xl">
            <% if flash[:notice] %>
              <div class="mb-6 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200 flex items-center gap-2">
                <svg class="h-5 w-5 text-green-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <%= flash[:notice] %>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="mb-6 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200 flex items-center gap-2">
                 <svg class="h-5 w-5 text-red-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                <%= flash[:alert] %>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </main>
      </div>

    </div>
  </body>
</html>