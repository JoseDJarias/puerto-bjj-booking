<section class="space-y-8 overflow-x-hidden" aria-labelledby="expired-heading">
    <div class="rounded-2xl bg-white p-8 shadow-sm border border-slate-200">
        <h2 id="expired-heading" class="text-xl font-semibold text-slate-900">
            <%= t('dashboard.membership_expired.title') %>
        </h2>
        <p class="mt-2 text-slate-600">
            <%= t('dashboard.membership_expired.message') %>
        </p>
    </div>

    <div class="grid gap-4 md:gap-6 w-full min-w-0 max-w-full" style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));">
        <% packages.each do |package| %>
            <% available_plans = plans.select { |p| package.valid_plan?(p) } %>
            <% next if available_plans.empty? %>
            <% min_price = package.lowest_price(plans) %>

          <div 
            data-controller="accordion" 
            data-accordion-target="card"
            class="flex flex-col rounded-xl bg-white shadow-sm border border-slate-200 overflow-hidden transition-all duration-300 min-w-0"
          >
            <div 
              data-action="click->accordion#toggle" 
              class="
                cursor-pointer lg:cursor-default 
                p-5 border-b border-slate-100 flex-1 bg-white relative select-none group
                transition-colors duration-200 ease-in-out
                active:bg-slate-50 active:scale-[0.99] lg:active:scale-100 lg:active:bg-white
              "
            >
              <div class="flex justify-between items-start gap-4 min-w-0">
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors break-words">
                    <%= package.name %>
                  </h3>
                  <p class="mt-1 text-sm text-slate-500 hidden lg:block">
                    <%= package.description %>
                  </p>
                  <% if min_price %>
                    <div class="mt-3 lg:hidden">
                      <span class="inline-flex items-center gap-1 rounded-lg bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                        <%= t("dashboard.plans.prices_from", price: number_to_currency(min_price, precision: 0)) %>
                      </span>
                    </div>
                  <% end %>
                </div>
                <div 
                  data-accordion-target="icon" 
                  class="lg:hidden text-slate-400 mt-1 transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"
                >
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
              <div class="mt-3 hidden lg:flex flex-wrap gap-2">
                <% package.class_types.each do |class_type| %>
                  <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-[10px] font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">
                    <%= class_type.name %>
                  </span>
                <% end %>
              </div>
            </div>
            <div 
              data-accordion-target="wrapper"
              class="grid grid-rows-[0fr] opacity-0 lg:grid-rows-[1fr] lg:opacity-100 transition-[grid-template-rows,opacity] duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"
            >
              <div class="overflow-hidden min-w-0">
                <div class="bg-slate-50/50 px-5 pt-5 pb-6 space-y-4 border-t border-slate-200 min-w-0 rounded-b-xl">
                  <div class="lg:hidden mb-4">
                    <p class="text-sm text-slate-500 mb-3"><%= package.description %></p>
                    <div class="flex flex-wrap gap-2">
                      <% package.class_types.each do |class_type| %>
                        <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                          <%= class_type.name %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <% recurring_plans = available_plans.select { |p| p.duration_months > 0 } %>
                  <% if recurring_plans.any? %>
                    <div>
                      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                        <%= t('dashboard.plans.recurring_title', default: "Suscripciones") %>
                      </p>
                      <div class="space-y-2">
                        <% recurring_plans.each do |plan| %>
                          <%= render "dashboard/states/price_row", plan: plan, package: package %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <% drop_in_plans = available_plans.select { |p| p.duration_months == 0 } %>
                  <% if drop_in_plans.any? %>
                    <% if recurring_plans.any? %> <div class="border-t border-slate-200 my-2"></div> <% end %>
                    <div>
                      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                        <%= t('dashboard.plans.drop_in_title', default: "Pases por día") %>
                      </p>
                      <div class="space-y-2">
                        <% drop_in_plans.each do |plan| %>
                          <%= render "dashboard/states/price_row", plan: plan, package: package %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                  <div class="mt-4 flex items-center gap-2 text-[10px] text-slate-400 justify-center border-t border-slate-200 pt-3">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <%= t('dashboard.plans.payment_info') %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
    </div>
</section>