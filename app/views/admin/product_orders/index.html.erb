<% content_for :page_title, t('admin.product_orders.index.title') %>

<div class="mb-6">
  <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= t('admin.product_orders.index.title') %></h1>
  <p class="text-xs font-semibold text-slate-500 mt-1"><%= t('admin.product_orders.index.subtitle') %></p>
</div>

<%# Filter Tabs %>
<div class="flex overflow-x-auto pb-2 mb-6 gap-2 border-b border-slate-200">
  <% tabs = [
    { key: nil, label: t('admin.product_orders.index.tabs.all') },
    { key: 'pending_verification', label: t('admin.product_orders.index.tabs.pending') },
    { key: 'payment_confirmed', label: t('admin.product_orders.index.tabs.confirmed') },
    { key: 'ordered_from_supplier', label: t('admin.product_orders.index.tabs.ordered') },
    { key: 'ready_for_pickup', label: t('admin.product_orders.index.tabs.ready') },
    { key: 'delivered', label: t('admin.product_orders.index.tabs.delivered') }
  ] %>

  <% tabs.each do |tab| %>
    <% is_active = (params[:status] == tab[:key]) || (params[:status].blank? && tab[:key].nil?) %>
    <%= link_to admin_product_orders_path(status: tab[:key]), class: "px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider whitespace-nowrap transition-all #{is_active ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-500 hover:bg-slate-100'}" do %>
      <%= tab[:label] %>
    <% end %>
  <% end %>
</div>

<% if @orders.any? %>
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100">
          <tr>
            <th class="py-4 px-6"><%= t('admin.product_orders.index.table.order') %></th>
            <th class="py-4 px-6"><%= t('admin.product_orders.index.table.student') %></th>
            <th class="py-4 px-6"><%= t('admin.product_orders.index.table.product') %></th>
            <th class="py-4 px-6"><%= t('admin.product_orders.index.table.deposit') %></th>
            <th class="py-4 px-6"><%= t('admin.product_orders.index.table.status') %></th>
            <th class="py-4 px-6"><%= t('admin.product_orders.index.table.receipt') %></th>
            <th class="py-4 px-6 text-right"><%= t('admin.product_orders.index.table.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @orders.each do |order| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="py-4 px-6">
                <span class="font-black text-slate-900">#<%= order.id %></span>
                <p class="text-[10px] text-slate-400 font-semibold"><%= l(order.created_at.in_time_zone("America/Costa_Rica"), format: "%d/%m/%Y") %></p>
              </td>
              <td class="py-4 px-6">
                <p class="font-bold text-slate-800"><%= order.user.first_name %> <%= order.user.last_name %></p>
                <p class="text-[11px] text-slate-400"><%= order.user.email_address %></p>
              </td>
              <td class="py-4 px-6">
                <p class="font-bold text-slate-800"><%= order.product_name %></p>
                <% if order.user_notes.present? %>
                  <p class="text-xs text-slate-500 italic truncate max-w-xs"><%= order.user_notes %></p>
                <% end %>
              </td>
              <td class="py-4 px-6">
                <span class="font-black text-slate-900">₡<%= number_with_delimiter(order.deposit_amount.to_i) %></span>
                <p class="text-[10px] text-slate-400">Total: ₡<%= number_with_delimiter(order.product_price.to_i) %></p>
              </td>
              <td class="py-4 px-6">
                <% status_classes = case order.status
                   when "pending_verification" then "bg-amber-50 text-amber-700 border-amber-200"
                   when "payment_confirmed" then "bg-indigo-50 text-indigo-700 border-indigo-200"
                   when "ordered_from_supplier" then "bg-blue-50 text-blue-700 border-blue-200"
                   when "ready_for_pickup" then "bg-green-50 text-green-700 border-green-200"
                   when "delivered" then "bg-slate-100 text-slate-700 border-slate-200"
                   else "bg-red-50 text-red-700 border-red-200"
                   end %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider border <%= status_classes %>">
                  <%= t("product_orders.status.#{order.status}") %>
                </span>
              </td>
              <td class="py-4 px-6">
                <% if order.payment_receipt.attached? %>
                  <%= link_to url_for(order.payment_receipt), target: "_blank", class: "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 transition-colors" do %>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    Ver SINPE
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-400">Sin archivo</span>
                <% end %>
              </td>
              <td class="py-4 px-6 text-right">
                <%= link_to admin_product_order_path(order), class: "inline-flex items-center gap-1 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-colors" do %>
                  <span>Gestionar</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-3xl p-12 border border-slate-100 shadow-sm text-center">
    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
    </div>
    <p class="text-sm font-bold text-slate-700"><%= t('admin.product_orders.index.empty_state') %></p>
  </div>
<% end %>
