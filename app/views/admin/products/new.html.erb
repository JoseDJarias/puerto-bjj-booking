<% content_for :page_title, "Nuevo Producto | Admin" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to admin_products_path, class: "inline-flex items-center gap-1.5 text-xs font-black text-slate-400 hover:text-slate-600 uppercase tracking-widest mb-2" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      Volver al catálogo
    <% end %>
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Nuevo Producto</h1>
  </div>

  <%= render "form", product: @product %>
</div>
