<article class="mx-auto w-full max-w-2xl px-4 py-8">
  <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold text-slate-900">
      <%= t('auth.branding.title') %>
    </h1>
    <%= button_to t('dashboard.sign_out'),
          session_path,
          method: :delete,
          class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  </header>

  <% if @user.pending_approval? %>
    <section class="rounded-2xl bg-white p-8 shadow-lg ring-1 ring-slate-900/5" aria-labelledby="pending-heading">
      <h2 id="pending-heading" class="mb-4 text-xl font-semibold text-slate-900">
        <%= t('dashboard.pending_approval.title') %>
      </h2>
      <p class="mb-4 text-slate-600">
        <%= t('dashboard.pending_approval.message') %>
      </p>
      <p class="text-sm text-slate-500">
        <%= t('dashboard.pending_approval.hint') %>
      </p>
    </section>

  <% elsif @user.approved? && !@user.valid_membership? %>
    <section class="rounded-2xl bg-white p-8 shadow-lg ring-1 ring-slate-900/5" aria-labelledby="expired-heading">
      <h2 id="expired-heading" class="mb-4 text-xl font-semibold text-slate-900">
        <%= t('dashboard.membership_expired.title') %>
      </h2>
      <p class="mb-6 text-slate-600">
        <%= t('dashboard.membership_expired.message') %>
      </p>
      <p class="text-sm text-slate-500">
        <%# CTA para "Ver opciones de membresía" - enlace o botón cuando exista la ruta %>
        <%= t('dashboard.membership_expired.cta') %>
      </p>
    </section>

  <% else %>
    <section class="rounded-2xl bg-white p-8 shadow-lg ring-1 ring-slate-900/5" aria-labelledby="welcome-heading">
      <h2 id="welcome-heading" class="mb-4 text-xl font-semibold text-slate-900">
        <%= t('dashboard.welcome.title') %>
      </h2>
      <p class="mb-4 text-slate-900">
        <%= t('dashboard.welcome.greeting', name: @user.first_name.presence || @user.email_address) %>
      </p>
      <p class="mb-6 text-slate-600">
        <%= t('dashboard.welcome.subtitle') %>
      </p>
      <p class="text-sm text-slate-500">
        <%= t('dashboard.welcome.cta') %>
      </p>
    </section>
  <% end %>
</article>
