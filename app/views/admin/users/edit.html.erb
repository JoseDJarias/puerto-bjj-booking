<% content_for :page_title, t('admin.users.edit.title') %>

<div class="mx-auto">
  <div class="mb-6">
    <%= link_to admin_users_path, class: "order-1 sm:order-none inline-flex items-center justify-center sm:justify-start w-full sm:w-auto min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-all flex-shrink-0" do %>
      <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      <span class="text-center sm:text-left">Volver a la lista de alumnos</span>
    <% end %>
  </div>

  <div class="bg-white p-8 shadow-sm rounded-3xl border border-slate-200">
    <%= render "form", user: @user %>
  </div>

  
</div>