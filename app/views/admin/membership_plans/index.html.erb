<% content_for :page_title, t('admin.plans.index.title') %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.plans.index.title') %></h2>
  <%= link_to t('admin.plans.index.new'), new_admin_membership_plan_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 shadow-sm transition-all hover:shadow-md" %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="sticky left-0 z-10 bg-slate-50 px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
            <%= t('activerecord.attributes.membership_plan.name') %>
          </th>
          
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('activerecord.attributes.membership_plan.duration_months') %>
          </th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('activerecord.attributes.membership_plan.price') %>
          </th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('admin.plans.index.active') %>
          </th>
          <th scope="col" class="relative px-4 py-3 whitespace-nowrap">
            <span class="sr-only"><%= t('admin.common.actions') %></span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @membership_plans.each do |plan| %>
          <tr class="group hover:bg-slate-50 transition-colors">
            
            <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 px-4 py-3 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)] text-sm font-medium text-slate-900">
              <%= plan.name %>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600">
              <span class="inline-flex items-center gap-1.5">
                <% if plan.duration_months.zero? %>
                  <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <%= t('admin.plans.drop_in', default: "Pase Diario (Drop-in)") %>
                <% else %>
                  <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  <%= pluralize(plan.duration_months, 'mes', 'meses') rescue "#{plan.duration_months} meses" %>
                <% end %>
              </span>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600 font-mono">
              <%= number_to_currency(plan.price) %>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm">
              <% if plan.active? %>
                <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                  Activo
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">
                  Inactivo
                </span>
              <% end %>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <%= link_to t('admin.common.edit'), edit_admin_membership_plan_path(plan), class: "font-medium text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>