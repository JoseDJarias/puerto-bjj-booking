<% content_for :page_title, t('admin.products.index.title') %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= t('admin.products.index.title') %></h1>
    <p class="text-xs font-semibold text-slate-500 mt-1"><%= t('admin.products.index.subtitle') %></p>
  </div>
  <div>
    <%= link_to new_admin_product_path, class: "inline-flex items-center gap-2 px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-xs font-black uppercase tracking-wider shadow-lg shadow-indigo-100 active:scale-95 transition-all" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      <%= t('admin.products.index.new_button') %>
    <% end %>
  </div>
</div>

<% if @products.any? %>
  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100">
          <tr>
            <th class="py-4 px-6"><%= t('admin.products.index.table.image') %></th>
            <th class="py-4 px-6"><%= t('admin.products.index.table.name') %></th>
            <th class="py-4 px-6"><%= t('admin.products.index.table.price') %></th>
            <th class="py-4 px-6"><%= t('admin.products.index.table.deposit') %></th>
            <th class="py-4 px-6"><%= t('admin.products.index.table.status') %></th>
            <th class="py-4 px-6 text-right"><%= t('admin.products.index.table.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @products.each do |product| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="py-4 px-6">
                <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shrink-0">
                  <% if product.images.attached? %>
                    <%= image_tag product.images.first, class: "w-full h-full object-cover" %>
                  <% else %>
                    <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  <% end %>
                </div>
              </td>
              <td class="py-4 px-6">
                <p class="font-extrabold text-slate-800"><%= product.name %></p>
                <% if product.category.present? %>
                  <span class="text-[10px] font-bold text-slate-400 uppercase"><%= product.category %></span>
                <% end %>
              </td>
              <td class="py-4 px-6 font-bold text-slate-800">
                ₡<%= number_with_delimiter(product.price.to_i) %>
              </td>
              <td class="py-4 px-6">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black bg-amber-50 text-amber-700 uppercase tracking-wider">
                  <%= product.deposit_percentage %>% (₡<%= number_with_delimiter(product.deposit_amount.to_i) %>)
                </span>
              </td>
              <td class="py-4 px-6">
                <% if product.active? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black bg-green-50 text-green-700 uppercase tracking-wider">
                    <%= t('admin.products.index.status.active') %>
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black bg-slate-100 text-slate-500 uppercase tracking-wider">
                    <%= t('admin.products.index.status.inactive') %>
                  </span>
                <% end %>
              </td>
              <td class="py-4 px-6 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to edit_admin_product_path(product), class: "p-2 text-slate-400 hover:text-indigo-600 rounded-xl hover:bg-indigo-50 transition-colors" do %>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                  <% end %>
                  <%= button_to admin_product_path(product), method: :delete, data: { turbo_confirm: "¿Estás seguro de eliminar este producto?" }, class: "p-2 text-slate-400 hover:text-red-600 rounded-xl hover:bg-red-50 transition-colors cursor-pointer" do %>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-3xl p-12 border border-slate-100 shadow-sm text-center">
    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
    </div>
    <p class="text-sm font-bold text-slate-700 mb-4"><%= t('admin.products.index.empty_state') %></p>
    <%= link_to t('admin.products.index.new_button'), new_admin_product_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white font-black text-xs uppercase tracking-wider rounded-2xl shadow-lg shadow-indigo-100" %>
  </div>
<% end %>
