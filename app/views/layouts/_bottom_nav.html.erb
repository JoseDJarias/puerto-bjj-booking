<%# app/views/layouts/_bottom_nav.html.erb %>
<nav class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-slate-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] pb-safe">
  <div class="flex items-center justify-around h-16 px-4">
    
    <%# 1. Menu Hamburger %>
    <button type="button" data-action="click->sidebar#open" class="flex flex-col items-center justify-center p-2 text-slate-400 hover:text-indigo-600 transition-colors">
      <svg class="h-6 w-6 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
      <span class="text-[9px] font-bold uppercase tracking-widest leading-none">Menú</span>
    </button>

    <%# 2. Home Shortcut %>
    <%= link_to root_path, data: { turbo: false }, class: "flex flex-col items-center justify-center p-2 text-slate-400 hover:text-indigo-600 transition-colors #{current_page?(root_path) ? 'text-indigo-600' : ''}" do %>
      <div class="bg-indigo-50 p-3 rounded-full -mt-6 shadow-sm border border-indigo-100 flex items-center justify-center">
        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </div>
      <span class="text-[9px] font-bold uppercase tracking-widest leading-none mt-1">Inicio</span>
    <% end %>

    <%# 3. User Dropdown %>
    <div class="relative flex flex-col items-center justify-center" data-controller="dropdown">
      <button type="button" 
              data-action="click->dropdown#toggle click@window->dropdown#hide"
              class="flex flex-col items-center justify-center p-2 text-slate-400 hover:text-indigo-600 transition-colors">
        
        <div class="h-6 w-6 rounded-full bg-indigo-600 flex items-center justify-center text-[10px] font-black text-white uppercase shadow-md shadow-indigo-100 mb-1">
          <%= Current.user.first_name&.first || Current.user.email_address.first %>
        </div>
        <span class="text-[9px] font-bold uppercase tracking-widest leading-none">Perfil</span>
      </button>

      <div data-dropdown-target="menu" 
            class="hidden fixed inset-x-4 bottom-[80px] bg-white rounded-3xl border border-slate-100 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] z-[100] overflow-hidden animate-in slide-in-from-bottom-4 fade-in duration-200">
        
        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col items-center text-center">
          <div class="h-12 w-12 rounded-full bg-indigo-600 flex items-center justify-center text-lg font-black text-white uppercase shadow-md shadow-indigo-200 mb-3">
            <%= Current.user.first_name&.first || Current.user.email_address.first %>
          </div>
          <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1"><%= t('topbar.active_session') %></p>
          <p class="text-sm font-bold text-slate-800 truncate w-full"><%= Current.user.email_address %></p>
        </div>

        <div class="p-2 space-y-1">
          <%= link_to edit_user_path, class: "flex items-center gap-4 px-4 py-3.5 text-sm font-bold text-slate-700 rounded-2xl hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <%= t('admin.users.edit.title') %>
          <% end %>

          <% if Current.user.admin? || Current.user.instructor? %>
            <% if request.path.start_with?('/admin') %>
              <%= link_to root_path, class: "flex items-center gap-4 px-4 py-3.5 text-sm font-bold text-slate-700 rounded-2xl hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <%= t('topbar.view_as_student') %>
              <% end %>
            <% else %>
              <%= link_to admin_dashboard_path, class: "flex items-center gap-4 px-4 py-3.5 text-sm font-bold text-amber-700 bg-amber-50 rounded-2xl hover:bg-amber-100 transition-colors" do %>
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <%= t('topbar.management_mode') %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <div class="h-[1px] bg-slate-100 my-2 mx-4"></div>

        <div class="p-2">
          <%= button_to session_path, method: :delete, class: "w-full flex items-center gap-4 px-4 py-3.5 text-sm font-bold text-red-600 rounded-2xl hover:bg-red-50 transition-colors cursor-pointer" do %>
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <%= t('topbar.sign_out') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>
