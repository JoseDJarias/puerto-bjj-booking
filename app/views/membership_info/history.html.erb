<%# app/views/my_memberships/history.html.erb %>
<div class="w-full max-w-2xl mx-auto px-4 py-6 space-y-12">

  <%# Main Title %>
  <header class="space-y-1 mb-10">
    <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-none uppercase">
      <%= t('my_membership.history.title') %>
    </h1>
    <p class="text-sm font-medium text-slate-500 leading-relaxed max-w-sm">
      <%= t('my_membership.history.subtitle') %>
    </p>
  </header>

  <%# Previous Memberships Section %>
  <section class="space-y-6">
    <div class="flex items-center gap-4">
      <h2 class="text-xs font-black text-indigo-500 uppercase tracking-widest whitespace-nowrap">
        <%= t('my_membership.history.memberships_heading') %>
      </h2>
      <div class="h-px bg-slate-200 flex-1"></div>
    </div>

    <% if @past_memberships.any? %>
      <div class="space-y-4">
        <% @past_memberships.each do |m| %>
          <div class="relative bg-white rounded-3xl border border-slate-200/60 p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="absolute top-4 right-4">
               <span class="text-[9px] font-black px-2.5 py-1 bg-slate-100 text-slate-500 rounded-lg uppercase tracking-widest">
                <%= t("enums.membership.status.#{m.current? ? 'active' : 'expired'}") %>
              </span>
            </div>

            <div class="mb-5 pr-20">
              <p class="text-xl font-black text-slate-900 uppercase tracking-tight leading-tight mb-1">
                <%= m.membership_package.name %>
              </p>
              <p class="text-xs font-bold text-indigo-500 uppercase tracking-tight">
                <%= m.membership_plan.display_name %>
              </p>
            </div>
            
            <div class="flex items-center gap-8 border-t border-slate-100 pt-5">
              <div class="space-y-0.5">
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest"><%= t('my_membership.start_date') %></p>
                <p class="text-sm font-black text-slate-700 uppercase"><%= l(m.start_date, format: "%d %b %y") %></p>
              </div>
              <div class="space-y-0.5">
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest"><%= t('my_membership.end_date') %></p>
                <p class="text-sm font-black text-slate-700 uppercase"><%= l(m.end_date, format: "%d %b %y") %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-10 px-6 rounded-3xl bg-slate-50 border border-slate-100 flex flex-col items-center justify-center text-center">
        <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-slate-300 mb-3 shadow-sm">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">
          <%= t('my_membership.history.no_memberships') %>
        </p>
      </div>
    <% end %>
  </section>

  <%# Tickets Drop-in Section %>
  <section class="space-y-6">
    <div class="flex items-center gap-4">
      <h2 class="text-xs font-black text-indigo-500 uppercase tracking-widest whitespace-nowrap">
        <%= t('my_membership.history.drop_in_heading') %>
      </h2>
      <div class="h-px bg-slate-200 flex-1"></div>
    </div>

    <% if @drop_in_history.any? %>
      <div class="space-y-3">
        <% @drop_in_history.each do |ticket| %>
          <div class="bg-white rounded-2xl p-4 flex items-center justify-between border border-slate-200/60 shadow-sm hover:border-indigo-100 transition-colors">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-black text-slate-800 uppercase leading-none mb-1">
                  <%= ticket.used_at ? l(ticket.used_at.to_date, format: :long) : l(ticket.updated_at.to_date, format: :short) %>
                </p>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">
                  <%= t("my_membership.history.drop_in_status.#{ticket.status}") %>
                </p>
              </div>
            </div>
            <% if ticket.price_paid.to_f.positive? %>
              <p class="text-sm font-black text-slate-900"><%= number_to_currency(ticket.price_paid, precision: 0) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-10 px-6 rounded-3xl bg-slate-50 border border-slate-100 flex flex-col items-center justify-center text-center">
        <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-slate-300 mb-3 shadow-sm">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>
        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">
          <%= t('my_membership.history.no_drop_ins') %>
        </p>
      </div>
    <% end %>
  </section>
</div>