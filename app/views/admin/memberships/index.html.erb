<% content_for :page_title, t('admin.memberships.index.title') %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.memberships.index.title') %></h2>
  <%= link_to t('admin.memberships.index.new'), new_admin_membership_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 shadow-sm transition-all hover:shadow-md" %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="sticky left-0 z-10 bg-slate-50 px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
            <%= t('admin.memberships.index.user_column') rescue "Alumno" %>
          </th>

          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('admin.memberships.index.table.plan_details') %>
          </th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('activerecord.attributes.membership.status') %>
          </th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap">
            <%= t('admin.memberships.index.table.validity') %>
          </th>
          <th scope="col" class="relative px-4 py-3 whitespace-nowrap">
            <span class="sr-only"><%= t('admin.common.actions') %></span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @memberships.each do |membership| %>
          <tr class="group hover:bg-slate-50 transition-colors">
            
            <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 px-4 py-3 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
              <div class="flex items-center">
                <div class="h-8 w-8 flex-shrink-0 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600">
                  <%= membership.user.first_name&.first %>
                </div>
                <div class="ml-3">
                  <div class="text-sm font-medium text-slate-900"><%= membership.user.full_name rescue "#{membership.user.first_name} #{membership.user.last_name}" %></div>
                </div>
              </div>
            </td>
            
            <td class="px-4 py-3 whitespace-nowrap">
              <div class="flex flex-col">
                <div class="text-sm font-medium text-slate-900"><%= membership.membership_plan.name %></div>
                <div class="text-xs text-slate-500"><%= membership.membership_package.name %></div>
              </div>
            </td>

            <td class="px-4 py-3 whitespace-nowrap text-sm">
              <% 
                # Lógica visual modernizada (estilo 'ring')
                badge_color = if membership.current? 
                                "bg-green-50 text-green-700 ring-green-600/20"
                              elsif membership.expired?
                                "bg-orange-50 text-orange-800 ring-orange-600/20"
                              else
                                "bg-red-50 text-red-700 ring-red-600/10"
                              end
              %>
              <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= badge_color %>">
                <%= t("enums.membership.status.#{membership.status}") %>
              </span>
            </td>

            <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-500">
              <div class="flex flex-col">
                <span><%= l(membership.start_date, format: :short) %> - <%= l(membership.end_date, format: :short) %></span>
                <% if membership.current? %>
                  <span class="text-xs text-indigo-600 font-medium"><%= membership.days_remaining %> días restantes</span>
                <% end %>
              </div>
            </td>

            <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to t('admin.common.edit'), edit_admin_membership_path(membership), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>