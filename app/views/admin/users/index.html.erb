<% content_for :page_title, t('admin.users.index.title') %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-slate-900"><%= t('admin.users.index.title') %></h2>
  <%= link_to new_admin_user_path, class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    <%= t('admin.users.index.new') %>
  <% end %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="w-full min-w-full divide-y divide-slate-200 table-fixed sm:table-auto" style="min-width: 640px;">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="sticky left-0 z-10 w-[200px] max-w-[200px] lg:w-[50%] lg:min-w-[260px] lg:max-w-none bg-slate-50 px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
            <%= t('activerecord.models.user') %>
          </th>

          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap"><%= t('activerecord.attributes.user.role') %></th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap"><%= t('activerecord.attributes.user.status') %></th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-600 whitespace-nowrap"><%= t('admin.users.index.joined_at') %></th>
          <th scope="col" class="relative w-0 px-4 py-3 whitespace-nowrap"><span class="sr-only"><%= t('admin.common.actions') %></span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @users.each do |user| %>
          <tr class="group hover:bg-slate-50">
            <td class="sticky left-0 z-10 w-[200px] max-w-[200px] lg:w-[50%] lg:min-w-[260px] lg:max-w-none bg-white group-hover:bg-slate-50 px-4 py-3 shadow-[1px_0_0_0_rgba(0,0,0,0.05)]">
              <div class="flex min-w-0 items-center">
                <div class="h-10 w-10 flex-shrink-0 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold">
                  <%= user.first_name&.first || user.email_address.first.upcase %>
                </div>
                <div class="ml-3 min-w-0 flex-1">
                  <div class="truncate lg:whitespace-normal text-sm font-medium text-slate-900" title="<%= user.first_name %> <%= user.last_name %>"><%= user.first_name %> <%= user.last_name %></div>
                  <div class="truncate lg:whitespace-normal text-sm text-slate-500" title="<%= user.email_address %>"><%= user.email_address %></div>
                </div>
              </div>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600">
              <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-slate-50 text-slate-700 ring-slate-600/10">
                <%= t("enums.user.role.#{user.role}") %>
              </span>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm">
              <% if user.eligible? %>
                <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">
                  <%= t('admin.users.index.approved_badge') %>
                </span>
              <% else %>
                <%= button_to approve_admin_user_path(user), method: :patch, class: "inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800 hover:bg-yellow-200 cursor-pointer transition-colors" do %>
                  <%= t('admin.users.index.pending_action') %>
                <% end %>
              <% end %>
            </td>

            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-500">
              <%= l(user.created_at.to_date, format: :short) %>
            </td>

            <td class="w-0 whitespace-nowrap px-4 py-3 text-right text-sm font-medium">
              <%= link_to t('admin.common.edit'), edit_admin_user_path(user), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
              <%= link_to t('admin.common.show'), admin_user_path(user), class: "text-slate-600 hover:text-slate-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>