<% content_for :page_title, t('contact.title') %>

<div class="min-h-[60vh] flex flex-col max-w-5xl mx-auto w-full">
    <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">
      <%= t('contact.direct_title') %>
    </h3>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-4">
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col hover:border-indigo-200 transition-colors duration-300 group">
      <div class="p-8 sm:p-10 flex-1">
        <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-slate-50 text-slate-600 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors mb-6">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        </span>
        <h2 class="text-lg font-semibold text-slate-900 mb-2"><%= t('contact.phone_title') %></h2>
        <a href="tel:+506 72026863" class="text-2xl font-bold text-slate-900 tracking-tight hover:text-indigo-600 transition-colors">
          <%= t('contact.phone_number') %>
        </a>
        <p class="text-slate-500 text-sm mt-2"><%= t('contact.phone_desc') %></p>
      </div>
    </section>

    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col hover:border-indigo-200 transition-colors duration-300 group">
      <div class="p-8 sm:p-10 flex-1">
        <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-slate-50 text-slate-600 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors mb-6">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </span>
        <h2 class="text-lg font-semibold text-slate-900 mb-2"><%= t('contact.email_title') %></h2>
        <a href="mailto:info@puertobjj.com" class="text-2xl font-bold text-slate-900 tracking-tight hover:text-indigo-600 transition-colors break-all">
          <%= t('contact.email_address') %>
        </a>
        <p class="text-slate-500 text-sm mt-2"><%= t('contact.email_desc') %></p>
      </div>
    </section>
  </div>
  <div class="border-t border-slate-100 pt-8 pb-4">
    <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4"><%= t('contact.social_title') %></h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      
      <a href="https://www.youtube.com/watch?v=xBpTI4sTRS4" target="_blank" class="relative overflow-hidden rounded-2xl group sm:col-span-2 lg:col-span-2 min-h-[160px] flex items-center justify-center border border-slate-200">
        <div class="absolute inset-0 bg-[url('https://img.youtube.com/vi/xBpTI4sTRS4/hqdefault.jpg')] bg-cover bg-center opacity-90 group-hover:scale-105 transition-transform duration-500"></div>
        <div class="absolute inset-0 bg-slate-900/60 group-hover:bg-slate-900/50 transition-colors"></div>
        
        <div class="relative z-10 flex flex-col items-center text-center p-4">
          <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-white mb-2 group-hover:scale-110 group-hover:bg-red-600 transition-all">
            <svg class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>
          <span class="font-bold text-white text-lg tracking-tight">Ver Highlight Reel</span>
          <span class="text-xs text-slate-300 font-medium mt-1">Puerto Jiu Jitsu en acción</span>
        </div>
      </a>

      <a href="https://smoothcomp.com/es/club/25466/statistics" target="_blank" class="rounded-2xl border border-slate-200 bg-white p-6 flex flex-col justify-between hover:border-amber-300 hover:shadow-lg hover:shadow-amber-100/50 transition-all group">
        <div class="flex items-start justify-between mb-4">
          <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
