<div class="max-w-4xl mx-auto space-y-8">
  
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-black italic tracking-tighter uppercase text-slate-900"><%= t("groups.index.title") %></h1>
  </div>

  <% if @invited_memberships.any? %>
    <div class="space-y-4">
      <h2 class="text-lg font-bold text-slate-700"><%= t("groups.index.invited_groups") %></h2>
      <div class="grid gap-4 md:grid-cols-2">
        <% @invited_memberships.each do |membership| %>
          <% group = membership.group %>
          <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-6 shadow-sm">
            <h3 class="font-bold text-indigo-900 text-lg mb-1"><%= group.name %></h3>
            <p class="text-indigo-600 text-sm mb-4"><%= group.description %></p>
            
            <div class="flex gap-3">
              <%= button_to accept_group_group_membership_path(group, membership), method: :patch, class: "flex-1 bg-indigo-600 text-white font-bold py-2 px-4 rounded-xl hover:bg-indigo-700 transition" do %>
                Aceptar
              <% end %>
              <%= button_to decline_group_group_membership_path(group, membership), method: :patch, class: "flex-1 bg-white border-2 border-indigo-100 text-indigo-600 font-bold py-2 px-4 rounded-xl hover:bg-indigo-50 transition" do %>
                Rechazar
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @accepted_groups.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @accepted_groups.each do |group| %>
        <%= link_to group_path(group), class: "block bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-indigo-200 transition group" do %>
          <h3 class="font-bold text-slate-900 text-lg mb-1 group-hover:text-indigo-600 transition"><%= group.name %></h3>
          <p class="text-slate-500 text-sm"><%= truncate(group.description, length: 100) %></p>
          <div class="mt-4 flex items-center text-indigo-600 text-sm font-bold opacity-0 group-hover:opacity-100 transition transform translate-x-[-10px] group-hover:translate-x-0">
            Entrar al chat &rarr;
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <% unless @invited_memberships.any? %>
      <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-300">
        <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <p class="text-slate-500 font-medium"><%= t("groups.index.no_groups") %></p>
      </div>
    <% end %>
  <% end %>
</div>
