<%# app/views/class_schedules/partials/_notes_section.html.erb %>
<%= turbo_frame_tag "notes_schedule_#{schedule.id}" do %>
  <% if params[:editing_notes] == "true" && (current_user.admin? || current_user.instructor?) %>
    <div class="bg-indigo-50/50 border border-indigo-100 p-5 rounded-2xl animate-in fade-in zoom-in-95 duration-200">
      <%= form_with model: schedule, url: class_schedule_path(schedule), method: :patch, class: "space-y-4" do |f| %>
        
        <div class="space-y-2">
          <label class="text-[10px] font-black text-slate-700 uppercase tracking-widest flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            Enfoque
          </label>
          <%= f.text_field :topic, 
              placeholder: "Ej: Escape de Montada",
              class: "block w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-sm font-black text-slate-700 focus:border-indigo-500 shadow-sm" %>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-black text-slate-700 uppercase tracking-widest flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
            Notas / Instrucciones
          </label>
          <%= f.text_area :notes, 
              rows: 3,
              placeholder: "Ej: Traer hidratación...",
              class: "block w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-sm font-medium text-slate-700 focus:border-indigo-500 shadow-sm" %>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <%= link_to "Cancelar", class_schedule_path(schedule), 
              class: "text-[10px] font-black text-slate-400 hover:text-slate-600 uppercase tracking-widest px-3 py-2" %>
          <%= f.button type: "submit", 
              class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-black text-[10px] uppercase tracking-widest shadow-sm transition-all" do %>
            Guardar
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="space-y-3">
      <% if schedule.topic.present? || schedule.notes.present? %>
        
        <% if schedule.topic.present? %>
          <div class="bg-amber-50/50 border-l-4 border-amber-400 p-4 rounded-r-2xl">
            <p class="text-[9px] font-black text-amber-600 uppercase tracking-widest mb-1">Enfoque de hoy</p>
            <p class="text-base font-bold text-amber-900 leading-tight"><%= schedule.topic %></p>
          </div>
        <% end %>

        <% if schedule.notes.present? %>
          <div class="bg-indigo-50/50 border border-indigo-100 rounded-2xl p-4 mt-4">
            <h4 class="text-[9px] font-black text-indigo-700 uppercase tracking-widest mb-1.5">Notas</h4>
            <p class="text-sm font-medium text-slate-700">
              <%= schedule.notes %>
            </p>
          </div>
        <% end %>

      <% end %>

      <%# Edit button for instructors/admins %>
      <% if current_user.admin? || current_user.instructor? %>
        <div class="flex justify-end mt-2">
          <%= link_to class_schedule_path(schedule, editing_notes: true), 
              class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-indigo-50 text-slate-500 hover:text-indigo-600 rounded-lg text-[10px] font-black uppercase tracking-widest transition-colors" do %>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            <%= schedule.topic.present? || schedule.notes.present? ? "Editar Notas" : "Añadir Notas" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
