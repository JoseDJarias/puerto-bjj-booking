<% content_for :page_title, t('dashboard.title') %>
<div class="mx-auto px-2 py-6">
  <%= turbo_stream_from [current_user, "bookings"] %>
  <% if @user.pending_approval? %>
    <%# --- Waiting for Admin approval --- %>
    <%= render "dashboard/states/pending" %>

  <% elsif @user.approved? && !@has_booking_access %>
    <%# --- Selection of Plan (Sales) --- %>
    <article class="w-full">
       <%= render "dashboard/states/pricing_options", packages: @packages, plans: @plans %>
    </article>

  <% else %>
    
    <% if @user.eligible_for_review_prompt? %>
      <%= render "dashboard/partials/review_prompt" %>
    <% end %>

    <%# 1. Welcome Card %>
    <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm mb-6 relative overflow-hidden">
      <div class="relative z-10">
        <% greeting = weekly_dashboard_greeting(@user) %>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-2 tracking-tight"><%= greeting[:title] %></h2>
        <p class="text-sm font-medium text-slate-700 mb-6 leading-relaxed"><%= greeting[:subtitle] %></p>
        
        <button onclick="document.getElementById('classes-section').scrollIntoView({ behavior: 'smooth' })" 
                class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-indigo-600 text-white text-sm font-bold rounded-2xl shadow-lg shadow-indigo-100 active:scale-95 transition-all">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          Ver mis próximas clases
        </button>
      </div>
    </div>

    <%# 2. Stats Cards (KPIs) %>
    <div class="grid grid-cols-3 gap-2 sm:gap-4 mb-8">
      <div class="bg-white py-4 rounded-3xl border border-slate-100 shadow-sm flex flex-col items-center">
        <span class="text-[10px] text-slate-400 font-bold uppercase mb-1"><%= t('dashboard.stats.total_classes') %></span>
        <span class="text-2xl font-black text-slate-800"><%= @total_attended %></span>
      </div>
      <div class="bg-indigo-50 py-4 rounded-3xl border border-indigo-100 shadow-sm flex flex-col items-center">
        <span class="text-[10px] text-indigo-500 font-bold uppercase mb-1"><%= t('dashboard.stats.this_month') %></span>
        <span class="text-2xl font-black text-indigo-600"><%= @month_attended %></span>
      </div>
      <div class="bg-white py-4 rounded-3xl border border-slate-100 shadow-sm flex flex-col items-center">
        <span class="text-[10px] text-slate-400 font-bold uppercase mb-1"><%= t('dashboard.stats.next_in') %></span>
        <span class="text-lg font-black text-slate-800 leading-none h-[28px] flex items-center">
          <%= smart_countdown(@upcoming_bookings.first) %>
        </span>
      </div>
    </div>

    <%= render "dashboard/partials/membership_info" %>

    <%# 3. Pro Shop / Official Gear Banner %>
    <div class="mb-8 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-5 sm:p-6 text-white shadow-xl border border-indigo-900/50 relative overflow-hidden flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="relative z-10">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
          <span class="text-[9px] font-bold text-indigo-300 uppercase tracking-widest">Tienda Oficial Puerto BJJ</span>
        </div>
        <h3 class="text-lg sm:text-xl font-black tracking-tight">Catálogo y Equipamiento</h3>
        <p class="text-xs text-slate-300 font-medium mt-0.5 leading-relaxed">
          Kimonos, rashguards y accesorios oficiales disponibles para encargar.
        </p>
      </div>

      <div class="relative z-10 shrink-0">
        <%= link_to products_path, class: "inline-flex items-center justify-center gap-2 px-5 py-3 bg-white text-slate-900 hover:bg-indigo-50 hover:text-indigo-600 rounded-2xl text-xs font-black uppercase tracking-wider shadow-md active:scale-95 transition-all duration-200" do %>
          <span>Explorar Catálogo</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        <% end %>
      </div>

      <div class="absolute -right-4 -bottom-6 text-indigo-800/20 pointer-events-none">
        <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
      </div>
    </div>

    <%= render "dashboard/partials/tabs_and_content", upcoming: @upcoming_bookings, past: @past_bookings %>

  <% end %>
</div>