<%# app/views/dashboard/_tabs_and_content.html.erb %>
<div data-controller="tabs" 
     data-tabs-active-class="text-indigo-600 border-indigo-600 bg-indigo-50/50" 
     data-tabs-inactive-class="text-slate-400 border-transparent hover:text-slate-600 hover:border-slate-200">
  
  <div class="mb-6">
    <nav class="grid grid-cols-2 w-full border-b border-slate-200" aria-label="Tabs">
      <%# Tab 1: Upcoming %>
      <button type="button" 
              data-tabs-target="tab" 
              data-action="click->tabs#switch"
              class="w-full py-3 border-b-2 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        <%= t('dashboard.tabs.upcoming') %>
        <% if upcoming.any? %>
          <span class="bg-indigo-100 text-indigo-600 px-1.5 py-0.5 rounded-full text-[9px] min-w-[18px] text-center">
            <%= upcoming.size %>
          </span>
        <% end %>
      </button>

      <%# Tab 2: History %>
      <button type="button" 
              data-tabs-target="tab" 
              data-action="click->tabs#switch"
              class="w-full py-3 border-b-2 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <%= t('dashboard.tabs.history') %>
      </button>
    </nav>
  </div>

  <%# --- PANEL 1: UPCOMING --- %>
  <div data-tabs-target="panel" class="animate-in fade-in duration-300">
    <% if upcoming.any? %>
    <div id="classes-section" class="grid gap-4">
      <% current_date = nil %>
      <% upcoming.each do |schedule| %>
        
        <%# Visual Day Separator %>
        <% if schedule.starts_at.to_date != current_date %>
          <% current_date = schedule.starts_at.to_date %>
          <div class="flex items-center gap-3 mt-4 mb-2">
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
             <%= l(current_date, format: "%A %d, %B") %>  
            </span>
            <div class="h-px bg-slate-100 flex-1"></div>
          </div>
        <% end %>

        <%= turbo_stream_from "schedule_#{schedule.id}" %>
        <%= render "class_schedules/partials/class_card_universal", 
                   schedule: schedule, 
                   user: @user, 
                   context: :dashboard %>
      <% end %>
    </div>
    <% else %>
      <div class="bg-slate-50 border border-dashed border-slate-200 rounded-2xl p-8 text-center mt-4">
         <p class="text-slate-500 text-sm"><%= t('dashboard.tabs.no_classes_scheduled') %></p>
      </div>
    <% end %>
  </div>

  <%# --- PANEL 2: HISTORY --- %>
  <div data-tabs-target="panel" class="hidden animate-in fade-in duration-300">
    <div class="space-y-1">
      <% if past.any? %>
        <% current_month = nil %>
        <% past.each do |booking| %>
          
          <%# Month Header %>
          <% booking_month = booking.class_schedule.starts_at.strftime("%B %Y") %>
          <% if booking_month != current_month %>
            <% current_month = booking_month %>
            <div class="flex items-center gap-3 mt-6 mb-3 px-2 first:mt-2">
              <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
               <%= l(booking.class_schedule.starts_at.to_date, format: "%B %Y") %>  
              </span>
              <div class="h-px bg-slate-200 flex-1"></div>
            </div>
          <% end %>
          
          <%# Clickable Card %>
          <%= link_to class_schedule_path(booking.class_schedule), data: { turbo_frame: "modal_detail" }, class: "group flex items-center gap-4 bg-white rounded-2xl p-4 border border-slate-100 shadow-sm hover:shadow-md hover:border-indigo-100 transition-all active:scale-[0.98] mb-3" do %>
            
            <%# Date Cube %>
            <div class="flex-shrink-0 w-14 h-14 rounded-xl flex flex-col items-center justify-center border <%= booking.attended? ? 'bg-green-50 border-green-100 text-green-600' : (booking.confirmed? ? 'bg-slate-50 border-slate-100 text-slate-400' : 'bg-red-50 border-red-100 text-red-500') %>">
              <span class="text-xl font-black leading-none"><%= booking.class_schedule.starts_at.strftime("%d") %></span>
              <span class="text-[9px] font-bold uppercase mt-0.5 tracking-widest"><%= l(booking.class_schedule.starts_at.to_date, format: "%b") %></span>
            </div>
            
            <%# Class Info %>
            <div class="flex-1 min-w-0 py-1">
              <h4 class="text-sm font-bold text-slate-800 truncate group-hover:text-indigo-600 transition-colors"><%= booking.class_schedule.class_type.name %></h4>
              <div class="flex items-center gap-3 mt-1">
                <p class="text-xs text-slate-500 flex items-center gap-1 font-medium">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <%= booking.class_schedule.starts_at.strftime("%H:%M") %>
                </p>
                <% if booking.class_schedule.instructor %>
                  <p class="text-xs text-slate-500 flex items-center gap-1 font-medium truncate">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <%= booking.class_schedule.instructor.first_name %>
                  </p>
                <% end %>
              </div>
            </div>

            <%# Status & Chevron %>
            <div class="flex flex-col items-end justify-center gap-2">
              <% if booking.attended? %>
                <span class="inline-flex items-center px-2 py-1 rounded-md text-[9px] font-black bg-green-100 text-green-700 uppercase tracking-widest leading-none"><%= t('dashboard.tabs.attended') %></span>
              <% elsif booking.confirmed? %>
                <span class="inline-flex items-center px-2 py-1 rounded-md text-[9px] font-bold text-slate-500 bg-slate-100 uppercase tracking-widest leading-none"><%= t('dashboard.tabs.confirmed') %></span>
              <% else %>
                <span class="inline-flex items-center px-2 py-1 rounded-md text-[9px] font-black bg-red-100 text-red-700 uppercase tracking-widest leading-none"><%= t('dashboard.tabs.not_attended') %></span>
              <% end %>
              
              <div class="w-6 h-6 rounded-full bg-slate-50 group-hover:bg-indigo-50 flex items-center justify-center transition-colors">
                <svg class="w-3 h-3 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
              </div>
            </div>
            
          <% end %>
        <% end %>
      <% else %>
         <div class="p-10 text-center flex flex-col items-center">
           <div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center mb-4 border border-slate-100">
             <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
           </div>
           <p class="text-xs font-bold text-slate-400 uppercase tracking-widest"><%= t('dashboard.tabs.your_progress_will_appear_here') %></p>
         </div>
      <% end %>
    </div>
  </div>
</div>