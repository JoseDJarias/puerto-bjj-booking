<%= form_with model: [:admin, product], class: "space-y-6" do |f| %>
  <% if product.errors.any? %>
    <div class="rounded-2xl bg-red-50 p-4 border border-red-100 text-red-700 text-sm">
      <p class="font-bold mb-1"><%= t('errors.template.header') %></p>
      <ul class="list-disc pl-5 space-y-1">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-5">
    <div>
      <%= f.label :name, t('admin.products.form.name_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
      <%= f.text_field :name, placeholder: "Ej: Rashguard Puerto BJJ Edición Especial", required: true, class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :price, t('admin.products.form.price_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
        <%= f.number_field :price, step: 100, min: 0, placeholder: "25000", required: true, class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
      </div>

      <div>
        <%= f.label :deposit_percentage, t('admin.products.form.deposit_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
        <%= f.number_field :deposit_percentage, min: 1, max: 100, placeholder: "50", required: true, class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :category, t('admin.products.form.category_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
      <%= f.text_field :category, placeholder: "Ej: Ropa, Kimonos, Accesorios", class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
    </div>

    <div>
      <%= f.label :description, t('admin.products.form.description_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
      <%= f.text_area :description, rows: 4, placeholder: "Detalles del material, especificaciones y calidad...", class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
    </div>

    <div>
      <%= f.label :notes, t('admin.products.form.notes_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-2" %>
      <%= f.text_area :notes, rows: 3, placeholder: "Ej: Tiempo estimado de entrega de 15 a 20 días hábiles tras ordenar.", class: "w-full rounded-2xl border-slate-200 focus:border-indigo-600 focus:ring-indigo-600 text-sm font-medium py-3 px-4 shadow-sm" %>
    </div>

    <div data-controller="image-preview" class="space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <%= f.label :images, t('admin.products.form.images_label'), class: "block text-xs font-black text-slate-700 uppercase tracking-wider mb-1" %>
          <p class="text-[11px] text-slate-400 font-medium">Puedes subir una o varias fotos. Puedes pulsar el botón varias veces para seguir añadiendo fotos.</p>
        </div>
      </div>
      
      <%# Hidden Native File Input %>
      <%= f.file_field :images, 
                       multiple: true, 
                       accept: "image/*", 
                       data: { 
                         image_preview_target: "input", 
                         action: "change->image-preview#handleFiles" 
                       },
                       class: "hidden" %>
      
      <%# Images Gallery Grid (Existing + New Previews + Add Button) %>
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <%# 1. Existing Photos (if editing) %>
        <% if product.images.attached? %>
          <% product.images.each do |img| %>
            <div class="relative w-24 h-24 rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm group">
              <%= image_tag img, class: "w-full h-full object-cover" %>
              
              <%# Delete Image Button %>
              <% if product.persisted? %>
                <%= link_to destroy_image_admin_product_path(product, image_id: img.id), 
                            data: { 
                              turbo_method: :delete, 
                              turbo_confirm: "¿Estás seguro de eliminar esta foto del producto?" 
                            },
                            title: "Eliminar foto",
                            class: "absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-slate-900/80 hover:bg-red-600 text-white flex items-center justify-center backdrop-blur-sm shadow-sm transition-colors cursor-pointer" do %>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <%# 2. Container for Newly Selected Image Previews (Accumulated) %>
        <div data-image-preview-target="newPreviewsContainer" class="contents"></div>

        <%# 3. Add Photos Button Card (Click to select more files anytime) %>
        <button type="button"
                data-action="click->image-preview#triggerFileInput"
                class="w-24 h-24 rounded-2xl border-2 border-dashed border-indigo-300 hover:border-indigo-600 bg-indigo-50/50 hover:bg-indigo-50 flex flex-col items-center justify-center gap-1 text-indigo-600 transition-all cursor-pointer group active:scale-95">
          <svg class="w-6 h-6 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          <span class="text-[10px] font-black uppercase tracking-wider">Añadir</span>
        </button>
      </div>
    </div>

    <div class="pt-2">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :active, class: "rounded-lg border-slate-300 text-indigo-600 focus:ring-indigo-500 h-5 w-5" %>
        <span class="text-sm font-bold text-slate-700"><%= t('admin.products.form.active_label') %></span>
      </label>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to t('admin.products.form.cancel'), admin_products_path, class: "px-5 py-3 rounded-2xl text-xs font-black uppercase tracking-wider text-slate-500 hover:bg-slate-100 transition-all" %>
    <%= f.submit t('admin.products.form.save_button'), class: "px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl text-xs font-black uppercase tracking-wider shadow-lg shadow-indigo-100 active:scale-95 transition-all cursor-pointer" %>
  </div>
<% end %>
