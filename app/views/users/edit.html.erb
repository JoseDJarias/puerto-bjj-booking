<div class="max-w-2xl mx-auto py-10 px-4">
  <div class="mb-8">
    <h2 class="text-3xl font-black italic text-slate-900 tracking-tighter uppercase">Configuración de Perfil</h2>
    <p class="text-sm text-slate-500 font-medium">Gestiona tu información personal en Puerto BJJ.</p>
  </div>

  <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
    <%= form_with model: @user, url: user_path, method: :patch, novalidate: true, class: "space-y-6" do |f| %>
      
      <% if @user.errors.any? %>
        <div class="rounded-2xl bg-red-50 p-4 border-2 border-red-100 mb-6">
          <h3 class="text-sm font-black text-red-800 uppercase tracking-tight mb-2"><%= t('auth.sign_up.errors.title') %></h3>
          <ul class="space-y-1 ml-6">
            <% @user.errors.full_messages.each do |msg| %>
              <li class="text-xs text-red-700 font-medium break-words">• <%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :first_name, t('activerecord.attributes.user.first_name'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
          <%= f.text_field :first_name, class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
        </div>
        <div>
          <%= f.label :last_name, t('activerecord.attributes.user.last_name'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
          <%= f.text_field :last_name, class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :identification, t('activerecord.attributes.user.identification'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
          <%= f.text_field :identification, class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm bg-slate-50 text-slate-500", readonly: true %>
          <p class="mt-1 text-[10px] text-slate-400 font-medium">La identificación no se puede cambiar por el usuario.</p>
        </div>
        <div>
          <%= f.label :nickname, t('activerecord.attributes.user.nickname'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
          <%= f.text_field :nickname, placeholder: "Ej: conejitsu", class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
        </div>
      </div>

      <div>
        <%= f.label :phone_number, t('activerecord.attributes.user.phone_number'), class: "mb-1 block text-xs font-black uppercase text-slate-400 tracking-widest" %>
        <%= f.telephone_field :phone_number, class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
      </div>

      <div class="pt-6 border-t border-slate-100">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-tight mb-4 text-indigo-600">Cambiar Contraseña</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.password_field :password, placeholder: "Nueva contraseña", class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
          </div>
          <div>
            <%= f.password_field :password_confirmation, placeholder: "Confirmar nueva contraseña", class: "block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-4 focus:ring-indigo-500/10 transition-all" %>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-4 pt-6">
        <%= link_to "Cancelar", root_path, class: "text-xs font-black text-slate-400 uppercase tracking-widest hover:text-slate-600" %>
        <%= f.submit "Guardar Cambios", class: "cursor-pointer rounded-xl bg-slate-900 px-8 py-4 font-black text-xs text-white uppercase tracking-widest hover:bg-black transition-all shadow-xl shadow-slate-100" %>
      </div>
    <% end %>
  </div>
</div>